extends RefCounted
## 三角函數 第三大關「浪之階梯」題庫（對應講義 1-1 重點二前半：三角函數的圖形與週期）
## 伸縮平移、看圖求式、應用題、作圖求解個數在第四關。這一關只出 sin、cos、tan（不出 cot、sec）。
##
## 引擎：level_trig3_wave.gd（繼承第一關）。步驟除了 choice、fill、filter，多一種：
##   wave  捲出波浪：左邊單位圓、右邊座標平面，拖動圓上的點把 y = sin x（或 cos x）畫出來。
##         fn 是 "sin" 或 "cos"；targets 是要找的角（每找到一個按一次「確定」，全部找到才過關）
## 下方的示意圖：
##   "circles": [{"kind": "graph", "after": …, …}, …]（隨步驟換圖，用 after 比目前步驟小的最後一張）
##   graph 的欄位：fns（曲線，每條 {"f": "sin"／"cos"／"tan", "a", "b", "d", "abs", "sq", "g": 自訂函數, "label", "c"}）、
##     x（範圍，以 π 為單位，例如 [0, 2]）、y（範圍）、period（標出一個週期的長度，π 為單位）、x0（從哪裡開始標）、
##     shift（畫一條往右平移的虛線副本，π 為單位）、pts（標點 [[x(π), y], …]）、vlines（虛線 x(π)）、
##     centers（對稱中心 [[x(π), y]]）、inc（亮起來的區間 [[a, b], …]，π 為單位）
const UITheme := preload("game_theme.gd")

const SB := preload("step_bank.gd")

const T_SHAPE := "trig_graph_shape"
const T_PER := "trig_period"
const T_COMBO := "trig_period_combo"
const T_PROP := "trig_graph_prop"
const T_JUDGE := "trig_graph_judge"

const SIN_C := UITheme.CYAN
const COS_C := UITheme.ORANGE
const TAN_C := UITheme.LIME
const PINK := UITheme.PINK_LIGHT


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 捲出波浪
static func _w(name: String, q: String, fn: String, targets: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "wave", "name": name, "q": q, "fn": fn, "targets": targets, "line": line, "nudge": nudge, "tag": T_SHAPE}


## 是非判斷（真假判斷題用）
static func _tf(name: String, stmt: String, truth: bool, why: String, line: String) -> Dictionary:
	return _c(name, stmt, ["對", "錯"] if truth else ["錯", "對"], 0, why, why, line, T_JUDGE)


## 一張函數圖：fns 每條 [f, a, b, d, 顏色, 標籤]
static func _g(fns: Array, x: Array, extra := {}) -> Dictionary:
	var out := []
	for fn in fns:
		if fn is Dictionary:
			out.append(fn)
		else:
			out.append({"f": fn[0], "a": float(fn[1]), "b": float(fn[2]), "d": float(fn[3]), "c": fn[4], "label": fn[5]})
	var g := {"kind": "graph", "fns": out, "x": x}
	g.merge(extra, true)
	return g


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		slot["params"] = slot.get("params", [])
		SB.fix_roots(slot)
	return out


