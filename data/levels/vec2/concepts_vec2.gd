				 "notes": ["x + y = 1 是直線 BC，x = 0 是直線 AC，y = 0 是直線 AB", "三條邊延長把平面分成七塊"],
				 "example": "−1 ≤ x ≤ 2、0 ≤ y ≤ 2：3 × 2 × 2△ABC",
				 "check": {"q": "\\vec{AP} = 2\\vec{AB} + \\vec{AC}，P 在哪裡？", "opts": ["BC 的另一側", "三角形裡", "和 A 同一側"], "a": 0,
					"why": "x + y = 3 > 1。", "hint": "看 x + y。"}},
				{"title": "坐標與單位向量", "decoys": ["1", "一個"], "tag": "公式", "glyph": "(x,y)",
				 "formulas": ["\\vec{AB} = B − A，|\\vec{a}| = √(x^{2} + y^{2})", "和 \\vec{a} 平行的單位向量：±\\vec{a} 除以 ?{|\\vec{a}|}，共 ?{兩個}"],
				 "notes": ["角平分向量：\\frac{\\vec{a}}{|\\vec{a}|} + \\frac{\\vec{b}}{|\\vec{b}|}", "平行又知道長度：單位向量乘長度"],
				 "example": "\\vec{a} = (3, −4)：\\vec{e} = ±(\\frac{3}{5}, −\\frac{4}{5})",
				 "check": {"q": "(6, 8) 的單位向量（同方向）？", "opts": ["(\\frac{3}{5}, \\frac{4}{5})", "(\\frac{6}{14}, \\frac{8}{14})", "(1, 1)"], "a": 0,
					"why": "長度 10，除以 10。", "hint": "先算長度。"}},
				{"title": "加權平均", "decoys": ["\\vec{PG}", "中點"], "tag": "公式", "glyph": "Σw",
				 "formulas": ["w_{A}\\vec{PA} + w_{B}\\vec{PB} + w_{C}\\vec{PC} = \\vec{0} ⇒ P 是三點的 ?{加權平均}",
					"2\\vec{PA} + \\vec{PB} = ?{3\\vec{PG}}，G = \\frac{2A + B}{3}"],
				 "notes": ["權重大的點拉得比較用力", "|3\\vec{PG}| 最小：P 離 G 最近"],
				 "example": "\\vec{PA} + 2\\vec{PB} + \\vec{PC} = \\vec{0} ⇒ P = \\frac{A + 2B + C}{4}",
				 "check": {"q": "\\vec{PA} + \\vec{PB} + \\vec{PC} = \\vec{0}，P 是？", "opts": ["重心", "內心", "外心"], "a": 0,
					"why": "P = \\frac{A + B + C}{3}。", "hint": "權重都是 1。"}},
			]
		"V3":
			return [
				{"title": "內積與影子", "decoys": ["> 0", "|\\vec{a}| + |\\vec{b}|"], "tag": "定義", "glyph": "·",
				 "formulas": ["\\vec{a} · \\vec{b} = |\\vec{a}||\\vec{b}|cos θ = |\\vec{a}| × \\vec{b} 的影子長", "θ 是鈍角 ⇒ \\vec{a} · \\vec{b} ?{< 0}"],
				 "notes": ["夾角要尾接尾：\\vec{AB} · \\vec{BC} 的夾角是 180° − ∠B", "內積是一個數，不是向量"],
				 "example": "|\\vec{a}| = 4、|\\vec{b}| = 2、夾角 120°：\\vec{a} · \\vec{b} = 4 × 2 × (−\\frac{1}{2}) = −4",
				 "check": {"q": "正三角形邊長 2，\\vec{AB} · \\vec{BC} = ？", "opts": ["−2", "2", "4"], "a": 0,
