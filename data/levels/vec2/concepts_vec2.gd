				 "notes": ["|\\vec{a} + \\vec{b}| = |\\vec{a} − \\vec{b}| ⇔ \\vec{a} ⊥ \\vec{b}", "平面上 \\vec{a} ⊥ \\vec{b}、\\vec{b} ⊥ \\vec{c} ⇒ \\vec{a} ∥ \\vec{c}"],
				 "example": "(1, 2) · (t, 3) = 0 ⇒ t = −6",
				 "check": {"q": "(2, k) ⊥ (3, −6)，k = ？", "opts": ["1", "−1", "4"], "a": 0,
					"why": "6 − 6k = 0。", "hint": "內積是 0。"}},
				{"title": "坐標的內積", "decoys": ["a_{1}b_{2}", "a_{2}b_{1}"], "tag": "公式", "glyph": "Σ",
				 "formulas": ["(a_{1}, a_{2}) · (b_{1}, b_{2}) = a_{1}b_{1} + ?{a_{2}b_{2}}", "|\\vec{a}|^{2} = \\vec{a} · \\vec{a} = a_{1}^{2} + ?{a_{2}^{2}}"],
				 "notes": ["因為 \\vec{i} · \\vec{i} = \\vec{j} · \\vec{j} = 1、\\vec{i} · \\vec{j} = 0", "圖形題：放上坐標常常比較快"],
				 "example": "(3, 4) · (2, 1) = 6 + 4 = 10",
				 "check": {"q": "(4, −3) · (−1, 3) = ？", "opts": ["−13", "5", "−5"], "a": 0,
					"why": "−4 − 9。", "hint": "x 乘 x、y 乘 y。"}},
				{"title": "正射影", "decoys": ["|\\vec{a}|", "|\\vec{a}|^{2}"], "tag": "公式", "glyph": "⊥→",
				 "formulas": ["正射影 = \\frac{\\vec{a} · \\vec{b}}{|\\vec{b}|^{2}}\\vec{b}：\\vec{a} · \\vec{b} 除以 ?{|\\vec{b}|^{2}}，再乘 \\vec{b}", "正射影長 = |\\vec{a} · \\vec{b}| 除以 ?{|\\vec{b}|}"],
				 "notes": ["正射影是向量、正射影長是數字、投影點 = 起點 + 正射影", "\\vec{a} − 正射影（竿子）和 \\vec{b} 垂直"],
				 "example": "(7, 4) 在 (1, 2) 上：\\frac{15}{5}(1, 2) = (3, 6)，竿子 (4, −2)",
				 "check": {"q": "(5, 0) 在 (3, 4) 上的正射影長？", "opts": ["3", "5", "15"], "a": 0,
					"why": "\\frac{15}{5} = 3。", "hint": "內積除以 |\\vec{b}|。"}},
				{"title": "內積不能消去", "decoys": ["\\vec{b} = \\vec{c}", "\\vec{a} ∥ \\vec{b}"], "tag": "觀念", "glyph": "≠",
