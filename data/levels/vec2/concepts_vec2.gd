extends RefCounted
## 高二「平面向量」單元（V1～V8）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測）。
const UITheme := preload("res://data/ui/game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"V1":
			return [
				{"title": "相等向量", "decoys": ["起點", "位置"], "tag": "定義", "glyph": "→",
				 "formulas": ["\\vec{AB} = \\vec{CD}：長度一樣、?{方向}一樣", "起點在哪裡都可以：向量可以 ?{平移}"],
				 "notes": ["反向的箭頭是 −\\vec{a}，不是 \\vec{a}", "平行四邊形 ABCD：\\vec{AB} = \\vec{DC}"],
				 "example": "平行四邊形的四個頂點：12 支箭頭裡有 4 對一樣，共 8 個不同的向量",
				 "check": {"q": "平行四邊形 ABCD，哪一個等於 \\vec{AB}？", "opts": ["\\vec{DC}", "\\vec{CD}", "\\vec{BA}"], "a": 0,
					"why": "從 D 到 C 和從 A 到 B 方向一樣。", "hint": "注意方向。"}},
				{"title": "加法與減法", "decoys": ["\\vec{BC}", "起點減終點"], "tag": "定理", "glyph": "−",
				 "formulas": ["首尾相接：\\vec{AB} + \\vec{BC} = ?{\\vec{AC}}", "\\vec{AB} − \\vec{AC} = ?{\\vec{CB}}（終點減起點）"],
				 "notes": ["平行四邊形法：兩支同起點，對角線是和", "減一支箭頭 = 加上它的反方向"],
				 "example": "\\vec{PQ} = \\vec{AQ} − \\vec{AP}：兩個點都從 A 出發再相減",
				 "check": {"q": "\\vec{AC} − \\vec{BC} = ？", "opts": ["\\vec{AB}", "\\vec{BA}", "\\vec{CB}"], "a": 0,
					"why": "\\vec{AC} + \\vec{CB} = \\vec{AB}。", "hint": "減 \\vec{BC} = 加 \\vec{CB}。"}},
				{"title": "平行與倍數", "decoys": ["相同", "1"], "tag": "定理", "glyph": "k→",
				 "formulas": ["\\vec{b} ∥ \\vec{a} ⇔ \\vec{b} = ?{k}\\vec{a}", "k < 0 時方向 ?{相反}，長度是 |k| 倍"],
				 "notes": ["\\vec{a} ≠ \\vec{0} 才能這樣判斷", "k 不管多少，k\\vec{a} 都在同一條直線上"],
				 "example": "(3, −6) = 3(1, −2)：平行而且同方向",
				 "check": {"q": "(−4, 2) 和 (2, −1) 的關係？", "opts": ["平行、反方向", "平行、同方向", "不平行"], "a": 0,
					"why": "(−4, 2) = −2(2, −1)。", "hint": "看是不是倍數。"}},
				{"title": "不共線的係數", "decoys": ["1", "相等"], "tag": "定理", "glyph": "=0",
				 "formulas": ["A、B、C 不共線：x\\vec{AB} + y\\vec{AC} = \\vec{0} ⇒ x = y = ?{0}",
					"x\\vec{AB} + y\\vec{AC} = x'\\vec{AB} + y'\\vec{AC} ⇒ 係數 ?{對應相等}"],
				 "notes": ["有 \\vec{CB} 這種，先拆成 \\vec{AB} − \\vec{AC}", "共線的話就不唯一"],
				 "example": "(x − 2y + 1)\\vec{AB} + (x + y − 5)\\vec{AC} = \\vec{0} ⇒ (x, y) = (3, 2)",
				 "check": {"q": "不共線，(a − 1)\\vec{AB} + (b + 2)\\vec{AC} = \\vec{0}，a + b = ？", "opts": ["−1", "1", "3"], "a": 0,
					"why": "a = 1、b = −2。", "hint": "兩個係數都是 0。"}},
				{"title": "分點公式", "decoys": ["\\frac{m}{n}", "同側"], "tag": "公式", "glyph": "m:n",
				 "formulas": ["\\ol{BP} : \\ol{PC} = m : n ⇒ \\vec{AP} = ?{\\frac{n}{m + n}}\\vec{AB} + ?{\\frac{m}{m + n}}\\vec{AC}",
					"係數 ?{交叉}，加起來是 1"],
				 "notes": ["靠近 B，\\vec{AB} 的係數就大", "角平分線：\\ol{BD} : \\ol{DC} = \\ol{AB} : \\ol{AC}"],
				 "example": "\\ol{BP} : \\ol{PC} = 1 : 3 ⇒ \\vec{AP} = \\frac{3}{4}\\vec{AB} + \\frac{1}{4}\\vec{AC}",
				 "check": {"q": "P 是 \\ol{BC} 中點，\\vec{AP} = ？", "opts": ["\\frac{1}{2}\\vec{AB} + \\frac{1}{2}\\vec{AC}", "\\vec{AB} + \\vec{AC}", "\\frac{1}{2}\\vec{BC}"], "a": 0,
					"why": "1 : 1，兩個係數都是 \\frac{1}{2}。", "hint": "係數加起來是 1。"}},
			]
		"V2":
			return [
				{"title": "三點共線", "decoys": ["2", "−1"], "tag": "定理", "glyph": "α+β",
				 "formulas": ["\\vec{OC} = α\\vec{OA} + β\\vec{OB}：A、B、C 共線 ⇔ α + β = ?{1}",
					"寫成 a\\vec{OA} + b\\vec{OB} + c\\vec{OC} = \\vec{0}：共線 ⇔ a + b + c = ?{0}"],
				 "notes": ["P 在直線 BC 上 ⇔ \\vec{AP} = x\\vec{AB} + y\\vec{AC}，x + y = 1", "係數和不是 1，C 就在直線外面"],
				 "example": "2\\vec{OA} − 3\\vec{OB} + \\vec{OC} = \\vec{0}：2 − 3 + 1 = 0，共線",
				 "check": {"q": "\\vec{OC} = \\frac{1}{3}\\vec{OA} + k\\vec{OB}，A、B、C 共線，k = ？", "opts": ["\\frac{2}{3}", "\\frac{1}{3}", "1"], "a": 0,
					"why": "\\frac{1}{3} + k = 1。", "hint": "係數和是 1。"}},
				{"title": "兩線交點", "decoys": ["比較係數", "2"], "tag": "方法", "glyph": "×",
				 "formulas": ["P 在直線 DE 上：\\vec{AP} 寫成 \\vec{AD}、\\vec{AE} 的組合，係數和 = ?{1}",
					"兩條線各寫一個式子，?{聯立}就是交點"],
				 "notes": ["\\vec{AD} = \\frac{1}{3}\\vec{AB} ⇒ x\\vec{AB} = 3x\\vec{AD}", "求比：設 \\vec{AF} = t\\vec{AD}，t 就是 \\ol{AF} : \\ol{AD}"],
				 "example": "\\vec{AD} = \\frac{1}{3}\\vec{AB}、\\vec{AE} = \\frac{3}{4}\\vec{AC}，CD 交 BE：3x + y = 1、x + \\frac{4}{3}y = 1",
				 "check": {"q": "\\vec{AE} = \\frac{1}{2}\\vec{AC}，P 在 BE 上，x\\vec{AB} + y\\vec{AC} 的關係？", "opts": ["x + 2y = 1", "x + \\frac{1}{2}y = 1", "2x + y = 1"], "a": 0,
					"why": "y\\vec{AC} = 2y\\vec{AE}，x + 2y = 1。", "hint": "\\vec{AC} 是幾倍的 \\vec{AE}？"}},
				{"title": "斜坐標的區域", "decoys": ["> 1", "x − y"], "tag": "方法", "glyph": "△",
				 "formulas": ["P 在 △ABC 內部 ⇔ x > 0、y > 0、x + y ?{< 1}", "x、y 的範圍圍出平行四邊形，面積 = 範圍長相乘 × ?{2△ABC}"],
				 "notes": ["x + y = 1 是直線 BC，x = 0 是直線 AC，y = 0 是直線 AB", "三條邊延長把平面分成七塊"],
				 "example": "−1 ≤ x ≤ 2、0 ≤ y ≤ 2：3 × 2 × 2△ABC",
				 "check": {"q": "\\vec{AP} = 2\\vec{AB} + \\vec{AC}，P 在哪裡？", "opts": ["BC 的另一側", "三角形裡", "和 A 同一側"], "a": 0,
					"why": "x + y = 3 > 1。", "hint": "看 x + y。"}},
				{"title": "坐標與單位向量", "decoys": ["1", "一個"], "tag": "公式", "glyph": "(x,y)",
				 "formulas": ["\\vec{AB} = B − A，|\\vec{a}| = √(x^{2} + y^{2})", "和 \\vec{a} 平行的單位向量：±\\vec{a} 除以 ?{|\\vec{a}|}，共 ?{兩個}"],
				 "notes": ["角平分向量：\\frac{\\vec{a}}{|\\vec{a}|} + \\frac{\\vec{b}}{|\\vec{b}|}", "平行又知道長度：單位向量乘長度"],
				 "example": "\\vec{a} = (3, −4)：\\vec{e} = ±(\\frac{3}{5}, −\\frac{4}{5})",
				 "check": {"q": "(6, 8) 的單位向量（同方向）？", "opts": ["(\\frac{3}{5}, \\frac{4}{5})", "(\\frac{6}{14}, \\frac{8}{14})", "(1, 1)"], "a": 0,
					"why": "長度 10，除以 10。", "hint": "先算長度。"}},
				{"title": "加權平均", "decoys": ["\\vec{PG}", "中點"], "tag": "公式", "glyph": "Σw",
				 "formulas": ["w_{A}\\vec{PA} + w_{B}\\vec{PB} + w_{C}\\vec{PC} = \\vec{0} ⇒ P 是三點的 ?{加權平均}",
					"2\\vec{PA} + \\vec{PB} = ?{3\\vec{PG}}，G = \\frac{2A + B}{3}"],
				 "notes": ["權重大的點拉得比較用力", "|3\\vec{PG}| 最小：P 離 G 最近"],
				 "example": "\\vec{PA} + 2\\vec{PB} + \\vec{PC} = \\vec{0} ⇒ P = \\frac{A + 2B + C}{4}",
				 "check": {"q": "\\vec{PA} + \\vec{PB} + \\vec{PC} = \\vec{0}，P 是？", "opts": ["重心", "內心", "外心"], "a": 0,
					"why": "P = \\frac{A + B + C}{3}。", "hint": "權重都是 1。"}},
			]
	return []
