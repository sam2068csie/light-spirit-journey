				 "check": {"q": "\\vec{OA} · \\vec{OB} = \\vec{OC} · \\vec{OB}，一定成立的是？", "opts": ["\\vec{AC} ⊥ \\vec{OB}", "\\vec{OA} = \\vec{OC}", "\\vec{OA} ⊥ \\vec{OB}"], "a": 0,
					"why": "(\\vec{OA} − \\vec{OC}) · \\vec{OB} = 0。", "hint": "移到同一邊。"}},
			]
		"V4":
			return [
