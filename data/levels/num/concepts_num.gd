extends RefCounted
## 數與式單元（R1～R8）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測、kind = "order" 拼流程）。
const UITheme := preload("res://data/ui/game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"R1":
			return [
				{"title": "循環小數化分數", "decoys": ["錯開", "乘 10"], "tag": "技巧", "glyph": "0.\\ol{ab}",
				 "formulas": ["循環節有 n 位：x 乘 ?{10^{n}}，讓兩條尾巴 ?{對齊} 再相減",
					"0.\\ol{ab} = ?{\\frac{ab}{99}}"],
				 "notes": ["小數點後先有不循環的部分：先乘 10 的幾次方，讓循環節 ?{緊貼小數點}", "0.\\ol{9} = ?{1}"],
				 "example": "1.2\\ol{36}：1000x − 10x = 1236 − 12 ⇒ x = \\frac{1224}{990} = \\frac{68}{55}",
				 "trap": "循環小數相加要先化成分數：0.\\ol{4} + 0.\\ol{36} = [b]0.\\ol{80}[/b]，不是 0.\\ol{40}！",
				 "check": {"q": "0.\\ol{45} = ？", "opts": ["\\frac{5}{11}", "\\frac{9}{20}", "\\frac{45}{100}"], "a": 0,
					"why": "0.\\ol{45} = \\frac{45}{99} = \\frac{5}{11}。", "hint": "循環節兩位，分母 99。"}},
				{"title": "有限小數還是循環小數", "decoys": ["3", "分子"], "tag": "定義", "glyph": "2·5",
				 "formulas": ["最簡分數的分母只有質因數 ?{2} 和 ?{5} ⇔ 可以化成有限小數"],
				 "notes": ["一定要先 ?{約分}：\\frac{21}{56} = \\frac{3}{8} 是有限小數", "分母有別的質因數 p：?{分母} 的 p 要被分子約掉"],
				 "example": "\\frac{27}{120} = \\frac{9}{40}，40 = 2^{3} × 5 ⇒ 有限小數 0.225",
				 "check": {"q": "哪一個可以化成有限小數？", "opts": ["\\frac{33}{75}", "\\frac{9}{42}", "\\frac{14}{45}"], "a": 0,
					"why": "\\frac{33}{75} = \\frac{11}{25}，分母只有 5。", "hint": "先約分。"}},
				{"title": "循環小數的第 n 位", "decoys": ["商", "n − 1"], "tag": "技巧", "glyph": "n",
				 "formulas": ["n 除以循環節的 ?{位數}，看 ?{餘數} r：第 n 位 = 循環節的第 r 個數字"],
				 "notes": ["r = 0：是循環節的 ?{最後一個} 數字", "不循環的部分要先 ?{扣掉}，再開始數"],
				 "example": "\\frac{1}{7} = 0.\\ol{142857}，100 = 6 × 16 + 4 ⇒ 第 100 位是 8",
				 "check": {"q": "0.\\ol{285714} 的第 12 位是？", "opts": ["4", "2", "1"], "a": 0,
					"why": "12 = 6 × 2 + 0，餘數 0：是循環節的最後一個數字 4。", "hint": "餘數 0 是最後一個。"}},
				{"title": "比大小的方法", "decoys": ["開根號", "相乘"], "tag": "技巧", "glyph": "<",
				 "formulas": ["兩個正數比大小，可以先 ?{平方} 再比", "根號相減：先 ?{有理化}，√p − √q = \\frac{p − q}{√p + √q}"],
				 "notes": ["分子分母很接近的分數：比「離 ?{1} 差多少」", "分子一樣的正分數：分母越 ?{小} 越大", "負數：離 0 越遠越 ?{小}"],
				 "example": "√11 + √3 和 √10 + 2：平方後 14 + 2√33 < 14 + 2√40",
				 "check": {"q": "√7 − √5 和 √5 − √3，哪一個比較大？", "opts": ["√5 − √3", "√7 − √5", "一樣大"], "a": 0,
					"why": "有理化：\\frac{2}{√7 + √5} < \\frac{2}{√5 + √3}，分母小的比較大。", "hint": "分子都是 2，比分母。"}},
				{"title": "不等式的性質", "decoys": ["一定成立", "相乘"], "tag": "定義", "glyph": "a > b",
				 "formulas": ["a > b、c > d ⇒ a + c ?{>} b + d（同方向可以 ?{相加}）"],
				 "notes": ["兩邊同乘負數，不等號要 ?{變向}", "相減、相乘、取倒數、平方：要先看 ?{正負}", "推翻一個說法，找一組 ?{反例} 就夠了"],
				 "example": "a = 1、b = −1、c = −1、d = −2：a > b、c > d，可是 ac = −1 < bd = 2",
				 "check": {"q": "a > b，下面哪一個一定成立？", "opts": ["a − 3 > b − 3", "a^{2} > b^{2}", "\\frac{1}{a} < \\frac{1}{b}"], "a": 0,
					"why": "兩邊同減 3，不等號不變。a^{2} > b^{2}、\\frac{1}{a} < \\frac{1}{b} 都可以用負數推翻。", "hint": "試試 a = 1、b = −2。"}},
			]
	return []
