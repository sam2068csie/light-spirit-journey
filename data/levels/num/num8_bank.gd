extends RefCounted
## 數與式 第八大關「谷底水渠」題庫（對應講義重點八：數線上的幾何）
## 設計稿：docs/num_r8_design.md。題目的數字都用程式驗算過（tools/num/verify_r8.py）。
##
## 旅程（引擎見 num_level.gd）：
##   forge  一步一步推導：ltap（點數線：解的那幾段、轉折點、整數解、中心、最低的地方）、lrange（拉出範圍）、
##          slide（坐標方格上拖 P 找最少、水平線 y = k 數和水渠的交點，"cross": "k"）、grid（點出最低點）、filter、fill、choice
##   speed  速算：gen = "fence"（絕對值和範圍互換，按鈕）、"canal"（距離和的最小值，按鈕）
## 使用者 2026/11/16：||x + 1| − |x − 2|| ≤ x 放塔、解的個數做滑桿數交點、水電費換成交通費。

const SB := preload("res://data/levels/engine/step_bank.gd")
const B1 := preload("res://data/levels/num/num1_bank.gd")

const T_DIST := "num_absdist"    # 絕對值就是距離（|x − a| ≤ b、交集、整數解、平方法）
const T_REV := "num_absrev"      # 反寫成絕對值
const T_CASE := "num_abscase"    # 分段討論
const T_MED := "num_median"      # 中位數、解的個數、三角不等式

const E := 0.01                  # 閉區間點數線時往外放一點點，點在端點上也算


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 數線：x 是範圍，每個整數都標
static func _nl(x: Array, pts := [], bars := [], extra := {}) -> Dictionary:
	var d := {"k": "nline", "x": x, "pts": pts, "tick": 1.0}
	if not bars.is_empty():
		d["bars"] = bars   # 有燈條（或要拉範圍）時數線放低一點，上面一排一排疊燈條
	d.merge(extra, true)
	return d


static func _bar(lo: float, hi: float, row: int, at: int, c := "lime", s := "") -> Dictionary:
	return {"lo": lo, "hi": hi, "s": s, "row": row, "at": at, "c": c}


## 點數線：regions 每一段都要點到一次，wrongs = [[lo, hi, "點錯的理由"], …]
static func _tap(name: String, q: String, regions: Array, hits: Array, miss: float, wrongs: Array, snap: float,
		nudge: String, line: String, tag: String) -> Dictionary:
	return {"kind": "ltap", "name": name, "tag": tag, "q": q, "item": 0, "snap": snap, "a": 0, "b": 0,
		"regions": regions, "wrongs": wrongs, "wrong": "", "hits": hits, "miss": miss, "nudge": nudge, "line": line}


## 點一個點（或一個值）：在 v 附近
static func _at(v: float, w := 0.1) -> Array:
	return [v - w, v + w]


## 拉範圍
static func _rng(name: String, q: String, s: String, row: int, ans: Array, start: Array, snap: float,
		nudge: String, line: String, tag: String, demo := false) -> Dictionary:
	return {"kind": "lrange", "name": name, "tag": tag, "q": q, "item": 0, "row": row, "s": s, "ans": ans,
		"start": start, "snap": snap, "demo": demo, "wrongs": [], "nudge": nudge, "line": line}


static func _flt(name: String, q: String, cands: Array, keep: Array, kw: String, dw: String, line: String,
		nudge: String, tag: String) -> Dictionary:
	var st := B1._flt(name, q, cands, keep, kw, dw, line, nudge, tag)
	st["bare"] = true
	return st


## 路上的住戶 P（坐標方格上拖）：posts = [[x, "名字"], …]
static func _road(x0: float, x1: float, posts: Array, sols := []) -> Dictionary:
	var shapes := [{"k": "seg", "a": [x0, 0], "b": [x1, 0], "c": "dim", "w": 3.0}]
	for p in posts:
		shapes.append({"k": "dot", "p": [float(p[0]), 0], "s": String(p[1]), "c": "cyan", "off": [-6, 22]})
	# 解出來的 P：[x, 第幾步之後出現]
	for q in sols:
		shapes.append({"k": "dot", "p": [float(q[0]), 0], "s": "P", "c": "lime", "off": [-6, -14], "at": int(q[1])})
	return {"x": [x0, x1], "y": [-3, 3], "shapes": shapes}


static func _walk(name: String, q: String, lo: float, hi: float, start: float, goal: float, readout: String,
		line: String, nudge: String, tag: String) -> Dictionary:
	return {"kind": "slide", "name": name, "q": q, "params": [{"n": "x", "min": lo, "max": hi, "step": 0.5, "v": start}],
		"lines": [{"k": "dot", "p": ["x", "0"], "s": "P", "c": "gold", "off": [-6, -14]}],
		"eq": readout, "goal": {"x": goal}, "keep": true, "line": line, "nudge": nudge, "tag": tag}


## 折線圖形：pts 由左到右，每一段標 "cross"（滑桿的水平線數交點用）
static func _graph(pts: Array, at := 0, c := "cyan") -> Array:
	var out := []
	for k in pts.size() - 1:
		out.append({"k": "seg", "a": pts[k], "b": pts[k + 1], "c": c, "w": 3.0, "cross": true, "at": at})
	return out


## 推水平線 y = k 數交點
static func _push(name: String, q: String, start: float, goal: float, line: String, nudge: String) -> Dictionary:
	return {"kind": "slide", "name": name, "q": q, "params": [{"n": "k", "min": 0, "max": 13, "step": 1, "v": start}],
		"lines": [{"k": "line", "abc": ["0", "1", "-k"], "c": "gold"}], "cross": "k",
		"eq": "y = {k}：交點 {#cross}", "goal": {"k": goal}, "keep": false, "line": line, "nudge": nudge, "tag": T_MED}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
	return out


