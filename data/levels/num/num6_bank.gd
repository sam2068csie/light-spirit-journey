extends RefCounted
## 數與式 第六大關「剝殼磨坊」題庫（對應講義重點六：雙根號問題）
## 設計稿：docs/num_r6_design.md。題目的數字都用程式驗算過（tools/num/verify_r6.py）。
##
## 旅程（引擎見 num_level.gd）：
##   forge  一步一步推導：rtap（點面積 b、長 + 寬 = a 的長方形）、ltap（點出在哪兩個整數之間）、fill、choice
##   speed  速算：gen = "husk"（雙重根號化簡，按鈕）、"int"（整數部分，按鈕）
## 看圖作答、少讀字（design_rules 1.8）：找兩個數點長方形，整數部分在數線上點。

const SB := preload("res://data/levels/engine/step_bank.gd")
const B1 := preload("res://data/levels/num/num1_bank.gd")

const T_HUSK := "num_husk"         # 雙重根號化簡（找兩個數、大的在前、先湊 2√b）
const T_LAYER := "num_layer"       # 兩層的、化簡後比較係數
const T_INT := "num_intpart"       # 整數部分、小數部分


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 面積 b 的長方形（長 ≥ 寬，長的排前面），長 + 寬 = a 的是答案
static func _rects(a: int, b: int, at: int) -> Dictionary:
	var pairs := []
	var target := -1
	for w in range(1, int(sqrt(float(b))) + 1):
		if b % w == 0:
			pairs.append([b / w, w])
	for k in pairs.size():
		if int(pairs[k][0]) + int(pairs[k][1]) == a:
			target = k
	assert(target >= 0)
	return {"k": "rects", "pairs": pairs, "target": target, "at": at}


static func _pick(name: String, a: int, line: String) -> Dictionary:
	return {"kind": "rtap", "name": name, "tag": T_HUSK, "q": "點出長 + 寬 = %d 的" % a, "item": 0,
		"nudge": "面積對了，長 + 寬要是 %d。" % a, "line": line}


## 在數線上點出落在哪兩個整數之間：答案在 k 和 k + 1 之間
static func _between(name: String, q: String, k: int, left: String, right: String, nudge: String, line: String, tag := T_INT) -> Dictionary:
	return {"kind": "ltap", "name": name, "tag": tag, "q": q, "item": 0, "snap": 0.25, "a": 0, "b": 0,
		"regions": [[k, k + 1]], "wrongs": [[-1e9, k + 0.001, left], [k + 0.999, 1e9, right]], "wrong": "",
		"hits": [k + 0.5], "miss": k + 1.5, "nudge": nudge, "line": line}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
	return out


