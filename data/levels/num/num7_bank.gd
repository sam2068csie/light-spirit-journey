extends RefCounted
## 數與式 第七大關「方田拼圖」題庫（對應講義重點七：乘法公式）
## 設計稿：docs/num_r7_design.md。題目的數字都用程式驗算過（tools/num/verify_r7.py）。
##
## 旅程（引擎見 num_level.gd）：
##   forge  一步一步推導：天秤（審判時點數字卡）、ctap（點正負號相反的項）、sqtap（點拿掉的是正方形的麥田）、
##          lsort（因式配對、正負號）、gtap（梯子點要踩的階）、slide（拖滑桿放空水槽）、fill、choice
##   speed  速算：gen = "formula"（公式的係數，按鈕）、"sym"（倒數、對稱式，按鈕）
## 使用者 2026/11/16：天秤數字卡隨便點、兩塊麥田、梯子每一階先點要踩哪一階、平方和 ≤ 0 拖滑桿。

const SB := preload("res://data/levels/engine/step_bank.gd")
const B1 := preload("res://data/levels/num/num1_bank.gd")

const T_CUBE := "num_cube"       # 立方公式、立方根的有理化、x + y + z = 0 的立方和
const T_BLOCK := "num_block"     # 看成一整塊、平方差、湊成平方差、兩兩配對
const T_RECIP := "num_recip"     # 倒數的梯子、對稱式互求
const T_SQ0 := "num_sq0"         # 平方和是 0、根號裡的絕對值



static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 等式審判：天秤上放兩邊，判成立、不成立
static func _id(name: String, ok: bool, why: String, line: String, tag: String) -> Dictionary:
	return _c(name, "天秤兩邊一定一樣重？", [B1.YES, B1.NO], 0 if ok else 1, why, "點數字卡試試看。", line, tag)


## 天秤上的一條等式：L、R 是排版，fl、fr 是算式（a、b、c），steps 是哪幾步顯示它
static func _eq(l: String, r: String, fl: String, fr: String, steps: Array, bad := -1) -> Dictionary:
	var d := {"L": l, "R": r, "fl": fl, "fr": fr, "steps": steps}
	if bad >= 0:
		d["bad"] = bad
		d["bad_at"] = int(steps.back())
	return d


const CARDS2 := [[1, 1], [2, 1], [1, -1], [2, -1], [0, 1]]
const CARDS3 := [[1, 1, 1], [2, 1, 0], [1, -1, 2], [0, 1, 3]]


## 梯子點要踩的階
static func _rung(q: String, alts: Array, nudge: String, why := {}) -> Dictionary:
	return {"kind": "gtap", "name": "踩哪一階", "tag": T_RECIP, "q": q, "item": 0, "alts": alts, "why": why,
		"nudge": nudge, "line": ""}


## 水槽：第 k 個水槽在 x = k + 1，水位是 expr（含滑桿的變數）
static func _tank(k: int, expr: String, lab: String) -> Array:
	var x := 3.0 + 4.0 * k
	return [{"k": "seg", "a": [str(x), "0"], "b": [str(x), expr], "c": "cyan", "w": 34.0}]


static func _tank_box(k: int, lab: String, at: int) -> Array:
	var x := 3.0 + 4.0 * k
	return [{"k": "poly", "pts": [[x - 1.0, 0], [x + 1.0, 0], [x + 1.0, 9.6], [x - 1.0, 9.6]], "c": "dim"},
		{"k": "label", "p": [x, -1.0], "s": lab, "at": at, "c": "text"}]


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
				if String(st.get("kind", "")) == "lsort" and st.has("why"):
					var w := {}
					for k in st.why:
						w[SB.root_markup(String(k))] = st.why[k]
					st["why"] = w
	return out


