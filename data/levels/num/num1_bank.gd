extends RefCounted
## 數與式 第一大關「風車小數」題庫（對應講義重點一：數線）
## 設計稿：docs/num_r1_design.md。題目的數字都用程式驗算過（tools/num/verify_r1.py）。
##
## 旅程（引擎見 line_level.gd、level_num1_mill.gd）：
##   forge  一步一步推導：choice、fill、filter、order，第二章的尺規作圖用坐標方格（plane、slide）
##   speed  速算：gen = "mill"（循環小數化分數、有限或循環）、"cmp"（兩個數比大小）
## 題目可以帶 "field"：推導紀錄下方的原野（num_field.gd）：風車 mill、數線 nline、質因數積木 blocks。
##   每個元件的 at、spin、lit… 都是「做完第幾步之後」（0 = 一開始），答錯時元件會晃一下。
##
## 觀念標籤都用 num_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。
## 審判卡（○／✕）是兩個選項的 choice：「○ 成立」固定在左、「✕ 不成立」固定在右（choice_order.gd）。

const SB := preload("res://data/levels/engine/step_bank.gd")

const T_DENSE := "num_dense"       # 有理數的稠密性
const T_REP := "num_repeat"        # 循環小數和分數互換
const T_FIN := "num_finite"        # 有限小數的判斷
const T_DIG := "num_digit"         # 循環小數的第 n 位
const T_CON := "num_construct"     # 尺規作圖（比例、√ab）
const T_CMP := "num_compare"       # 比大小（分數、根號）
const T_INEQ := "num_ineq"         # 不等式的性質
const T_ROUND := "num_round"       # 四捨五入的範圍

const YES := "○ 成立"
const NO := "✕ 不成立"


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 審判卡：statement 成立嗎？
static func _j(name: String, statement: String, ok: bool, why: String, line: String, tag: String) -> Dictionary:
	return SB.choice(name, statement, [YES, NO], 0 if ok else 1, why, "想一想有沒有例外。", line, tag)


static func _flt(name: String, q: String, cands: Array, keep: Array, kw: String, dw: String, line: String,
		nudge: String, tag: String) -> Dictionary:
	var st := SB.filter(name, q, cands, keep, line, nudge, tag)
	st["keep_word"] = kw
	st["drop_word"] = dw
	return st


static func _o(q: String, items: Array, line: String, nudge: String, tag: String) -> Dictionary:
	var its := []
	for it in items:
		its.append(SB.item(it[0], it[1], float(it[2])))
	return SB.order(q, its, line, nudge, tag)


# ---------- 原野的元件 ----------

static func _mill(i: String, pre: String, rep: String, lit: int, spin: int, extra := {}) -> Dictionary:
	var d := {"k": "mill", "int": i, "pre": pre, "rep": rep, "lit": lit, "spin": spin}
	d.merge(extra, true)
	return d


static func _nl(x: Array, pts: Array, extra := {}) -> Dictionary:
	var d := {"k": "nline", "x": x, "pts": pts}
	d.merge(extra, true)
	return d


static func _pt(v: float, s: String, at := 0, lit := -1, extra := {}) -> Dictionary:
	var d := {"v": v, "s": s, "at": at, "lit": lit}
	d.merge(extra, true)
	return d


static func _blocks(num, den: Array, cancel: Array, judge: Array) -> Dictionary:
	return {"k": "blocks", "num": num, "den": den, "cancel": cancel, "judge": judge}


# ---------- 坐標方格 ----------

static func _plane(x: Array, y: Array, shapes: Array) -> Dictionary:
	return {"x": x, "y": y, "shapes": shapes}


static func _p(s: String, x: float, y: float, at := 0, off := [8, -8], c := "text") -> Dictionary:
	return {"k": "dot", "p": [x, y], "s": s, "at": at, "off": off, "c": c}


static func _seg(a: Array, b: Array, at := 0, c := "dim", dash := false) -> Dictionary:
	return {"k": "seg", "a": a, "b": b, "at": at, "c": c, "dash": dash}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
				elif String(st.get("kind", "")) == "filter":
					st["bare"] = true
	return out


