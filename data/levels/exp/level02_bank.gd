	"recip#2/列式": "代入：t + 9/t = 10",
	"conj#0/列式": "代入：t + 1/t = 14",
	"conj#1/列式": "代入：t + 1/t = 10",
	"conj#2/列式": "代入：t + 1/t = 6",
	"cond#0/列式": "代入：t^{2} − 2 = t",
	"boss2#0/求 x": "2^{x} + 2^{−x} = 5/2：令 u = 2^{x}，u + 1/u = 5/2 ⇒ u = 2 或 1/2",
	"tune#0/判別式": "兩個相異的 t ⇔ 判別式 D > 0",
	"tune#0/兩根都 > 1": "兩根都 > 1 ⇔ (t₁ − 1) + (t₂ − 1) > 0 且 (t₁ − 1)(t₂ − 1) > 0",
	"tune#1/兩根都 > 0": "兩根都 > 0 ⇔ t₁ + t₂ > 0 且 t₁t₂ > 0",
}


