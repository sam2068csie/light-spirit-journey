extends RefCounted
## 第二大關「換元鍛造所」題庫（對應講義 重點二：指數方程式）
##
## 旅程類型 type：
##   forge  一步一步「鍛造」出答案。steps 裡每一步是：
##            choice  選擇題（例如要令 t 等於什麼）
##            fill    用數字鍵盤填空：template 裡的 [0]、[1]… 是空格，answers 是答案（可以寫成 "1/4"）
##                    mode：ordered 依序比對（預設）、set 順序不限、prop 係數成比例就算對（例如 4t² − 9t + 2 = 0
##                    寫成 8t² − 18t + 4 = 0 也對）
##            filter  篩選：cands 是候選值，keep 是哪些該留下（例如 t = 2^{x} 必須大於 0）
##          每一步答對後，line 會寫到左邊的「鍛造紀錄」上，最後就是一份完整的計算過程。
##          graph：在鍛造台下方畫出 t 的二次函數（coef = [a, b, c]），after 這一步之後出現，
##          filter 這一步之後把被丟掉的根打叉。
##          verify：測試用，f(x) 在每個 roots 上應該等於 0。
##   speed  速算爐：限時連續解題（題目由 gen 產生：pow1 一邊是數字、pow2 兩邊都要化同底）
##   tune   參數調頻：拖動參數，看 t 的拋物線在 t > region 的地方和 t 軸交幾次，完成 goals，
##          最後回答 final（範圍題）。coef 的每一項是 [常數, 參數的係數]。
##
## 新增題目：在對應 slot 的 variants 裡加一筆即可（可執行 test_forge 檢查答案）。

const T_POS := "t = 2^{x} 一定大於 0。哪些 t 可以留下？"


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag := "exp_eq_sub") -> Dictionary:
	return {"kind": "choice", "name": name, "q": q, "options": options, "correct": correct,
		"why": why, "nudge": nudge, "line": line, "tag": tag}


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		mode := "ordered", tag := "exp_eq_calc") -> Dictionary:
	return {"kind": "fill", "name": name, "q": q, "template": template, "answers": answers,
		"line": line, "nudge": nudge, "mode": mode, "tag": tag}


static func _k(name: String, q: String, cands: Array, keep: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "filter", "name": name, "q": q, "cands": cands, "keep": keep, "line": line,
		"nudge": nudge, "tag": "exp_eq_positive"}


## 「令 t = a^{x}」的選擇題
static func _t_def(options: Array, why: String, nudge: String, line: String) -> Dictionary:
	return _c("換元", "令 t 等於什麼，可以把方程式變成 t 的二次方程式？", options, 0, why, nudge, line)


static func _coef(answers: Array, line: String, nudge: String, q := "把方程式改寫成 t 的方程式，填入係數。") -> Dictionary:
	return _f("列式", q, "[0]t^{2} + [1]t + [2] = 0", answers, line, nudge, "prop")


static func _troots(answers: Array, line: String, nudge: String) -> Dictionary:
	var st := _f("解 t", "解出 t（順序不限）。", "t = [0] 或 t = [1]", answers, line, nudge, "set")
	st["fac_line"] = line     # slots() 最後會在它前面自動補上「因式分解」這一步
	return st


## 從「(t − 4)(8t − 1) = 0 ⇒ …」或「x(x − 6) = 0」讀出兩個因式 [[K1, c1], [K2, c2]]（代表 (K1·v + c1)(K2·v + c2)）
static func _parse_factors(line: String, v := "t") -> Array:
	var left := line.split("⇒")[0].strip_edges()
	var re := RegEx.new()
	re.compile("\\((\\d*)" + v + "\\s*([+−-])\\s*(\\d+)\\)")
	var out := []
	if left.begins_with(v + "("):
		out.append([1, 0])          # x(x − 6)：提出公因式 x
	for m in re.search_all(left):
		var k := 1 if m.get_string(1) == "" else int(m.get_string(1))
		var c := int(m.get_string(3)) * (1 if m.get_string(2) == "+" else -1)
		out.append([k, c])
	return out


static func _fac_text(k: int, c: int, v := "t") -> String:
	var lead := ("" if k == 1 else str(k)) + v
	if c == 0:
		return lead
	return "(%s %s %d)" % [lead, "+" if c > 0 else "−", absi(c)]


static func _poly_text(a: int, b: int, c: int, v := "t") -> String:
	var t := ("" if a == 1 else str(a)) + v + "^{2}"
	if b != 0:
		t += (" + " if b > 0 else " − ") + ("" if absi(b) == 1 else str(absi(b))) + v
	if c != 0:
		t += (" + " if c > 0 else " − ") + str(absi(c))
	return t


static func _num(n: int) -> String:
	return ("−" if n < 0 else "") + str(absi(n))


static func _signed_t(n: int, v := "t") -> String:
	if n == 0:
		return ""
	return (" + " if n > 0 else " − ") + ("" if absi(n) == 1 else str(absi(n))) + v


static func _expand(f: Array) -> Array:
	return [f[0][0] * f[1][0], f[0][0] * f[1][1] + f[0][1] * f[1][0], f[0][1] * f[1][1]]


## 兩個因式寫在一起：常數項是 0 的那個（x）放前面
static func _pair_text(f: Array, v: String) -> String:
	if f[1][1] == 0 and f[0][1] != 0:
		return _fac_text(f[1][0], f[1][1], v) + _fac_text(f[0][0], f[0][1], v)
	return _fac_text(f[0][0], f[0][1], v) + _fac_text(f[1][0], f[1][1], v)


## 「解 t」前面的因式分解選擇題：選項是正解＋三個常見的錯（正負號弄反、常數放錯括號）
static func _factor_step(st: Dictionary, v := "t") -> Dictionary:
	var f := _parse_factors(String(st.fac_line), v)
	if f.size() != 2:
		return {}
	var k1: int = f[0][0]
	var c1: int = f[0][1]
	var k2: int = f[1][0]
	var c2: int = f[1][1]
	var abc := _expand(f)
	var poly := _poly_text(abc[0], abc[1], abc[2], v)
	var right := _pair_text(f, v)
	var opts := [right]
	var seen := [abc]
	for cand in [[[k1, -c1], [k2, -c2]], [[k1, c2], [k2, c1]], [[k1, -c1], [k2, c2]], [[k1, c1], [k2, -c2]],
			[[k1, -c2], [k2, -c1]], [[k2, c1], [k1, c2]], [[k1, c1 - 1], [k2, c2 + 1]], [[k1, c1 + 1], [k2, c2 - 1]]]:
		var ex := _expand(cand)
		var txt := _pair_text(cand, v)
		if opts.size() < 4 and not opts.has(txt) and not seen.has(ex):
			opts.append(txt)
			seen.append(ex)
	var mid := ("−" if abc[1] < 0 else "") + ("" if absi(abc[1]) == 1 else str(absi(abc[1]))) + v
	var nudge := ""
	if abc[2] == 0:
		nudge = "沒有常數項：每一項都有 %s，先把 %s 提出來。" % [v, v]
	elif abc[0] == 1:
		nudge = "找兩個數，相乘 %s、相加 %s（小心正負號）。" % [_num(abc[2]), _num(abc[1])]
	else:
		nudge = "十字交乘：%d 和 %s 各拆成兩個數，交叉相乘再相加要等於中間項 %s。" % [abc[0], _num(abc[2]), mid]
	# 展開檢查：(t − 2)(4t − 1) = 4t^{2} − t − 8t + 2 = 4t^{2} − 9t + 2
	var terms := _poly_text(abc[0], 0, 0, v) + _signed_t(k1 * c2, v) + _signed_t(c1 * k2, v)
	if abc[2] != 0:
		terms += (" + " if abc[2] > 0 else " − ") + str(absi(abc[2]))
	var why := "展開回去：%s = %s = %s ✓" % [right, terms, poly]
	if terms == poly:
		why = "展開回去：%s = %s ✓" % [right, poly]
	return _c("因式分解", "先因式分解：%s = ？" % poly, opts, 0, why, nudge, right + " = 0", "exp_eq_calc")


## 每一步開始前寫進推導紀錄的「已知」（只看中間也不會跳步）。table：{"slot#變體/步驟名稱": "一行" 或 [好幾行]}
static func apply_pre(out: Array, table: Dictionary) -> void:
	for slot in out:
		var vs: Array = slot.get("variants", [])
		for vi in vs.size():
			for st in vs[vi].get("steps", []):
				var key := "%s#%d/%s" % [slot.id, vi, st.get("name", "")]
				if table.has(key) and not st.has("pre"):
					st["pre"] = table[key]
					# 「令 t = …：」已經寫在前一行了，這一步的結果就不用再寫一次
					var first := String(table[key] if table[key] is String else table[key][0])
					var cut := first.find("：")
					if first.begins_with("令 ") and cut > 0 and String(st.get("line", "")).begins_with(first.substr(0, cut + 1)):
						st["line"] = "⇒ " + String(st.line).substr(cut + 1)


## 每一個有 fac_line 的「解 …」前面補上因式分解；後面的步驟編號（graph.filter）跟著往後移
static func _add_factor_steps(out: Array, tag := "") -> void:
	for slot in out:
		for vt in slot.get("variants", []):
			if not vt.has("steps"):
				continue
			var steps: Array = vt.steps
			var i := 0
			while i < steps.size():
				var st: Dictionary = steps[i]
				if st.has("fac_line"):
					var v: String = st.get("fac_var", "t")
					var fs := _factor_step(st, v)
					if not fs.is_empty():
						if tag != "":
							fs["tag"] = tag
						steps.insert(i, fs)
						var f := _parse_factors(String(st.fac_line), v)
						var parts := PackedStringArray()
						for fc in f:
							parts.append(_fac_text(fc[0], fc[1], v).trim_prefix("(").trim_suffix(")") + " = 0")
						var fl := String(st.fac_line)
						if fl.contains("⇒"):
							st["line"] = fl.split("⇒")[-1].strip_edges()
						else:
							var ans: Array = st.answers.map(func(a): return String(a).replace("-", "−"))
							st["line"] = "%s = %s 或 %s = %s" % [v, ans[0], v, ans[1]]
						st["nudge"] = "每個因式分別等於 0：" + "、".join(parts) + "。"
						if vt.has("graph") and vt.graph.has("filter") and int(vt.graph.filter) >= i:
							vt.graph["filter"] = int(vt.graph.filter) + 1
						i += 1
					st.erase("fac_line")
					st.erase("fac_var")
				i += 1


