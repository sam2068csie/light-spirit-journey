extends RefCounted
## 直線與圓單元（C1～C8）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測、kind = "order" 拼流程）。
const UITheme := preload("res://data/ui/game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"C1":
			return [
				{"title": "中點與距離", "decoys": ["相減除以 2", "x 差 + y 差"], "tag": "公式", "glyph": "M",
				 "formulas": ["中點 M = (?{\\frac{x₁ + x₂}{2}}, ?{\\frac{y₁ + y₂}{2}})", "\\ol{AB} = ?{√((x₂ − x₁)^{2} + (y₂ − y₁)^{2})}"],
				 "notes": ["距離就是橫向、縱向走的格數用 ?{畢氏定理}", "常見的畢氏數：3、4、5，?{5、12、13}，8、15、17"],
				 "example": "A(−1, 2)、B(5, 6)：M = (2, 4)，\\ol{AB} = √(36 + 16) = 2√13",
				 "check": {"q": "A(1, 1)、B(4, 5) 的距離是？", "opts": ["5", "7", "25"], "a": 0,
					"why": "橫向 3、縱向 4：√(9 + 16) = 5。", "hint": "3、4、5。"}},
				{"title": "分點公式", "decoys": ["\\frac{m·A + n·B}{m + n}", "\\frac{A + B}{m + n}"], "tag": "公式", "glyph": "m : n",
				 "formulas": ["P 在 \\ol{AB} 上、\\ol{AP} : \\ol{PB} = m : n ⇒ P = ?{\\frac{n·A + m·B}{m + n}}"],
				 "notes": ["P 離 ?{B} 越近，B 的權重越大（權重交叉放）", "也可以想成：從 A 往 B 走全程的 ?{\\frac{m}{m + n}}"],
				 "example": "A(−2, 1)、B(6, 5)、\\ol{AP} : \\ol{PB} = 3 : 1 ⇒ P = \\frac{A + 3B}{4} = (4, 4)",
				 "trap": "\\ol{AP} : \\ol{PB} = 3 : 1，A 的權重是 [b]1[/b]、B 的權重是 [b]3[/b]，不是反過來！",
				 "check": {"q": "\\ol{AP} : \\ol{PB} = 2 : 3，P = ？", "opts": ["\\frac{3A + 2B}{5}", "\\frac{2A + 3B}{5}", "\\frac{A + B}{2}"], "a": 0,
					"why": "\\ol{AP} 比較短，P 靠近 A，A 的權重比較大（3）。", "hint": "靠近誰，誰的權重就大。"}},
				{"title": "平行四邊形的第四點", "decoys": ["A + B = C + D", "1 種"], "tag": "技巧", "glyph": "▱",
				 "formulas": ["平行四邊形 ABCD：?{A + C = B + D}（對角線中點相同）"],
				 "notes": ["只給三點、沒說順序：第四點有 ?{3} 種", "D 的對角頂點是誰，就把另外兩點加起來減掉它"],
				 "example": "A(1, 1)、B(5, 2)、C(6, 5)，ABCD ⇒ D = A + C − B = (2, 4)",
				 "check": {"q": "平行四邊形 ABCD：A(0, 0)、B(3, 0)、C(4, 2)，D = ？", "opts": ["(1, 2)", "(7, 2)", "(−1, −2)"], "a": 0,
					"why": "D = A + C − B = (1, 2)。", "hint": "A + C = B + D。"}},
				{"title": "斜率", "decoys": ["\\frac{x₂ − x₁}{y₂ − y₁}", "鉛直線斜率 0"], "tag": "定義", "glyph": "m",
				 "formulas": ["m = ?{\\frac{y₂ − y₁}{x₂ − x₁}}：往右走 1 格，往上走 m 格"],
				 "notes": ["m > 0 往 ?{右上}、m < 0 往 ?{右下}", "水平線 m = ?{0}，鉛直線 ?{沒有斜率}",
					"共線 ⇔ 斜率 ?{相等}，垂直 ⇔ 斜率相乘 ?{−1}"],
				 "example": "A(−1, −2)、B(3, 4)：m = \\frac{6}{4} = \\frac{3}{2}",
				 "check": {"q": "斜率 2 的直線，和它垂直的直線斜率是？", "opts": ["−\\frac{1}{2}", "\\frac{1}{2}", "−2"], "a": 0,
					"why": "2 × (−\\frac{1}{2}) = −1。", "hint": "倒數再變號。"}},
				{"title": "三角形的三心", "decoys": ["重心到三頂點等距", "垂心是中線的交點"], "tag": "定義", "glyph": "△",
				 "formulas": ["重心 G = ?{三頂點坐標的平均}，是三條 ?{中線} 的交點", "外心：三條 ?{中垂線} 的交點，到 ?{三頂點} 等距",
					"垂心：三條 ?{高} 的交點"],
				 "notes": ["重心把中線分成 ?{2 : 1}（靠頂點那段長）", "∠A 的平分線交 \\ol{BC} 於 D ⇒ \\ol{BD} : \\ol{DC} = ?{\\ol{AB} : \\ol{AC}}"],
				 "example": "A(0, 0)、B(8, 0)、C(2, 6) 的外心 (4, 2)",
				 "check": {"q": "到三角形三個頂點等距離的點是？", "opts": ["外心", "重心", "垂心"], "a": 0,
					"why": "外接圓的圓心到三個頂點都是半徑。", "hint": "外接圓。"}},
			]
		"C2":
			return [
				{"title": "點斜式與兩點式", "decoys": ["y + y₀ = m(x + x₀)", "頂點"], "tag": "公式", "glyph": "y − y₀",
				 "formulas": ["過 (x₀, y₀)、斜率 m：?{y − y₀ = m(x − x₀)}"],
				 "notes": ["只知道兩點：先算 ?{斜率}，再用點斜式", "把平行四邊形面積分成兩半的直線，一定通過它的 ?{中心}"],
				 "example": "過 A(2, 1)、斜率 \\frac{3}{2}：y − 1 = \\frac{3}{2}(x − 2) ⇒ 3x − 2y − 4 = 0",
				 "check": {"q": "過 (1, 2)、斜率 3 的直線是？", "opts": ["y − 2 = 3(x − 1)", "y − 1 = 3(x − 2)", "y + 2 = 3(x + 1)"], "a": 0,
					"why": "點斜式 y − y₀ = m(x − x₀)，(x₀, y₀) = (1, 2)。", "hint": "y 減 y 坐標，x 減 x 坐標。"}},
				{"title": "斜截式與一般式", "decoys": ["\\frac{b}{a}", "−\\frac{b}{a}"], "tag": "公式", "glyph": "ax + by",
				 "formulas": ["y = mx + k：斜率 ?{m}、y 截距 ?{k}", "ax + by + c = 0：斜率 ?{−\\frac{a}{b}}"],
				 "notes": ["x 截距：令 ?{y = 0}", "y 截距：令 ?{x = 0}"],
				 "example": "2x − 3y + 6 = 0：斜率 \\frac{2}{3}、x 截距 −3、y 截距 2",
				 "check": {"q": "3x − 2y + 6 = 0 的斜率是？", "opts": ["\\frac{3}{2}", "−\\frac{3}{2}", "\\frac{2}{3}"], "a": 0,
					"why": "−\\frac{a}{b} = −\\frac{3}{−2} = \\frac{3}{2}。", "hint": "−\\frac{a}{b}，b 是 −2。"}},
				{"title": "截距式", "decoys": ["\\frac{x}{b} + \\frac{y}{a} = 1", "ab"], "tag": "公式", "glyph": "\\frac{x}{a}",
				 "formulas": ["x 截距 a、y 截距 b（都不是 0）：?{\\frac{x}{a} + \\frac{y}{b} = 1}"],
				 "notes": ["和兩軸圍出的三角形面積 = ?{\\frac{1}{2}|a||b|}", "過原點的直線，兩個截距都是 ?{0}，不能用截距式"],
				 "example": "x 截距 4、y 截距 −3：\\frac{x}{4} + \\frac{y}{−3} = 1 ⇒ 3x − 4y = 12，面積 6",
				 "trap": "「兩截距絕對值相等」別忘了 [b]過原點[/b] 的那一條！",
				 "check": {"q": "x 截距 2、y 截距 −4 的直線是？", "opts": ["2x − y = 4", "x − 2y = 4", "2x + y = 4"], "a": 0,
					"why": "\\frac{x}{2} + \\frac{y}{−4} = 1，兩邊乘 4：2x − y = 4。", "hint": "先寫成截距式，再去分母。"}},
				{"title": "平行、垂直與平移", "decoys": ["ax − by = k", "x + h"], "tag": "技巧", "glyph": "∥",
				 "formulas": ["和 ax + by + c = 0 平行：?{ax + by = k}", "和它垂直：?{bx − ay = k}"],
				 "notes": ["向右 h、向上 k：x 換成 ?{x − h}，y 換成 ?{y − k}", "平移不改變 ?{斜率}"],
				 "example": "過 (1, 2) 且平行 2x + 3y − 6 = 0：2x + 3y = 8",
				 "check": {"q": "過 (0, 0) 且和 x + 2y = 3 垂直的直線？", "opts": ["2x − y = 0", "x + 2y = 0", "2x + y = 0"], "a": 0,
					"why": "係數對調、其中一個變號：2x − y = k，過原點 k = 0。", "hint": "bx − ay = k。"}},
				{"title": "解的個數", "decoys": ["兩組解", "垂直"], "tag": "判斷", "glyph": "∩",
				 "formulas": ["\\frac{a₁}{a₂} ≠ \\frac{b₁}{b₂}：?{恰一組解}（相交）", "\\frac{a₁}{a₂} = \\frac{b₁}{b₂} ≠ \\frac{c₁}{c₂}：?{無解}（平行）",
					"三個比都相等：?{無限多組解}（重合）"],
				 "notes": ["三條直線圍不出三角形：有兩條 ?{平行}，或三條 ?{共點}"],
				 "example": "kx + 2y = 4、2x + ky = k + 2：k = 2 重合、k = −2 平行",
				 "check": {"q": "x + 2y = 3、2x + 4y = 5 的解？", "opts": ["無解", "恰一組", "無限多組"], "a": 0,
					"why": "\\frac{1}{2} = \\frac{2}{4} ≠ \\frac{3}{5}：兩線平行。", "hint": "比一比三個係數的比。"}},
				{"title": "恆過定點與象限", "decoys": ["原點", "m ≥ 0 且 k ≥ 0"], "tag": "技巧", "glyph": "✦",
				 "formulas": ["(L₁) + k(L₂) = 0 恆過 ?{L₁、L₂ 的交點}"],
				 "notes": ["過 P 的直線和 \\ol{AB} 相交：斜率介在 ?{m_{PA}、m_{PB}} 之間（轉動時沒經過鉛直線）",
					"y = mx + k 不經過第三象限 ⇔ ?{m ≤ 0 且 k ≥ 0}"],
				 "example": "(x + y − 3) + k(x − y + 1) = 0 恆過 (1, 2)",
				 "check": {"q": "(x − 1) + k(y + 2) = 0 恆過哪一點？", "opts": ["(1, −2)", "(−1, 2)", "(0, 0)"], "a": 0,
					"why": "x − 1 = 0 且 y + 2 = 0。", "hint": "兩個括號同時是 0。"}},
			]
	return []
