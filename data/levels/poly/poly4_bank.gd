extends RefCounted
## 多項式 第四大關「根之鑄模」題庫（對應講義 4-1 重點四：求多項式）
##
## 旅程（引擎見 step_level.gd，這一關的畫面見 level_poly4_mold.gd）：
##   forge  一步一步推導（choice、fill、filter；fill 可以帶 "echo"，代數時有回音的動畫，寫法同 P3）
##          probe 步驟（引擎在 level_poly3_echo.gd，畫面在 level_poly4_mold.gd 的 MoldView），這一關多了三種：
##            pins     圖形和 x 軸的交點：游標移到交點，按「標記這個根」（curve：{roots, k}）
##            stretch  轉動首項係數 k，讓曲線 k(x − r₁)(x − r₂)… + m 通過指定的點（goal：正確的 k）
##            shift    f(x) − m：調 m，讓幾個一樣高的點都落在 x 軸上（goal：正確的 m）
##          每一題可以帶：
##            "mold"：下方的鑄模。{form: 假設式（未知數寫成 {a}）, after: 第幾步之後出現（選好假設之後）,
##                    holes: [[未知數, 值, 第幾步之後算出來]…]}。算出一個未知數，熔液就倒進那一格
##            "cubic"：看圖題的三次函數圖 {roots: [根…], k: 首項係數, pt: [x, y]（圖上標出的另一點）}
##   speed  速算：gen = "mold"（已知根和一個點，求首項係數或函數值）
##
## 觀念標籤都用 poly_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。
## 題目的數字都用程式驗算過，而且不和講義、參考資料的題目一樣。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P2 := preload("res://data/levels/poly/poly2_bank.gd")
const P3 := preload("res://data/levels/poly/poly3_bank.gd")

const T_NEWT := P3.T_NEWT          # 牛頓階梯假設法（求多項式）
const T_ROOT := "poly_rootform"    # 利用根令式
const T_SAME := "poly_samevalue"   # 同值令式（f(x) − m 有根）
const T_GEN := "poly_general"      # 設一般式、對稱點相加減
const T_RFORM := "poly_remform"    # 利用餘式令式


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


static func _echo(st: Dictionary, x: String, val: String) -> Dictionary:
	return P3._echo(st, x, val)


## 鑄模：form 是假設式（未知數寫成 {a}），after：第幾步之後出現，holes：[[未知數, 值, 第幾步之後算出來]…]
static func _mold(form: String, after: int, holes: Array) -> Dictionary:
	return {"form": form, "after": after, "holes": holes}


## 找根：游標移到圖形和 x 軸的交點
static func _pins(roots: Array, k: float, line: String, nudge: String, lo := -4, hi := 5) -> Dictionary:
	return {"kind": "probe", "mode": "pins", "name": "找根", "q": "圖形和 x 軸的交點就是根（f(a) = 0）。把游標移到每一個交點，按「標記這個根」，全部標記起來。",
		"curve": {"roots": roots.map(func(r): return float(r)), "k": k}, "roots": roots.map(func(r): return str(r).replace("-", "−")),
		"den": 1, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_ROOT}


## 調首項係數：k(x − r₁)(x − r₂)… + m 要通過 pt
static func _stretch(roots: Array, m: float, pt: Array, goal: String, line: String, nudge: String, den := 2, lo := -3, hi := 3) -> Dictionary:
	return {"kind": "probe", "mode": "stretch", "name": "驗算 k", "q": "用圖形驗算：轉動 k，讓曲線剛好通過 (%s, %s)。" % [_n(pt[0]), _n(pt[1])],
		"curve": {"roots": roots.map(func(r): return float(r)), "m": m}, "pt": pt, "goal": goal,
		"den": den, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_ROOT}


## f(x) − m：調 m，讓幾個一樣高的點落在 x 軸上
static func _shift(pts: Array, goal: String, line: String, nudge: String, lo := -2, hi := 8) -> Dictionary:
	return {"kind": "probe", "mode": "shift", "name": "f(x) − m", "q": "這幾個點的 f 值一樣。調 m，讓 f(x) − m 在這幾個點都是 0（點都落在 x 軸上）。",
		"pts": pts, "goal": goal, "den": 1, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_SAME}


static func _n(v) -> String:
	var f := float(v)
	return (str(int(f)) if is_equal_approx(f, roundf(f)) else str(f)).replace("-", "−")


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


