extends RefCounted
## 多項式 第八大關「符號地下河」題庫（對應講義 4-3 重點二：二次不等式、重點三：特殊不等式）
##
## 旅程（引擎見 step_level.gd；畫面與 graph 步驟見 level_poly8_river.gd）：
##   forge  一步一步推導（choice、fill、order、filter、blocks），再加上 graph 步驟（數線就是地下河）：
##            pick   點亮滿足不等式的河段，點端點切換實心／空心
##                   pts：閘門的位置（由小到大）　labels：閘門下面寫的數　segs：每一段（pts.size() + 1 段）該不該亮
##                   ptsin：每一個閘門該不該取（實心）　forbid：分母的根（一定空心，點不動）
##                   poly：畫出 y = f(x) 的圖（係數由高次到低次）　mult、lead：畫出水流（奇穿偶彈）
##                   layers：上方再畫幾條參考的河（聯立、範圍、變數變換）[{label, pts, segs, ptsin}]
##                   op：不等號（"<"、"<="、">"、">="，給程式驗算用）
##            wave   奇穿偶彈：先決定最右邊從地上（＋）還是地下（−）出發，再從右到左決定每一道閘門「穿過」或「彈回」
##                   pts、labels、mult（每個閘門的次方）、lead（最高次係數的正負，±1）
##            pgate  拖動含參數的閘門（gate = k·a + m），讓指定的數（marks）都落在兩道閘門之間
##          題目帶 "rplot"：整段旅程都畫著那條河（或那張圖）{view, poly, pts, labels, segs, ptsin, dots}
##   speed  速算：gen = "river1"（二次不等式一步讀出解）、"river2"（某個數是不是解，只看正負）
##
## 題目都是自己設計的（不照抄講義），數字用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P3 := preload("res://data/levels/poly/poly3_bank.gd")

const T_Q2 := "poly_ineq2"        # 解二次不等式
const T_NOSOL := "poly_ineqnone"  # 恆正、恆負、無解
const T_PAR := "poly_ineqpar"     # 含參數的二次不等式
const T_REV := "poly_ineqrev"     # 已知解反推係數
const T_SYS := "poly_ineqsys"     # 聯立不等式
const T_SUB := "poly_ineqsub"     # 不等式的變數變換
const T_HIGH := "poly_ineqhigh"   # 高次不等式（奇穿偶彈）
const T_GRAPH := "poly_ineqgraph" # 透過圖形解不等式
const T_FRAC := "poly_ineqfrac"   # 分式不等式
const T_APP := "poly_ineqapp"     # 不等式應用題
const T_SAME := "poly_ineqsame"   # 相同解


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _k(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	var st := SB.choice(name, q, options, correct, why, nudge, line, tag)
	st["keep_order"] = true
	return st


static func _tf(name: String, q: String, right: bool, why: String, nudge: String, line: String, tag: String) -> Dictionary:
	return _k(name, q, ["對", "錯"], 0 if right else 1, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


static func _g(mode: String, name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	var st := {"kind": "graph", "mode": mode, "name": name, "q": q, "line": line, "nudge": nudge, "tag": tag}
	st.merge(data, true)
	return st


## 篩選按鈕只寫數字本身（不寫「t = 」）
static func _bare(st: Dictionary) -> Dictionary:
	st["bare"] = true
	return st


static func _pick(name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	return _g("pick", name, q, data, line, nudge, tag)


static func _wave(name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	return _g("wave", name, q, data, line, nudge, tag)


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


