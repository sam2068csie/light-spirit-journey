extends RefCounted
## 多項式 第六大關「極值燈芯」題庫（對應講義 4-2 重點三：二次函數的極值）
##
## 旅程（引擎見 step_level.gd；畫面與 graph 步驟見 level_poly6_wick.gd，沿用第五關的湖面座標圖）：
##   forge  一步一步推導（choice、fill、blocks），再加上 graph 步驟：
##            wick    燈芯沿著拋物線走：拖到最高（最低）的地方按「點亮」
##                    coef：[a, b, c]　win：[左端, 右端]（null 表示沒有限制）　gap：[g0, g1] 中間不能走（例如沒有實根）
##                    int：只停在整數　goals：[["max" 或 "min", [答案的 x…]]…] 依序完成
##                    xname／fname：變數和函數的名字　show_val：右邊顯示函數值　fig：旁邊的小圖（trap、square、seg）
##                    marks：[[x, 文字]…] 標在 x 軸上（加權的點）
##            window  拖動燈罩 [p, p + w]：依序讓最小值（ext = "max" 時是最大值）發生在 goals 指定的位置（left、vertex、right）（目前沒有題目用）
##            match   沿用第五關：拖動拋物線和虛線重合（平移不改變極值）
##   speed  速算：gen = "wick"（讀極值、一般式的極值、範圍內的最大值，一步）
##
## 題目都是自己設計的（不照抄講義），數字用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P3 := preload("res://data/levels/poly/poly3_bank.gd")

const T_EXT := "poly_extreme"      # 配方求極值
const T_RANGE := "poly_extrange"   # 限制範圍的極值
const T_INT := "poly_extint"       # x 是整數的極值
const T_PAR := "poly_extpar"       # 已知極值求係數
const T_SUB := "poly_extsub"       # 代換求極值（注意新變數的範圍）
const T_TWO := "poly_exttwo"       # 兩個變數：參數式、根與係數
const T_MEAN := "poly_extmean"     # 加權平均數法則
const T_APP := "poly_extapp"       # 極值的應用


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 燈芯：data 寫 coef、win、goals……（見檔頭）
static func _w(name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	var st := {"kind": "graph", "mode": "wick", "name": name, "q": q, "line": line, "nudge": nudge, "tag": tag}
	st.merge(data, true)
	return st


static func _g(mode: String, name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	var st := {"kind": "graph", "mode": mode, "name": name, "q": q, "line": line, "nudge": nudge, "tag": tag}
	st.merge(data, true)
	return st


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


