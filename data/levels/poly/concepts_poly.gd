extends RefCounted
## 多項式單元（P1～P8）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測、kind = "order" 拼流程）。
const UITheme := preload("res://data/ui/game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"P1":
			return [
				{"title": "什麼是多項式", "tag": "定義", "glyph": "axⁿ",
				 "formulas": ["每一項都是 a·x^{n}，n 是 ?{0 或正整數}"],
				 "notes": ["係數 a 可以是任何實數（例如 √{2}、π、分數）", "x 在 ?{分母、根號、指數、絕對值} 裡的都不是",
					"非零常數是 ?{0 次} 多項式；0 是 ?{零} 多項式"],
				 "example": "√{2}x^{3} − πx 是多項式；x + \\frac{1}{x}、√{x}、2^{x} 都不是",
				 "check": {"q": "下面哪一個是多項式？", "opts": ["\\frac{x}{3} + 1", "\\frac{3}{x} + 1", "|x| + 1"], "a": 0,
					"why": "\\frac{x}{3} 的係數是 \\frac{1}{3}，x 的次方是 1。", "hint": "看 x 在哪裡。"}},
				{"title": "次數與領導係數", "tag": "定義", "glyph": "deg",
				 "formulas": ["次數 = 係數不為 0 的 ?{最高次方}", "領導係數 = ?{最高次項的係數}"],
				 "notes": ["要它是 n 次：比 n 高的係數全部 ?{等於 0}，x^{n} 的係數 ?{不等於 0}"],
				 "example": "(a − 2)x^{3} + 5x^{2} + 1 是二次 ⇒ a = 2，領導係數 5",
				 "check": {"q": "(m + 1)x^{2} + 3x − 1 是一次多項式，m = ?", "opts": ["−1", "1", "0"], "a": 0,
					"why": "x^{2} 的係數 m + 1 = 0 ⇒ m = −1。", "hint": "讓 x^{2} 消失。"}},
				{"title": "係數和", "tag": "技巧", "glyph": "f(1)",
				 "formulas": ["各項係數和 = ?{f(1)}", "常數項 = ?{f(0)}"],
				 "notes": ["偶次項和 = ?{\\frac{f(1) + f(−1)}{2}}", "奇次項和 = ?{\\frac{f(1) − f(−1)}{2}}"],
				 "example": "(2x − 1)^{5}：係數和 f(1) = 1，常數項 f(0) = −1",
				 "trap": "f(−1) [b]不是[/b] 係數和！它是偶次項和 − 奇次項和。",
				 "check": {"q": "(x + 2)^{3} 展開後的各項係數和是？", "opts": ["27", "8", "1"], "a": 0,
					"why": "f(1) = 3^{3} = 27。", "hint": "x 代 1。"}},
				{"title": "多項式的恆等", "tag": "定義", "glyph": "n + 1",
				 "formulas": ["n 次多項式 f(x) 有 ?{n + 1} 個 x 值使 f(x) = 0 ⇒ ?{f(x) = 0 恆成立}",
					"兩個 n 次多項式有 ?{n + 1} 個 x 值相等 ⇒ ?{f(x) = g(x) 恆成立}"],
				 "notes": ["這 n + 1 個 x 值要 ?{各不相同}；f(x) = 0 恆成立的 f(x) 叫做 ?{零多項式}",
					"為什麼？n 次多項式最多只有 ?{n} 個根", "f(x) = g(x) 恆成立 ⇒ ?{同次項的係數都相等}",
					"兩個 n 次多項式相等：看 f(x) − g(x)，它有 ?{n + 1} 個根"],
				 "example": "二次式 f(x) 在 x = 1、2、3 都等於 0 ⇒ f(x) = 0 恆成立",
				 "check": {"q": "兩個三次多項式在幾個不同的 x 值相等，就能確定它們恆成立？", "opts": ["4 個", "3 個", "2 個"], "a": 0,
					"why": "f(x) − g(x) 最多三次，有 4 個根就只能是零多項式。", "hint": "n 次要 n + 1 個。"}},
			]
		"P2":
			return [
				{"title": "綜合除法", "tag": "方法", "glyph": "x − k",
				 "formulas": ["除以 x − k：?{k} 寫在右邊"],
				 "notes": ["第一排：係數由高到低，缺項補 ?{+0}", "第二排 = ?{前一格 × k}", "第三排 = ?{上下相加}",
					"圈起來的是 ?{餘式}，前面是 ?{商式的係數}"],
				 "plot": {"shape": "synth", "top": ["+3", "+1", "+0", "−5"], "k": "−2", "mid": ["", "−6", "+10", "−20"],
					"bot": ["+3", "−5", "+10", "−25"], "caption": "3x^{3} + x^{2} − 5 除以 x + 2"},
				 "check": {"q": "x^{3} + 2x − 1 除以 x − 1，算式裡的「?」要寫什麼？", "opts": ["+0", "+2", "−1"], "a": 0,
					"why": "x^{2} 項的係數是 0，要寫 +0 佔住位置。", "hint": "缺項補 0。",
					"plot": {"shape": "synth", "top": ["+1", "?", "+2", "−1"], "k": "+1", "mid": ["", "", "", ""], "bot": ["", "", "", ""],
						"caption": "x^{3} + 2x − 1 除以 x − 1"}}},
				{"title": "除式為 mx + n", "tag": "技巧", "glyph": "mx + n",
				 "formulas": ["先以 ?{−\\frac{n}{m}} 做綜合除法", "商再 ?{除以 m}，餘式 ?{不變}"],
				 "notes": ["左邊寫 ?{+m}，框住第三排的商", "第四排就是真正的 ?{商式係數}"],
				 "plot": {"shape": "synth", "top": ["+4", "−2", "+6", "−1"], "k": "+\\frac{1}{2}", "mid": ["", "+2", "+0", "+3"],
					"bot": ["+4", "+0", "+6", "+2"], "m": "+2", "q4": ["+2", "+0", "+3"], "caption": "4x^{3} − 2x^{2} + 6x − 1 除以 2x − 1"},
				 "check": {"q": "6x^{2} + x + 3 除以 3x − 1，第四排的「?」要寫什麼？", "opts": ["+2　+1", "+18　+9", "+6　+3"], "a": 0,
					"why": "第三排的商 +6、+3 都除以 3；餘式 +4 不變。", "hint": "3x − 1 = 3(x − \\frac{1}{3})。",
					"plot": {"shape": "synth", "top": ["+6", "+1", "+3"], "k": "+\\frac{1}{3}", "mid": ["", "+2", "+1"],
						"bot": ["+6", "+3", "+4"], "m": "+3", "q4": ["?", "?"], "caption": "6x^{2} + x + 3 除以 3x − 1"}}},
				{"title": "除法原理", "tag": "定義", "glyph": "f = gq + r",
				 "formulas": ["f(x) = g(x)·q(x) + r(x)：被除式 = ?{除式 × 商式 + 餘式}", "r(x) = 0，或 r(x) 的次數 ?{小於} g(x) 的次數"],
				 "notes": ["除式是二次式：餘式設成 ?{px + q}", "r(x) = 0 ⇔ g(x) ?{整除} f(x)"],
				 "example": "2x^{3} + ax^{2} − x + b = (x^{2} + x − 1)(cx − 1) + dx + 1：展開後比較係數",
				 "check": {"q": "四次式除以二次式，餘式最多幾次？", "opts": ["1 次", "2 次", "3 次"], "a": 0,
					"why": "餘式的次數一定比除式（2 次）小。", "hint": "看除式的次數。"}},
				{"title": "三步驟求值", "tag": "技巧", "glyph": "√2 − 1",
				 "formulas": ["① x = √{2} − 1 ⇒ ?{x^{2} + 2x − 1 = 0}", "② f(x) 除以 ?{x^{2} + 2x − 1}，得到餘式 r(x)", "③ f(√{2} − 1) = ?{r(√{2} − 1)}"],
				 "notes": ["為什麼？x = √{2} − 1 時除式是 ?{0}，f(x) = (除式)·q(x) + r(x) 只剩下 r(x)"],
				 "check": {"q": "x = √{3} + 1 滿足哪個方程式？", "opts": ["x^{2} − 2x − 2 = 0", "x^{2} + 2x − 2 = 0", "x^{2} − 2x + 2 = 0"], "a": 0,
					"why": "x − 1 = √{3}，平方：x^{2} − 2x + 1 = 3。", "hint": "先移項再平方。"}},
				{"title": "綜合除法的連續使用", "tag": "技巧", "glyph": "(x − k)",
				 "formulas": ["將所得的商 ?{繼續除以 x − k}，可以把 f(x) 化成 ?{x − k 的多項式}"],
				 "notes": ["f(x) = a(x − k)^{3} + b(x − k)^{2} + c(x − k) + d", "第一次圈起來的餘式是 ?{d}，第二次是 ?{c}，第三次是 ?{b}，最後剩下的是 ?{a}",
					"在 x = k 附近，f(x) 的圖形接近直線 y = ?{c(x − k) + d}（f(x) 在 x = k 的一次近似）"],
				 "example": "2x^{3} + x^{2} − 3x + 4 不斷除以 x − 1：圈起來的 +4、+5、+7、+2 ⇒ 2(x − 1)^{3} + 7(x − 1)^{2} + 5(x − 1) + 4",
				 "check": {"q": "不斷除以 x − 2，第一次圈起來的餘式是？", "opts": ["x − 2 的多項式的常數項", "(x − 2)^{3} 的係數", "商式的常數項"], "a": 0,
					"why": "f(x) = (x − 2)·(…) + d，第一次除完的餘式就是 d。", "hint": "最後一項不含 (x − 2)。"}},
			]
		"P3":
			return [
				{"title": "餘式定理", "tag": "定理", "glyph": "f(a)",
				 "formulas": ["f(x) 除以 x − a 的餘式 = ?{f(a)}", "f(x) 除以 ax − b 的餘式 = ?{f(\\frac{b}{a})}"],
				 "notes": ["為什麼？f(x) = (x − a)·q(x) + r，代 x = a：?{(x − a) 變成 0}，只剩 r",
					"反過來：f(a) 很難算時，用 ?{綜合除法} 求餘式"],
				 "example": "x^{3} − 2x^{2} − x + 5 除以 x − 2：餘式 = f(2) = 3",
				 "check": {"q": "f(x) 除以 2x + 1 的餘式是？", "opts": ["f(−\\frac{1}{2})", "f(\\frac{1}{2})", "f(−1)"], "a": 0,
					"why": "2x + 1 = 0 ⇒ x = −\\frac{1}{2}。", "hint": "讓除式等於 0。"}},
				{"title": "因式定理", "tag": "定理", "glyph": "= 0",
				 "formulas": ["x − a 是 f(x) 的因式 ⇔ ?{f(a) = 0}", "ax − b 是 f(x) 的因式 ⇔ ?{f(\\frac{b}{a}) = 0}"],
				 "notes": ["「整除」「是因式」：都是 ?{餘式為 0}"],
				 "example": "x^{3} − 7x + 6：f(1) = 0、f(2) = 0、f(−3) = 0 ⇒ (x − 1)(x − 2)(x + 3)",
				 "check": {"q": "x + 2 是 x^{2} + kx − 6 的因式，k = ?", "opts": ["−1", "1", "5"], "a": 0,
					"why": "f(−2) = 4 − 2k − 6 = 0 ⇒ k = −1。", "hint": "代 x = −2。"}},
				{"title": "除式是二次式", "tag": "技巧", "glyph": "px + q",
				 "formulas": ["除以 (x − a)(x − b)：餘式設 ?{px + q}", "代 a、b：?{pa + q = f(a)}、?{pb + q = f(b)}"],
				 "notes": ["除以三次式：餘式設 ?{ax^{2} + bx + c}，要三個值", "沒有直接給 f(a)：從 ?{別的除法的餘式} 代 a 借過來"],
				 "example": "f(1) = 3、f(−2) = −3 ⇒ f(x) 除以 (x − 1)(x + 2) 的餘式是 2x + 1",
				 "check": {"q": "f(x) 除以 x^{2} − 1 的餘式是 3x + 1，f(−1) = ?", "opts": ["−2", "4", "1"], "a": 0,
					"why": "x = −1 時 x^{2} − 1 = 0，f(−1) = 3(−1) + 1 = −2。", "hint": "除式在 x = −1 時是 0。"}},
				{"title": "階梯假設法（求餘式）", "tag": "技巧", "glyph": "A·g(x)",
				 "formulas": ["除以 g(x) 餘 r(x) ⇒ 除以 (x − a)·g(x) 的餘式設 ?{A·g(x) + r(x)}", "再代 x = ?{a}，求出 A"],
				 "notes": ["為什麼？A·g(x) + r(x) 除以 g(x) 剛好剩 ?{r(x)}", "一階一階往上加：?{A(x − 1)(x − 2) + B(x − 1) + 3}"],
				 "example": "除以 x − 1 餘 4、除以 x^{2} + 1 餘 x + 1 ⇒ 設 A(x^{2} + 1) + x + 1，代 1：2A + 2 = 4",
				 "check": {"q": "除以 x^{2} + 1 餘 x + 2，則除以 (x − 3)(x^{2} + 1) 的餘式設成？", "opts": ["A(x^{2} + 1) + x + 2", "A(x − 3) + x + 2", "Ax^{2} + x + 2"], "a": 0,
					"why": "原來的除式 x^{2} + 1 乘上 A，再加原來的餘式。", "hint": "A × 原來的除式 + 原來的餘式。"}},
				{"title": "餘式定理的推廣", "tag": "技巧", "glyph": "令 = 0",
				 "formulas": ["令除式 = 0，把被除式的 ?{高次項} 換掉", "換到次數 ?{比除式低}，就是餘式"],
				 "notes": ["x^{2} + x + 1 = 0 ⇒ (x − 1)(x^{2} + x + 1) = 0 ⇒ x^{3} = ?{1}", "f(x)·g(x) 的餘式 = ?{兩個餘式相乘} 再除一次"],
				 "example": "x^{100} 除以 x^{2} − 1：x^{2} = 1 ⇒ 餘式 = 1^{50} = 1",
				 "check": {"q": "x^{9} 除以 x^{2} + x + 1 的餘式是？", "opts": ["1", "x", "0"], "a": 0,
					"why": "x^{3} = 1，x^{9} = (x^{3})^{3} = 1。", "hint": "x^{3} 換成 1。"}},
			]
		"P4":
			return [
				{"title": "利用根令式", "tag": "方法", "glyph": "k(x − a)",
				 "formulas": ["f(a) = f(b) = f(c) = 0 的三次式：f(x) = ?{k(x − a)(x − b)(x − c)}", "再代 ?{另一個點}，求出 k"],
				 "notes": ["圖形和 x 軸交在 x = a ⇒ ?{x − a} 是因式", "別忘了前面的 ?{k}：首項係數不一定是 1"],
				 "example": "f(−1) = f(2) = 0、f(0) = 4 的二次式：k(x + 1)(x − 2)，代 0：−2k = 4 ⇒ k = −2",
				 "check": {"q": "二次式 f(x) 的圖形和 x 軸交在 1、5，f(x) 可以設成？", "opts": ["k(x − 1)(x − 5)", "(x + 1)(x + 5)", "k(x + 1)(x + 5)"], "a": 0,
					"why": "f(1) = f(5) = 0 ⇒ x − 1、x − 5 是因式。", "hint": "根 a 對應因式 x − a。"}},
				{"title": "同值令式", "tag": "方法", "glyph": "f − m",
				 "formulas": ["f(a) = f(b) = f(c) = m ⇒ ?{f(x) − m} 有根 a、b、c", "三次式：f(x) = ?{k(x − a)(x − b)(x − c) + m}"],
				 "notes": ["只有兩個同值 f(p) = f(q) = m：三次式設 ?{(x − p)(x − q)(ax + b) + m}"],
				 "example": "f(0) = f(2) = 3 的三次式：x(x − 2)(ax + b) + 3",
				 "check": {"q": "f(1) = f(4) = 7 的二次式，可以設成？", "opts": ["k(x − 1)(x − 4) + 7", "k(x − 1)(x − 4)", "k(x + 1)(x + 4) + 7"], "a": 0,
					"why": "f(x) − 7 有根 1、4。", "hint": "先讓 f(x) − 7 = 0。"}},
				{"title": "牛頓階梯假設法（求多項式）", "tag": "技巧", "glyph": "P、Q、R",
				 "formulas": ["知道 f(a)、f(b)、f(c) 的二次式：f(x) = ?{P(x − a)(x − b) + Q(x − a) + R}", "依序代 ?{a、b、c}，一次求出一個係數"],
				 "notes": ["代 a 得 ?{R}，代 b 得 ?{Q}，代 c 得 ?{P}：不用解聯立"],
				 "example": "f(0) = 1、f(1) = 2、f(2) = 7：設 Px(x − 1) + Qx + R ⇒ R = 1、Q = 1、P = 2",
				 "check": {"q": "f(x) = P(x − 1)(x − 2) + Q(x − 1) + R，代哪個數馬上得到 R？", "opts": ["x = 1", "x = 2", "x = 0"], "a": 0,
					"why": "x = 1 時前兩項都是 0，只剩 R。", "hint": "讓 (x − 1) 變成 0。"}},
				{"title": "利用餘式令式", "tag": "方法", "glyph": "g·q + r",
				 "formulas": ["f(x) 除以 g(x) 餘 r(x) ⇒ f(x) = ?{g(x)·q(x) + r(x)}", "q(x) 的次數 = ?{f 的次數 − g 的次數}"],
				 "notes": ["四次式除以 (x − 1)^{3}：商式設 ?{ax + b}", "兩個除式只差常數：改寫成另一個除式，再 ?{比較餘式}"],
				 "example": "三次式除以 x^{2} + 2 餘 x：f(x) = (x^{2} + 2)(ax + b) + x",
				 "check": {"q": "五次式除以三次式，商式設成？", "opts": ["ax^{2} + bx + c", "ax + b", "ax^{3} + bx^{2} + cx + d"], "a": 0,
					"why": "商式的次數 = 5 − 3 = 2。", "hint": "次數相減。"}},
			]
	return []
