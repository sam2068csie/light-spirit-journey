extends RefCounted
## 多項式 第五大關「拋物鏡湖」題庫（對應講義 4-2 重點二：二次函數的圖形）
##
## 旅程（引擎見 step_level.gd；畫面與 graph 步驟見 level_poly5_lake.gd）：
##   forge  一步一步推導（choice、fill、order、blocks），再加上 graph 步驟（在湖面的座標圖上直接操作）：
##            match  拖頂點、調開口 a，讓拋物線和虛線重合（target：{a, h, k}）
##            gems   開口固定，拖頂點讓拋物線穿過寶石（gems：[[x, y]…]）
##            quad   調 a、拖頂點，讓拋物線只經過指定的象限（quads；possible = false 表示做不到）
##            roots  在湖面上拖兩個根 α、β，讓 a(x − α)(x − β) 變成指定的式子（target：[a, b, c]）
##            slide  轉動 k：拋物線的係數隨 k 改變（fam：[[常數, k 的係數]…]，可再加一條直線 bline：[斜率, 截距]），標記剛好相切的 k（goals）
##            hline  y = |f(x)| 和水平線 y = k：依序調出指定的交點個數（goals）
##          題目可以帶 "lake"：整段旅程都畫在下方的圖（看圖判斷係數、對稱比大小用）
##            {"coef": [a, b, c], "show": "curve" 或 "axis", "marks": [x…]}；步驟的 "hl" 決定這一步要標出什麼
##   speed  速算：gen = "lake"（讀頂點、對稱軸、y 截距，一步）
##
## 題目都是自己設計的（不照抄講義），數字用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P3 := preload("res://data/levels/poly/poly3_bank.gd")

const T_VTX := "poly_vertex"       # 標準式、配方、頂點與對稱軸
const T_MOVE := "poly_translate"   # 平移
const T_SIGN := "poly_coefsign"    # 看圖判斷 a、b、c、判別式
const T_QUAD := "poly_quadrant"    # 通過的象限
const T_SYM := "poly_symmetry"     # 對稱與比大小
const T_VIETA := "poly_vieta"      # 根與係數
const T_DISC := "poly_disc"        # 判別式：恆正、恆負、在直線上方或下方
const T_FORM := "poly_quadform"    # 條件求二次函數
const T_ABS := "poly_absgraph"     # y = |f(x)| 與交點個數

const SIGNS := ["正（> 0）", "負（< 0）", "0"]


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 正負判斷（選項固定：正、負、0）
static func _sg(name: String, q: String, correct: int, why: String, nudge: String, line: String, hl: String) -> Dictionary:
	var st := SB.choice(name, q, SIGNS.duplicate(), correct, why, nudge, line, T_SIGN)
	st["keep_order"] = true
	st["hl"] = hl
	return st


static func _g(mode: String, name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	var st := {"kind": "graph", "mode": mode, "name": name, "q": q, "line": line, "nudge": nudge, "tag": tag}
	st.merge(data, true)
	return st


const A_LIST := ["-2", "-1", "-1/2", "1/2", "1", "2"]


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


