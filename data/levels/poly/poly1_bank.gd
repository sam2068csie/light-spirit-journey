extends RefCounted
## 多項式 第一大關「係數礦燈」題庫（對應講義 4-1 重點一：多項式與係數問題）
##
## 旅程（引擎見 step_level.gd，這一關的畫面與新步驟見 level_poly1_lamp.gd）：
##   forge  一步一步推導。除了 choice、fill、filter，這一關多一種步驟：
##            lamp  礦燈：選 x 要代多少（礦燈照在 x = ? 的地方），下方的係數水晶會跟著變：
##                  x = 1 全部是「+」、x = −1 奇次項變成「−」、x = 0 只剩常數項
##                  deg 是多項式的次數（水晶的個數 = deg + 1），target 是該代的 x，opts 是可以選的 x
##   speed  速算：gen = "sum"（(ax + b)^{n} 的係數和或常數項）
##
## 觀念標籤都用 poly_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。
## 題目的數字都用程式驗算過（係數和、奇偶次項和、恆等式的待定係數）。

const SB := preload("res://data/levels/engine/step_bank.gd")

const T_DEF := "poly_def"          # 判斷是不是多項式
const T_DEG := "poly_deg"          # 次數與領導係數
const T_SUM := "poly_sum"          # 係數和（代 1、−1、0）
const T_IDENT := "poly_ident"      # 恆等（比較係數、代特殊值）
const T_OP := "poly_degop"         # 運算後的次數


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 礦燈：x 要代多少（target），deg 是次數
static func _lamp(q: String, deg: int, target: int, line: String, nudge: String, opts := [-1, 0, 1]) -> Dictionary:
	return {"kind": "lamp", "name": "點礦燈", "q": q, "deg": deg, "target": target, "opts": opts,
		"line": line, "nudge": nudge, "tag": T_SUM}


## 篩選「是不是多項式」：式子寫在左邊的題目裡（(A)～(F)），按鈕上只寫代號（bare）
const ABC := ["(A)", "(B)", "(C)", "(D)", "(E)", "(F)"]
const EQ_ABC := ["（Ａ）", "（Ｂ）", "（Ｃ）", "（Ｄ）", "（Ｅ）", "（Ｆ）"]      # 全形字母：排版時不會變成斜體的變數

static func _is_poly(n: int, keep: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "filter", "name": "篩選", "q": "哪些是 x 的多項式？是的留下，不是的丟掉。", "cands": ABC.slice(0, n), "keep": keep,
		"bare": true, "keep_word": "✓ 是", "drop_word": "✗ 不是", "tip": "點一下可以切換「是」或「不是」。",
		"line": line, "nudge": nudge, "tag": T_DEF}


## 左邊的題目：六個式子，兩個一行
static func _list(exprs: Array) -> String:
	var rows := ["下面哪些是 x 的多項式？"]
	for k in range(0, exprs.size(), 2):
		rows.append("%s %s　　%s %s" % [EQ_ABC[k], exprs[k], EQ_ABC[k + 1], exprs[k + 1]])
	return "\n".join(rows)


const ASK_SUM := "要求各項係數和，礦燈要照在 x = 多少的地方？"
const ASK_CONST := "要求常數項，礦燈要照在 x = 多少的地方？"
const ASK_ALT := "要讓奇次項變號，礦燈要照在 x = 多少的地方？"
const NUDGE_SUM := "x = 1 時，每一項的 x^{k} 都是 1，剩下的就是係數相加。"
const NUDGE_CONST := "x = 0 時，有 x 的項全部變成 0，只剩常數項。"
const NUDGE_ALT := "x = −1 時，(−1)^{k}：偶次是 +1、奇次是 −1。"


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true          # 舞台只畫背景，內容由推導台負責
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


