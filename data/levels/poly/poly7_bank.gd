extends RefCounted
## 多項式 第七大關「對稱水晶」題庫（對應講義 4-3 重點一：多項式函數的圖形，三次函數）
##
## 旅程（引擎見 step_level.gd；畫面與 graph 步驟見 level_poly7_crystal.gd）：
##   forge  一步一步推導（choice、fill、blocks），再加上 graph 步驟（座標圖上直接操作）：
##            cmatch  拖動水晶（對稱中心 (h, k)），調 a、p，讓 y = a(x − h)^{3} + p(x − h) + k 和虛線重合
##                    target {a, p, h, k}；lock：中心固定；sign_only：只要 a、p 的正負對就好（不畫虛線）
##            mirror  曲線 coef [a, b, c, d] 上有一點 A（pa），把 B 拖到 A 繞水晶轉半圈的位置（target [x, y]）
##            far     一直拉遠（zoom），看曲線越來越像 y = ax^{3}
##            tangent 拉近 x = h 附近，轉動通過 (h, f(h)) 的直線，貼住曲線（target m）
##            chline  上下拖水平線 y = k，依序調出指定的交點個數（goals；ks 指定 k）
##          題目帶 "plots"：整段旅程都畫在下方的圖（看圖判斷用）{view, curves: [{c, label, lx}], pts: [[x, y, 文字]], crystal: [h, k]}
##   speed  速算：gen = "crystal"（對稱中心、對稱點，一步）、"farnear"（一次近似、廣域正負，一步）
##
## 題目都是自己設計的（不照抄講義），數字用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P3 := preload("res://data/levels/poly/poly3_bank.gd")

const T_MONO := "poly_cubemono"     # 單項函數與平移
const T_SHAPE := "poly_cubeshape"   # y = ax^3 + px 的四種圖形
const T_CENTER := "poly_cubecenter" # 配方求對稱中心
const T_SYM := "poly_cubesym"       # 對稱中心的性質
const T_SIGN := "poly_cubesign"     # 看圖判斷係數
const T_FAR := "poly_cubefar"       # 廣域特徵
const T_NEAR := "poly_cubenear"     # 局部特徵、一次近似
const T_FORM := "poly_cubeform"     # 條件求三次函數
const T_LINE := "poly_cubeline"     # 和水平線的交點

const A_LIST := ["-2", "-1", "-1/2", "1/2", "1", "2"]
const P_LIST := ["-2", "-1", "0", "1", "2"]


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


## 選項固定順序（正／負、對／錯）
static func _k(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	var st := SB.choice(name, q, options, correct, why, nudge, line, tag)
	st["keep_order"] = true
	return st


static func _tf(name: String, q: String, right: bool, why: String, nudge: String, line: String, tag: String) -> Dictionary:
	return _k(name, q, ["對", "錯"], 0 if right else 1, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 有小數點鍵的填空
static func _fd(name: String, q: String, template: String, answers: Array, line: String, nudge: String, tag: String) -> Dictionary:
	var st := SB.fill(name, q, template, answers, line, nudge, tag, "ordered")
	st["dot"] = true
	return st


static func _g(mode: String, name: String, q: String, data: Dictionary, line: String, nudge: String, tag: String) -> Dictionary:
	var st := {"kind": "graph", "mode": mode, "name": name, "q": q, "line": line, "nudge": nudge, "tag": tag}
	st.merge(data, true)
	return st


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


