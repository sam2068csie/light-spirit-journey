extends RefCounted
## 多項式 第三大關「回音石廊」題庫（對應講義 4-1 重點三：餘式定理）
##
## 旅程（引擎見 step_level.gd，這一關的畫面見 level_poly3_echo.gd）：
##   forge  一步一步推導，用 choice、fill、filter，再加上：
##            probe  回音石：下方有一條數線，學生拖動喊話點（或右邊的滑桿），石壁即時顯示回音 f(x)，算術由遊戲來做
##                     mode = "find"：喊對除式要的那個數（target）
##                     mode = "roots"：找出所有沒有回音（f(x) = 0）的地方，一個一個標記（roots）
##                     mode = "tune"：x 固定在 x0，轉動 k，讓回音變成 goal（例如 0：整除）
##                   fx：被除式（_dense 把係數轉成「積的和」，大次方、乘積的式子可以直接寫）
##                   fk：tune 用的係數 [[常數, k 的係數]…]（由高次到低次）；den：一格是 1/den
##            shout  對深谷喊話：選要代的 x（選擇題），答對時聲波飛出去
##            echo   填空答對時，回音帶著 f(a) 的值彈回來；f(a) = 0 時谷底一片安靜（因式）
##          綜合除法（P2 題庫的 _synth）、長除法（P2 題庫的 _long）也可以直接用
##   speed  速算：gen = "shout"（看除式喊出要代的數、x = ±1 的餘式），一步就能算完
##
## 觀念標籤都用 poly_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。
## 題目的數字都用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P2 := preload("res://data/levels/poly/poly2_bank.gd")

const T_REM := "poly_remthm"       # 餘式定理：除以 x − a 的餘式是 f(a)
const T_FAC := "poly_factor"       # 因式定理：x − a 是因式 ⇔ f(a) = 0
const T_HIGH := "poly_remhigh"     # 除以二次式（三次式）：餘式設 px + q，代根
const T_MUL := "poly_remmul"       # 餘式的運算（相乘）
const T_POW := "poly_rempow"       # 大次方的餘式
const T_NEWT := "poly_newton"      # 牛頓階梯假設法（求多項式；題目先放在 poly4_bank.gd，給下一關用）
const T_LAD := "poly_ladder"       # 階梯假設法（求餘式）


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 對深谷喊話：要代哪個 x
##   畫面上是選擇題（opts 的第一個是正解，會自動打亂）；答對時聲波從推導台飛向深谷（level_poly3_echo.gd）
static func _shout(q: String, target: String, opts: Array, line: String, nudge: String, tag := T_REM) -> Dictionary:
	var st := SB.choice("喊話", q, opts.map(func(o): return "x = " + String(o)), opts.find(target), "喊 x = %s！" % target, nudge, line, tag)
	st["shout"] = target
	return st


## 填出回音（f(a) 的值）：答對時回音彈回來；val 是 0 就是安靜的回音
static func _echo(st: Dictionary, x: String, val: String) -> Dictionary:
	var s := st.duplicate()
	s["echo"] = {"x": x, "val": val}
	return s


## 係數（由高次到低次）→ fx 的寫法：[[ [[係數, 次方]…] ]]（一個積、一個因式）
static func _dense(coef: Array) -> Array:
	var f := []
	var n := coef.size() - 1
	for i in coef.size():
		if int(coef[i]) != 0:
			f.append([int(coef[i]), n - i])
	return [[f]]


## 回音石：喊對除式要的數（拖動數線上的喊話點）
static func _pf(div: String, target: String, fx: Array, line: String, nudge: String, den := 1, lo := -4, hi := 4) -> Dictionary:
	return {"kind": "probe", "mode": "find", "name": "除以 " + div, "q": "要代入讓 %s = 0 的數，回音才是除以 %s 的餘式。把喊話點拖到那個數，按「喊！」。" % [div, div],
		"div": div, "target": target, "fx": fx, "den": den, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_REM}


## 回音石：找出所有安靜的地方（f(x) = 0）
static func _pr(roots: Array, fx: Array, line: String, nudge: String, den := 1, lo := -4, hi := 4, q := "") -> Dictionary:
	if q == "":
		q = "安靜（回音 f(a) = 0）⇔ 除以 x − a 的餘式是 0 ⇔ x − a 是因式。找出所有安靜的地方，每找到一個按「標記這裡」。"
	return {"kind": "probe", "mode": "roots", "name": "找安靜的地方", "q": q,
		"roots": roots, "fx": fx, "den": den, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_FAC}


## 調音石：x 固定在 x0，轉動 k 讓回音變成 goal
static func _pt(x0: String, fk: Array, goal: String, line: String, nudge: String, lo := -6, hi := 6) -> Dictionary:
	var want := "安靜（0）" if goal == "0" else goal
	return {"kind": "probe", "mode": "tune", "name": "調音", "q": "在 x = %s 喊，回音 f(%s) 就是餘式。轉動 k，讓回音變成 %s。" % [x0, x0, want],
		"x0": x0, "fk": fk, "goal": goal, "den": 1, "range": [lo, hi], "line": line, "nudge": nudge, "tag": T_FAC}


## 拼積木：用積木拼出假設的式子（畫面見 level_poly3_echo.gd 的 _build_blocks）
##   terms：正確的假設，每一項是一組積木（項裡的順序、項的順序都不限）；extra：干擾的積木
##   alts：也算得出來、但和接下來的步驟不同的拼法（拼到時只提醒，不扣能量），alt_msg 是提醒的話
static func _blocks(q: String, lead: String, terms: Array, extra: Array, line: String, why: String, nudge: String, tag: String,
		alts := [], alt_msg := "") -> Dictionary:
	var toks := []
	for tm in terms:
		for t in tm:
			if not toks.has(t):
				toks.append(t)
	for t in extra:
		if not toks.has(t) and t != "+":
			toks.append(t)
	toks.sort()
	if terms.size() > 1 or extra.has("+"):
		toks.append("+")
	return {"kind": "blocks", "name": "拼出假設", "q": q, "lead": lead, "terms": terms, "blocks": toks, "alts": alts, "alt_msg": alt_msg,
		"line": line, "why": why, "nudge": nudge, "tag": tag}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


