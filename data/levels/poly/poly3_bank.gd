extends RefCounted
## 多項式 第三大關「回音石廊」題庫（對應講義 4-1 重點三：餘式定理）
##
## 旅程（引擎見 step_level.gd，這一關的畫面見 level_poly3_echo.gd）：
##   forge  一步一步推導，用 choice、fill、filter，再加上：
##            shout  對深谷喊話：選要代的 x（opts 是按鈕，target 是正解）。喊對之後聲波飛出去，
##                   接著的填空（有 "echo" 欄位）答對時，回音帶著 f(a) 的值彈回來；f(a) = 0 時谷底一片安靜（因式）
##          綜合除法（P2 題庫的 _synth）、長除法（P2 題庫的 _long）也可以直接用
##            {"pts": [[a, f(a), 第幾步之後出現]…], "curve": [二次項, 一次項, 常數], "after": 第幾步之後畫曲線}
##   speed  速算：gen = "rem"（f(x) 除以 x − a 的餘式）
##
## 觀念標籤都用 poly_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。
## 題目的數字都用程式驗算過。

const SB := preload("res://data/levels/engine/step_bank.gd")
const P2 := preload("res://data/levels/poly/poly2_bank.gd")

const T_REM := "poly_remthm"       # 餘式定理：除以 x − a 的餘式是 f(a)
const T_FAC := "poly_factor"       # 因式定理：x − a 是因式 ⇔ f(a) = 0
const T_HIGH := "poly_remhigh"     # 除以二次式（三次式）：餘式設 px + q，代根
const T_MUL := "poly_remmul"       # 餘式的運算（相乘）
const T_POW := "poly_rempow"       # 大次方的餘式
const T_NEWT := "poly_newton"      # 牛頓階梯假設法（求多項式；題目先放在 poly4_bank.gd，給下一關用）
const T_LAD := "poly_ladder"       # 階梯假設法（求餘式）


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 對深谷喊話：要代哪個 x
##   畫面上是選擇題（opts 的第一個是正解，會自動打亂）；答對時聲波從推導台飛向深谷（level_poly3_echo.gd）
static func _shout(q: String, target: String, opts: Array, line: String, nudge: String, tag := T_REM) -> Dictionary:
	var st := SB.choice("喊話", q, opts.map(func(o): return "x = " + String(o)), opts.find(target), "喊 x = %s！" % target, nudge, line, tag)
	st["shout"] = target
	return st


## 填出回音（f(a) 的值）：答對時回音彈回來；val 是 0 就是安靜的回音
static func _echo(st: Dictionary, x: String, val: String) -> Dictionary:
	var s := st.duplicate()
	s["echo"] = {"x": x, "val": val}
	return s


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


