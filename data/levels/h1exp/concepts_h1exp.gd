extends RefCounted
## 高一「指數與常用對數」單元（E1～E3）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測、kind = "order" 拼流程）。
const UITheme := preload("res://data/ui/game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"E1":
			return [
				{"title": "指數律", "decoys": ["r − s", "不等於 0"], "tag": "定理", "glyph": "a^{r}",
				 "formulas": ["a^{r} × a^{s} = a^{?{r + s}}、(a^{r})^{s} = a^{?{rs}}", "a^{r}b^{r} = (ab)^{r}，底數要 ?{大於 0}"],
				 "notes": ["√ 是 \\frac{1}{2} 次方、∛ 是 \\frac{1}{3} 次方", "全部化成質數的次方，同一個質數的指數相加"],
				 "example": "9^{−\\frac{2}{3}} × ∛{243} = 3^{−\\frac{4}{3}} × 3^{\\frac{5}{3}} = 3^{\\frac{1}{3}}",
				 "trap": "[(−2)^{2}]^{\\frac{1}{2}} = 2，[b]不是[/b] (−2)^{1}：底數是負的不能用 (a^{m})^{n} = a^{mn}！",
				 "check": {"q": "8^{\\frac{2}{3}} × 4^{−\\frac{1}{2}} = ？", "opts": ["2", "8", "\\frac{1}{2}"], "a": 0,
					"why": "2^{2} × 2^{−1} = 2。", "hint": "都化成 2 的次方。"}},
				{"title": "有意義嗎", "decoys": ["正數", "整數"], "tag": "定義", "glyph": "0^{0}",
				 "formulas": ["0^{0} 和 0 的 ?{負數} 次方沒有意義", "負數的 ?{無理數} 次方沒有意義"],
				 "notes": ["底數不是 0：整數次方都有意義", "正數的任何實數次方都有意義"],
				 "example": "(−\\frac{1}{3})^{−2} = 9 有意義、(−5)^{√2} 沒有意義",
				 "check": {"q": "哪一個沒有意義？", "opts": ["0^{−2}", "(−2)^{0}", "0^{2}"], "a": 0,
					"why": "0^{−2} = \\frac{1}{0^{2}}，要除以 0。", "hint": "負次方是倒數。"}},
				{"title": "回音階梯", "decoys": ["1", "3t^{2}"], "tag": "技巧", "glyph": "a+a⁻¹",
				 "formulas": ["(a^{\\frac{1}{2}} + a^{−\\frac{1}{2}})^{2} = a + a^{−1} + ?{2}",
					"t = a^{\\frac{1}{2}} + a^{−\\frac{1}{2}}：a^{\\frac{3}{2}} + a^{−\\frac{3}{2}} = t^{3} − ?{3t}"],
				 "notes": ["a^{x} · a^{−x} = 1，平方、立方的中間項都是常數", "往下開根號：和一定是正的，差要看 a 比 1 大還小"],
				 "example": "a + a^{−1} = 14 ⇒ a^{\\frac{1}{2}} + a^{−\\frac{1}{2}} = 4、a^{\\frac{1}{2}} − a^{−\\frac{1}{2}} = ±2√3",
				 "check": {"q": "a + a^{−1} = 7，a^{2} + a^{−2} = ？", "opts": ["47", "49", "51"], "a": 0,
					"why": "7^{2} − 2 = 47。", "hint": "平方會多出 2。"}},
				{"title": "倍增與減半", "decoys": ["\\frac{n}{t}", "kt"], "tag": "模型", "glyph": "2^{t}",
				 "formulas": ["每 n 天變 k 倍：t 天後變 k^{?{\\frac{t}{n}}} 倍", "半衰期 T：t 年後剩 (\\frac{1}{2})^{?{\\frac{t}{T}}}"],
				 "notes": ["增加 a 倍 = 變成 (1 + a) 倍", "兩筆資料相除，開始的量消掉"],
				 "example": "0.1 mm 的紙對折 42 次：0.1 × 2^{42} mm，超過月球",
				 "check": {"q": "每 3 天變 2 倍，12 天後變幾倍？", "opts": ["16", "8", "24"], "a": 0,
					"why": "結算 4 次：2^{4} = 16。", "hint": "12 天結算幾次？"}},
				{"title": "指數比大小", "decoys": ["係數"], "tag": "方法", "glyph": ">",
				 "formulas": ["同底數（底數 > 1）比 ?{指數}", "同指數比 ?{底數}：比不了就化成同一個次方"],
				 "notes": ["2^{\\frac{1}{2}}、3^{\\frac{1}{3}}：都 6 次方，比 2^{3} 和 3^{2}", "4^{\\frac{1}{4}} = 2^{\\frac{1}{2}}，一樣大"],
				 "example": "每 2 天 2 倍、每 3 天 3 倍：12 天後 2^{6} = 64、3^{4} = 81，後者快",
				 "check": {"q": "2^{\\frac{1}{2}} 和 3^{\\frac{1}{3}} 誰大？", "opts": ["3^{\\frac{1}{3}}", "2^{\\frac{1}{2}}", "一樣大"], "a": 0,
					"why": "6 次方：2^{3} = 8 < 3^{2} = 9。", "hint": "都 6 次方。"}},
			]
		"E2":
			return [
				{"title": "對數的意義", "decoys": ["10a", "log a"], "tag": "定義", "glyph": "log",
				 "formulas": ["10^{y} = x ⇔ y = log x（x > 0）", "log x 就是 x 站在第幾階、10^{log a} = ?{a}"],
				 "notes": ["log 1 = 0、log 10 = 1、log 0.01 = −2", "負數和 0 沒有 log"],
				 "example": "(√10)^{log 16} = 10^{\\frac{1}{2}log 16} = 16^{\\frac{1}{2}} = 4",
				 "trap": "10^{n log 2} = 2^{n}，[b]不是[/b] 2n！",
				 "check": {"q": "100^{log 3} = ？", "opts": ["9", "6", "300"], "a": 0,
					"why": "(10^{log 3})^{2} = 3^{2} = 9。", "hint": "100 = 10^{2}。"}},
				{"title": "對數律", "decoys": ["×", "\\frac{a}{b}"], "tag": "定理", "glyph": "+",
				 "formulas": ["log ab = log a ?{+} log b", "log \\frac{a}{b} = log a ?{−} log b、log a^{r} = ?{r}log a"],
				 "notes": ["計算尺：長度相加就是相乘", "log(a + b) 不能拆開"],
				 "example": "2log 3 + 3log 2 − \\frac{1}{2}log 36 = log \\frac{9 × 8}{6} = log 12",
				 "check": {"q": "log 4 + log 25 = ？", "opts": ["2", "log 29", "100"], "a": 0,
					"why": "log 100 = 2。", "hint": "相加就是相乘。"}},
				{"title": "首數平移", "decoys": ["乘 n", "加 10^{n}"], "tag": "技巧", "glyph": "×10",
				 "formulas": ["x 乘 10^{n}：log x 就 ?{加 n}"],
				 "notes": ["數字一樣、小數點不一樣，log 只差整數", "log 差 k：真數差 10^{k} 倍"],
				 "example": "log 169 = k ⇒ log 0.0169 = log(169 × 10^{−4}) = k − 4",
				 "check": {"q": "log x = 2.71，log 1000x = ？", "opts": ["5.71", "2713", "8.13"], "a": 0,
					"why": "2.71 + 3 = 5.71。", "hint": "log 1000 = 3。"}},
				{"title": "對數的範圍", "decoys": ["n + 1", "10n"], "tag": "方法", "glyph": "[n]",
				 "formulas": ["10^{n} ≤ x < 10^{n + 1} ⇔ ?{n} ≤ log x < n + 1"],
				 "notes": ["整數部分：站在哪兩階之間，取下面那一階", "很小的數：0.0387 在 0.01 和 0.1 之間"],
				 "example": "1000 < 3870 < 10000 ⇒ 3 < log 3870 < 4",
				 "check": {"q": "log 0.0035 在哪兩個整數之間？", "opts": ["−3 和 −2", "−4 和 −3", "−2 和 −1"], "a": 0,
					"why": "0.001 < 0.0035 < 0.01。", "hint": "0.001 = 10^{−3}。"}},
				{"title": "分貝與地震", "decoys": ["2", "1"], "tag": "模型", "glyph": "dB",
				 "formulas": ["d = 10log \\frac{I}{I_{0}}：分貝加 10，強度變 ?{10} 倍", "log E = 1.5r + 11.8：規模加 1，能量變 10^{?{1.5}} 倍"],
				 "notes": ["log 加 k：真數乘 10^{k}", "20 分貝不是 10 分貝的 2 倍"],
				 "example": "30 分貝 → 80 分貝：強度是 10^{5} 倍",
				 "check": {"q": "40 分貝 → 70 分貝，強度變幾倍？", "opts": ["1000", "30", "3"], "a": 0,
					"why": "差 30 分貝：10^{3}。", "hint": "每 10 分貝乘 10。"}},
			]
		"E3":
			return [
				{"title": "科學記號", "decoys": ["100", "−n"], "tag": "定義", "glyph": "×10",
				 "formulas": ["a × 10^{n}，1 ≤ a < ?{10}", "小數點往左移 n 位：× 10^{?{n}}"],
				 "notes": ["很小的數：小數點往右移，次方是負的", "相乘除：係數相乘除、次方相加減"],
				 "example": "23412976 ≈ 2.34 × 10^{7}、0.0000075 = 7.5 × 10^{−6}",
				 "check": {"q": "0.00042 寫成科學記號？", "opts": ["4.2 × 10^{−4}", "4.2 × 10^{−3}", "42 × 10^{−5}"], "a": 0,
					"why": "小數點往右移 4 位。", "hint": "停在 4 的後面。"}},
				{"title": "有效數字", "decoys": ["不算", "第一位"], "tag": "規則", "glyph": "2.50",
				 "formulas": ["中間和最後的 0 ?{也算}", "加減看 ?{最後一位}、乘除看 ?{個數}"],
				 "notes": ["2.50 × 10^{9} 有 3 位有效數字", "答案不會比量得最不準的數更準"],
				 "example": "(3 × 10^{4}) × (5.6 × 10^{3}) = 1.68 × 10^{8} ≈ 2 × 10^{8}",
				 "check": {"q": "4.06 × 10^{17} 有幾位有效數字？", "opts": ["3", "2", "17"], "a": 0,
					"why": "4、0、6：中間的 0 也算。", "hint": "只看係數。"}},
				{"title": "幾位數", "decoys": ["n", "n − 1"], "tag": "方法", "glyph": "#",
				 "formulas": ["log x = n + 尾數（0 ≤ 尾數 < 1）", "⇒ x 是 ?{n + 1} 位數"],
				 "notes": ["x = 10^{尾數} × 10^{n}", "n 位數 ⇔ n − 1 ≤ log x < n"],
				 "example": "log 2^{100} = 30.1 ⇒ 2^{100} 是 31 位數",
				 "trap": "log 2^{100} = 30.1，[b]不是[/b] 30 位數！",
				 "check": {"q": "log x = 12.3，x 有幾位數？", "opts": ["13", "12", "14"], "a": 0,
					"why": "整數部分是 12：13 位數。", "hint": "10^{12} 是幾位數？"}},
				{"title": "小數點後第幾位", "decoys": ["n + 1"], "tag": "方法", "glyph": "0.0…",
				 "formulas": ["log x = −n + 尾數", "⇒ 小數點後第 ?{n} 位開始不是 0"],
				 "notes": ["負的 log 要先寫成負整數 + 正的尾數", "−8.876 = −9 + 0.124"],
				 "example": "(\\frac{3}{5})^{40} = 10^{−8.876} = 10^{0.124} × 10^{−9}：第 9 位",
				 "check": {"q": "log x = −4.2，第幾位開始不是 0？", "opts": ["5", "4", "6"], "a": 0,
					"why": "−4.2 = −5 + 0.8。", "hint": "尾數要是正的。"}},
				{"title": "最高位數字", "decoys": ["d + 1"], "tag": "方法", "glyph": "d",
				 "formulas": ["尾數在 log d 和 log (d + 1) 之間", "⇒ 最高位是 ?{d}"],
				 "notes": ["log 2 ≈ 0.301、log 3 ≈ 0.477、log 5 ≈ 0.699、log 7 ≈ 0.845", "相加：最高位加起來到 10 就進位"],
				 "example": "log 3^{60} = 28.626：log 4 < 0.626 < log 5 ⇒ 最高位 4",
				 "check": {"q": "log x = 5.72，最高位數字？", "opts": ["5", "6", "4"], "a": 0,
					"why": "log 5 ≈ 0.699 < 0.72 < log 6 ≈ 0.778。", "hint": "看尾數 0.72。"}},
			]
	return []
