extends RefCounted
## 高一「指數與常用對數」第三大關「深谷測繩」題庫（對應講義重點三：科學記號與位數問題，另收重點一的 H22）
## 設計稿：docs/exp_e3_design.md。題目的數字都用程式驗算過（tools/exp/verify_e3.py：位數、最高位數字用真的整數確認）。
## 同題型的講義題合成一題（每一題的 variants 是不同的講義題，每次隨機抽一種）。
##
## 旅程（引擎見 data/levels/num/num_level.gd）：
##   forge  一步一步推導：slide（數字條 digits 拖小數點、測繩 rope 先猜／拖 n、地震計 meter）、
##          ltap（尾數尺：E2 的對數尺 logticks，點尾數落在哪兩格之間）、lrange（拉出 n 的範圍）、
##          choice、fill（"dot" 小數鍵盤、"approx" 近似值）
##   speed  速算：gen = "digits"（幾位數、小數點後第幾位，按鈕）、"lead"（最高位數字，按鈕）
## 使用者 2026/11/18：光速直接寫 3.0 × 10^{8}（不講「0 要留著」）；有效數字減成 2 小題；3^{41} + 2^{66} 可以。

const SB := preload("res://data/levels/engine/step_bank.gd")
const B1 := preload("res://data/levels/num/num1_bank.gd")

const T_SCI := "elog_sci"        # 科學記號、有效數字
const T_DIG := "elog_digits"     # 幾位數、小數點後第幾位
const T_LEAD := "elog_lead"      # 最高位數字（尾數尺）
const T_INV := "elog_inv"        # 由位數反推、反求 n
const T_NAPP := "elog_napp"      # 位數的應用（比大小、相加、位元、地震）

## 尾數尺上的格線：題目給的近似值（log 2 ≈ 0.3010、log 3 ≈ 0.4771、log 7 ≈ 0.8451 推出來的）
const LOGV := {1: "0", 2: "0.301", 3: "0.477", 4: "0.602", 5: "0.699", 6: "0.778", 7: "0.845", 8: "0.903", 9: "0.954", 10: "1"}


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


static func _j(name: String, statement: String, ok: bool, why: String, line: String, tag: String) -> Dictionary:
	return B1._j(name, statement, ok, why, line, tag)


## 填空可以打小數（鍵盤多一個「.」）；tol > 0 是近似值
static func _dot(st: Dictionary, tol := 0.0) -> Dictionary:
	st["dot"] = true
	if tol > 0.0:
		st["mode"] = "approx"
		st["tol"] = tol
	return st


static func _lg(x: float) -> float:
	return log(x) / log(10.0)


## 尾數尺上的一根指針（m 是尾數）
static func _ptr(m: float, s: String, at: int, c := "gold") -> Dictionary:
	return {"v": m, "s": s, "at": at, "lit": at, "c": c}


## 尾數尺：點尾數 m 落在哪兩格之間（答案是 log d 和 log (d + 1) 之間）
static func _ruler(m: float, d: int, line: String, item := 1) -> Dictionary:
	var ms := ("%.3f" % m).rstrip("0").rstrip(".")
	var wrongs := []
	if d > 1:
		wrongs.append([_lg(d - 1), _lg(d), "%s 比 log %d ≈ %s 大。" % [ms, d, LOGV[d]]])
	if d < 9:
		wrongs.append([_lg(d + 1), _lg(d + 2), "%s 比 log %d ≈ %s 小。" % [ms, d + 1, LOGV[d + 1]]])
	var miss := (_lg(d + 1) + _lg(d + 2)) / 2.0 if d < 9 else (_lg(d - 1) + _lg(d)) / 2.0
	return {"kind": "ltap", "name": "尾數尺", "tag": T_LEAD, "q": "%s 落在哪兩格之間？" % ms, "item": item, "snap": 0.002,
		"a": 0, "b": 0, "regions": [[_lg(d), _lg(d + 1)]], "wrongs": wrongs, "wrong": "",
		"hits": [(_lg(d) + _lg(d + 1)) / 2.0], "miss": miss,
		"nudge": "log %d ≈ %s、log %d ≈ %s。" % [d, LOGV[d], d + 1, LOGV[d + 1]], "line": line}


## 滑桿
static func _slide(name: String, q: String, n: String, lo: float, hi: float, stp: float, start: float, goal: float,
		eq: String, line: String, nudge: String, tag: String, traps := []) -> Dictionary:
	return {"kind": "slide", "name": name, "q": q, "params": [{"n": n, "min": lo, "max": hi, "step": stp, "v": start}],
		"lines": [], "eq": eq, "goal": {n: goal}, "traps": traps, "line": line, "nudge": nudge, "tag": tag, "dec": stp < 1.0}


## 先猜：拖測繩（不扣能量，line 裡的 {g} 換成猜的值）
static func _guess(q: String, start: float, tag: String) -> Dictionary:
	return {"kind": "slide", "name": "先猜", "q": q, "params": [{"n": "g", "min": 1, "max": 60, "step": 1, "v": start}],
		"lines": [], "eq": "猜 {g} 位", "free": true, "line": "先猜：{g} 位數", "line_vals": true, "nudge": "", "tag": tag}


## 尾數尺元件（E2 的對數尺）
static func _scale(pts: Array, w := 1.3) -> Dictionary:
	return {"k": "nline", "x": [0, 1], "logticks": true, "pts": pts, "w": w}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
	return out


