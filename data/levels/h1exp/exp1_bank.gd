extends RefCounted
## 高一「指數與常用對數」第一大關「倍增岩壁」題庫（對應講義重點一：指數律）
## 設計稿：docs/exp_e1_design.md。題目的數字都用程式驗算過（tools/exp/verify_e1.py）。
## 同題型的講義題合成一題（每一題的 variants 是不同的講義題，每次隨機抽一種）。
##
## 旅程（引擎見 data/levels/num/num_level.gd）：
##   forge  一步一步推導：pdrag（光柱積木：卡片拖到質數柱上）、stack（湊積木）、etap（點等號寶石）、
##          gtap（回音階梯點要踩的階）、lsort（a、a^{−1} 放進籃子）、slide（折紙、發光礦石、賽跑、先猜）、
##          grid（坐標方格上點資料點）、choice（"guess": true 先猜，不扣分）、fill、order
##   speed  速算：gen = "law"（指數律，按鈕）、"grow"（倍增與減半、a + a^{−1}，按鈕）
## 使用者 2026/11/17：光柱只填關鍵卡、不出負數的分數次方、先猜不扣分、地標用圖示。

const SB := preload("res://data/levels/engine/step_bank.gd")
const B1 := preload("res://data/levels/num/num1_bank.gd")

const T_LAW := "elog_law"        # 指數律、有意義、化成質數的次方、解方程
const T_SUB := "elog_sub"        # 代換、找關係式
const T_ECHO := "elog_echo"      # a + a^{−1} 的乘法公式
const T_GROW := "elog_grow"      # 倍增與減半的應用
const T_CMP := "elog_cmp"        # 指數比大小


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


static func _j(name: String, statement: String, ok: bool, why: String, line: String, tag: String) -> Dictionary:
	return B1._j(name, statement, ok, why, line, tag)


## 填空可以打小數（鍵盤多一個「.」）
static func _dot(st: Dictionary) -> Dictionary:
	st["dot"] = true
	return st


## 光柱積木：把卡片拖到質數柱上
static func _drag(line: String, nudge: String, tag := T_LAW) -> Dictionary:
	return {"kind": "pdrag", "name": "拖到柱上", "q": "把卡片拖到質數柱上", "item": 0, "nudge": nudge, "line": line, "tag": tag}


## 一張卡：to = {"3": [高度, "標籤"]}
static func _card(s: String, to: Dictionary, why := "", extra := {}) -> Dictionary:
	var d := {"s": s, "to": to}
	if why != "":
		d["why"] = why
	d.merge(extra, true)
	return d


## 回音階梯點要踩的階
static func _rung(q: String, alts: Array, nudge: String, why := {}) -> Dictionary:
	return {"kind": "gtap", "name": "踩哪一階", "tag": T_ECHO, "q": q, "item": 0, "alts": alts, "why": why,
		"nudge": nudge, "line": ""}


## 滑桿（原野上的折紙、礦石、賽跑跟著它動）
static func _slide(name: String, q: String, n: String, lo: float, hi: float, start: float, goal: float, eq: String,
		line: String, nudge: String, tag: String, traps := [], stp := 1.0) -> Dictionary:
	return {"kind": "slide", "name": name, "q": q, "params": [{"n": n, "min": lo, "max": hi, "step": stp, "v": start}],
		"lines": [], "eq": eq, "goal": {n: goal}, "traps": traps, "line": line, "nudge": nudge, "tag": tag}


## 先猜（滑桿，不扣分）
static func _guess_slide(q: String, n: String, lo: float, hi: float, start: float, eq: String, line: String, tag: String) -> Dictionary:
	return {"kind": "slide", "name": "先猜", "q": q, "params": [{"n": n, "min": lo, "max": hi, "step": 1, "v": start}],
		"lines": [], "eq": eq, "free": true, "line": line, "line_vals": true, "nudge": "", "tag": tag}


## 坐標方格上的曲線（取樣成光線）
static func _curve(f: Callable, x0: float, x1: float, at: int, c := "lime") -> Dictionary:
	var pts := []
	var n := 24
	for k in n + 1:
		var x := x0 + (x1 - x0) * k / n
		pts.append([x, f.call(x)])
	return {"k": "path", "pts": pts, "c": c, "dur": 1.4, "at": at, "nohit": true}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		if String(slot.type) == "forge":
			slot["type_name"] = "逐步推導"
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
		for v in slot.get("variants", []):
			for st in v.get("steps", []):
				if String(st.get("kind", "")) == "fill":
					st["paren"] = true
	return out


