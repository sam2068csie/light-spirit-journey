# ================= 位數速算的題目 =================

## [顯示, 查表的 log]：只用表上有的數，次方都是 10、20、30、50、100 這種好乘的
const BASES := [["2", LOG2], ["3", LOG3], ["5", 1.0 - LOG2], ["7", LOG7]]
const EXPS := [10, 20, 30, 50, 100]


## 前一半：直接給 log 值，練「首數 ⇒ 位數／第幾位」；後一半：心算一次乘法再判斷
static func gen_problems(_kind: String, n: int) -> Array:
	var out := []
	var seen := {}
	var guard := 0
	var n_concept := int(ceil(n * 0.5))
	while out.size() < n and guard < 5000:
		guard += 1
		var tiny := randi() % 2 == 0
		var pb := {}
		if out.size() < n_concept:
			var c := randi_range(2, 30)
			var fr := randi_range(5, 95) / 100.0
			if tiny:
				var v := -(c + fr)
				var k := c + 1
				pb = {"eq": "log N ≈ %s" % ("%.2f" % v).replace("-", "−"), "ans": str(k), "value": float(k),
					"q": "N 在小數點後第幾位開始不為 0？", "template": "第 [0] 位",
					"nudge": "%.2f = −%d + %.2f，首數 −%d ⇒ 第 %d 位。" % [v, k, 1.0 - fr, k, k]}
			else:
				var v2 := c + fr
				pb = {"eq": "log N ≈ %.2f" % v2, "ans": str(c + 1), "value": float(c + 1), "q": "N 是幾位數？", "template": "[0] 位數",
					"nudge": "首數 %d ⇒ %d 位數。" % [c, c + 1]}
		else:
			var bb: Array = BASES.pick_random()
			var b := int(bb[0])
			var lt: float = bb[1]
			var e: int = EXPS.pick_random()
			var v3: float = e * lt * (-1.0 if tiny else 1.0)
			var real: float = e * lg(b) * (-1.0 if tiny else 1.0)
			var fr2: float = v3 - floor(v3)
			if fr2 < 0.03 or fr2 > 0.97 or floor(v3) != floor(real):
				continue
			if not tiny:
				var eq := "%s^{%d}" % [bb[0], e]
				pb = {"eq": eq, "ans": str(int(floor(v3)) + 1), "value": floor(real) + 1.0,
					"q": "是幾位數？" + TABLE_Q, "template": "[0] 位數",
					"nudge": "log %s ≈ %d × %.4f = %.3f，首數 %d ⇒ %d 位數。" % [eq, e, lt, v3, int(floor(v3)), int(floor(v3)) + 1]}
			else:
				var eq2 := "(1/%s)^{%d}" % [bb[0], e]
				var k2 := -int(floor(v3))
				pb = {"eq": eq2, "ans": str(k2), "value": -floor(real),
					"q": "小數點後第幾位開始不為 0？" + TABLE_Q, "template": "第 [0] 位",
					"nudge": "log ≈ %.3f = %d + %.3f，首數 %d ⇒ 第 %d 位。" % [v3, int(floor(v3)), fr2, int(floor(v3)), k2]}
		if seen.has(pb.eq):
			continue
		seen[pb.eq] = true
		pb["kind"] = "tiny" if tiny else "big"
		pb["tag"] = "digits_char"
		pb["resid"] = 0.0
		out.append(pb)
	return out
