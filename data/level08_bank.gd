extends RefCounted
## 第八大關「位數望遠鏡」題庫（對應講義 2-4 重點一：首數與尾數、重點二：應用問題）
##
## 旅程都是 forge，沿用 choice／fill（dec: true 時鍵盤有小數點，mode "approx" 允許誤差 tol）／order，再加上：
##   ruler  尾數尺：0 到 1 的尺上標著 log 2、log 3……，尾數是一根指針，學生選出最高位數字（ans）
##   grow   成長與衰退：拖動次數 n，看病毒分裂、原子熄滅、金幣疊高、豆子長大、星星變亮，
##          找出「第一次」達到目標的 n（ans）。值 = a0 × r^{n}。
## 每一步可以帶 show：答對之後，望遠鏡上顯示的東西
##   {"kind": "strip", "digits": 31, "lead": "1", "label": "2^{100}"}   很大的數：有幾位、第一個數字
##   {"kind": "tiny", "place": 7, "lead": "9", "label": "(1/2)^{20}"}   很小的數：小數點後第幾位
##   {"kind": "family", "rows": [[數, 首數, 尾數], …]}                 同一個尾數的一家人
## check：測試用，[實際算出的值, 答案, 容許誤差]。

const B4 := preload("level04_bank.gd")
const LOG2 := 0.3010
const LOG3 := 0.4771
const LOG7 := 0.8451
const TABLE := "\n（log 2 ≈ 0.3010、log 3 ≈ 0.4771、log 7 ≈ 0.8451）"   # 題目裡另起一行
const TABLE_Q := "\nlog 2 ≈ 0.3010、log 3 ≈ 0.4771\nlog 7 ≈ 0.8451"   # 右邊問句裡：log 2、log 3 一行，log 7 一行


static func lg(x: float) -> float:
	return log(x) / log(10.0)


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag := "digits_char") -> Dictionary:
	return B4._c(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag := "digits_calc", mode := "ordered") -> Dictionary:
	return B4._f(name, q, template, answers, line, nudge, tag, mode)


## 小數的填空（鍵盤有小數點）
static func _fd(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag := "digits_calc", tol := -1.0) -> Dictionary:
	var d := _f(name, q, template, answers, line, nudge, tag, "approx" if tol > 0.0 else "ordered")
	d["dec"] = true
	if tol > 0.0:
		d["tol"] = tol
	return d


static func _show(st: Dictionary, show: Dictionary) -> Dictionary:
	st["show"] = show
	return st


static func _strip(digits: int, lead: String, label: String) -> Dictionary:
	return {"kind": "strip", "digits": digits, "lead": lead, "label": label}


static func _tiny(place: int, lead: String, label: String) -> Dictionary:
	return {"kind": "tiny", "place": place, "lead": lead, "label": label}


## 尾數尺
static func _ruler(alpha: float, ans: int, line: String, nudge: String, q := "尾數落在尺上的哪一格？選出最高位（第一個不為 0）的數字。") -> Dictionary:
	return {"kind": "ruler", "name": "尾數尺", "q": q, "alpha": alpha, "ans": ans, "line": line, "nudge": nudge, "tag": "digits_mant"}


## 成長與衰退
static func _grow(model: String, a0: float, r: float, nmin: int, nmax: int, cmp: String, target: float, ans: int,
		nlabel: String, per: float, unit: String, qty: String, qunit: String, line: String, nudge: String,
		q := "拖動 n，找出「第一次」達到目標的時候，然後鎖定。") -> Dictionary:
	return {"kind": "grow", "name": "拉動驗證", "q": q, "model": model, "a0": a0, "r": r, "nmin": nmin, "nmax": nmax,
		"cmp": cmp, "target": target, "ans": ans, "nlabel": nlabel, "per": per, "unit": unit, "qty": qty, "qunit": qunit,
		"line": line, "nudge": nudge, "tag": "digits_apply"}


