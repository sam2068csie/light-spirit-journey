extends RefCounted
## 三角函數 第一大關「弧之渡口」題庫（對應講義 1-1 重點一：弧度量，扇形在下一關）
##
## 旅程（引擎見 step_level.gd，這一關的畫面與新步驟見 level_trig1_arc.gd）：
##   forge  一步一步推導。除了 choice、fill、order，這一關多一種步驟：
##            spin  在單位圓上拖動終邊，轉出指定的角（逆時針為正、順時針為負，可以轉超過一圈）
##                  target 是目標角（弧度），每次轉動以 π/12（15°）為一格
##          circle：下方的單位圓示意圖（不用 spin 也能顯示）
##            {"theta": 角, "label": 顯示的名字, "after": 第幾步之後出現（−1 = 一開始就有）}
##            或 {"angles": [角…], "labels": [名字…], "proj": "y"（標出高度＝sin）或 "x"（cos）, "after": …}
##          spin 答對之後，下方會自動留著那個角的示意圖。
##   speed  速算：gen = "conv"（度 ⇄ 弧度）、"val"（特殊角的值，含根號）
##   這一關的數字鍵盤都有「√」鍵（level_trig1_arc.gd 的 radicals_ok()）：答案可以寫 "−√3/2"、"2√3"、"√3/3"，
##   學生填 1/√3 也算對（會自動有理化）。
##
## 觀念標籤都用 trig_ 開頭（名稱寫在 quiz_manager.gd 的 MISTAKE_INFO）。

const SB := preload("step_bank.gd")

const T_CONV := "trig_rad_conv"
const T_DRAW := "trig_angle_draw"
const T_COT := "trig_coterminal"
const T_QUAD := "trig_quadrant"
const T_SPEC := "trig_special"
const T_SIGN := "trig_sign"
const T_RED := "trig_reduce"
const T_CMP := "trig_compare"

const QUADS := ["第一象限", "第二象限", "第三象限", "第四象限"]


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 在單位圓上轉出一個角
static func _s(name: String, q: String, target: float, line: String, nudge: String, tag := T_DRAW) -> Dictionary:
	return {"kind": "spin", "name": name, "q": q, "target": target, "line": line, "nudge": nudge, "tag": tag}


## 象限的選擇題（正解是第 k 象限，k = 1～4）
static func _quad(q: String, k: int, why: String, nudge: String, line: String, tag := T_QUAD) -> Dictionary:
	var opts := QUADS.duplicate()
	var right: String = opts[k - 1]
	opts.remove_at(k - 1)
	opts.push_front(right)
	return _c("象限", q, opts, 0, why, nudge, line, tag)


const D2R := "度化成弧度，要乘上什麼？"
const R2D := "弧度化成度，要乘上什麼？"


static func _to_rad() -> Dictionary:
	return _c("換算", D2R, ["π/180", "180/π", "π/360", "2π"], 0,
		"180° = π 弧度，所以 1° = π/180。", "半圈是 180°，也是 π 弧度。", "1° = π/180 弧度", T_CONV)


static func _to_deg() -> Dictionary:
	return _c("換算", R2D, ["180/π", "π/180", "360", "π"], 0,
		"π 弧度 = 180°，乘 180/π 剛好把 π 消掉。", "半圈是 π 弧度，也是 180°。", "1 弧度 = 180/π 度", T_CONV)


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true          # 舞台只畫背景，內容由推導台負責
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


