## 單位圓求值：轉出角 → 參考角 → 正負 → 答案
##   q：第幾象限；pos：答案是不是正的
static func _value_v(fn: String, ang: String, theta: float, q: int, ref: String, ref_line: String, pos: bool,
		ans: String, _opts: Array) -> Dictionary:
	var sign_why := {
		"sin": "sin 看縱坐標：第一、二象限是正的，第三、四象限是負的。",
		"cos": "cos 看橫坐標：第一、四象限是正的，第二、三象限是負的。",
		"tan": "tan = sin/cos：第一、三象限是正的，第二、四象限是負的。"}
	var refs := ["π/6", "π/4", "π/3", "π/2"]
	refs.erase(ref)
	refs.push_front(ref)
	return {"eq": "求 %s(%s)" % [fn, ang],
		"steps": [
			_s("轉出角", "先在單位圓上轉出 %s。" % ang, theta,
				"%s 的終邊在%s" % [ang, QUADS[q - 1]], "逆時針為正、順時針為負。"),
			_c("參考角", "終邊和 x 軸的夾角（參考角）是多少？", refs, 0, ref_line + "。", "看終邊離最近的 x 軸差多少。",
				"參考角 = " + ref, T_SPEC),
			_c("正負", "%s的 %s 是正還是負？" % [QUADS[q - 1], fn], ["正", "負"] if pos else ["負", "正"], 0,
				sign_why[fn], sign_why[fn], "%s：%s %s 0" % [QUADS[q - 1], fn, ">" if pos else "<"], T_SIGN),
			_f("答案", "算出 %s(%s)。" % [fn, ang], "%s(%s) = [0]" % [fn, ang],
				[ans.replace("√{", "√").replace("}", "")], "%s(%s) = %s%s(%s) = %s" % [fn, ang, "" if pos else "−", fn, ref, ans],
				"先算 %s(%s)，再加上正負號。" % [fn, ref], T_SPEC),
		]}


## 奇變偶不變：k 是 π/2 的幾倍，f 原函數、g 化簡後的函數，q 是「θ 當銳角」時角在第幾象限，pos：f 在那裡是正的
static func _odd_v(expr: String, k: int, f: String, g: String, q: int, pos: bool, ans: String, opts: Array) -> Dictionary:
	var odd := k % 2 == 1
	var change := "%s 變 %s" % [f, g] if odd else "%s 不變" % f
	var o1 := ["%d 倍（奇數）：要變（sin ⇄ cos）" % k, "%d 倍（奇數）：名稱不變" % k] if odd \
		else ["%d 倍（偶數）：名稱不變" % k, "%d 倍（偶數）：要變（sin ⇄ cos）" % k]
	var quad_name: String = QUADS[q - 1]
	var o2 := ["%s，%s %s 0" % [quad_name, f, ">" if pos else "<"], "%s，%s %s 0" % [quad_name, f, "<" if pos else ">"]]
	for j in 4:
		if j + 1 != q and o2.size() < 4:
			o2.append("%s，%s %s 0" % [QUADS[j], f, ">" if pos else "<"])
	return {"eq": "化簡 " + expr,
		"steps": [
			_c("奇變偶不變", "角裡面的常數是 π/2 的幾倍？函數名稱要不要變？", o1, 0,
				"奇數倍：sin ⇄ cos；偶數倍：名稱不變。", "把常數寫成 □ × π/2。",
				"%d × π/2，%s倍 ⇒ %s" % [k, "奇數" if odd else "偶數", change], T_RED),
			_c("符號看象限", "把 θ 當成很小的銳角，%s 的角在第幾象限？原來的 %s 在那裡是正是負？" % [expr, f], o2, 0,
				"θ 是小小的銳角時，角落在%s；%s 在那裡%s。" % [quad_name, f, "是正的" if pos else "是負的"],
				"θ 想成 10°，算算看角有多大。", "%s 在%s，%s %s 0 ⇒ %s" % [expr.split("(")[1].trim_suffix(")"), quad_name, f,
				">" if pos else "<", "取正號" if pos else "取負號"], T_SIGN),
			_c("結果", "%s = ？" % expr, opts, 0, "%s，再加上正負號。" % change, "名稱和正負號分開決定。",
				"%s = %s" % [expr, ans], T_RED),
		]}
