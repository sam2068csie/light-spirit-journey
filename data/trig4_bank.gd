extends RefCounted
## 三角函數 第四大關「潮汐調音盤」題庫（對應講義 1-1 重點二後半：圖形的伸縮與平移、看圖求式、應用題、作圖求解）
## 題目的數字都是自己設計的（和講義、學校的題目不一樣），觀念對應：
##   y = a sin(bx + c) + d：|a| 振幅、2π/|b| 週期、−c/b 左右平移、d 上下平移（中線）
##   先伸縮、再平移；看圖求式；潮汐、摩天輪；作圖求方程式的解（個數、範圍）
##
## 引擎：level_trig4_tide.gd（繼承第一關）。步驟除了 choice、fill、filter，多四種動手的：
##   dial   調音旋鈕：knobs（旋鈕）、target（目標 {a, b, c, d}，c 是真實的角度）、view（圖的範圍）、fn（"sin"／"cos"／"tan"）。
##          dots 是資料點（有 dots 時改成「穿過所有資料點」才算過關，target 只拿來畫過關後的圖）。
##          base：true 會畫一條淡淡的 y = sin x 當參考。fixed：不給旋鈕的參數的值。
##          旋鈕 {p: "a"／"b"／"c"／"d", lo, hi, step, start} 或 {p, vals: […], start}；unit: "pi" 表示數值是 π 的倍數
##   chain  變換鏈：把 y = sin x（或 cos x）接上伸縮、平移的零件變成 target。
##          ops 是零件 {t: "v" 鉛直伸縮、"h" 水平伸縮、"x" 左右平移（π 的倍數）、"y" 上下平移, v: 數值}，max 是最多接幾個
##   ride   摩天輪：r 半徑、cy 中心高度、T 轉一圈的時間、phi 出發的位置（−π/2 是最低點）、
##          level 要找的高度、targets 要找的時刻、snap 時間每一格
##   hunt   找交點：curves 兩條曲線（{f, a, b, c, d, col, label}，f 可以是 "line"：m 斜率、k 截距）、view、count 交點的個數
## 下方的示意圖："circles": [{"kind": "tide", "after": …, …}, …]（隨步驟換圖，用 after 比目前步驟小的最後一張）
##   tide 圖的欄位：curves、x、y、xu（"pi" 或 "num"）、xt、yt、pts（[x, y, 標籤]）、hlines、period、amp、shift、aid、xl、yl
const UITheme := preload("game_theme.gd")

const SB := preload("step_bank.gd")

const T_AMP := "trig_amp"
const T_FREQ := "trig_freq"
const T_SHIFT := "trig_shift"
const T_ORDER := "trig_order"
const T_READ := "trig_read"
const T_APPLY := "trig_apply"
const T_SOLVE := "trig_solve"

const SIN_C := UITheme.CYAN
const COS_C := UITheme.ORANGE
const TIDE_C := UITheme.VIOLET
const LINE_C := UITheme.PINK_LIGHT


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 是非判斷（真假判斷題用）
static func _tf(name: String, stmt: String, truth: bool, why: String, line: String) -> Dictionary:
	return _c(name, stmt, ["對", "錯"] if truth else ["錯", "對"], 0, why, why, line, T_APPLY)


## 目標 {a, b, c, d}（c 是真實的角度，寫 P/3 之類）
static func _t(a: float, b: float, c: float, d: float) -> Dictionary:
	return {"a": a, "b": b, "c": c, "d": d}


## 圖的範圍
static func _v(x0: float, x1: float, y0: float, y1: float, extra := {}) -> Dictionary:
	var v := {"x": [x0, x1], "y": [y0, y1]}
	v.merge(extra, true)
	return v


## 旋鈕：從 lo 到 hi，每格 step
static func _k(p: String, lo: float, hi: float, step: float, start: float, extra := {}) -> Dictionary:
	var k := {"p": p, "lo": lo, "hi": hi, "step": step, "start": start}
	k.merge(extra, true)
	return k


## 旋鈕：指定可以選的值（例如 b 只有 1/2、1、2、3…）
static func _kv(p: String, vals: Array, start: float, extra := {}) -> Dictionary:
	var k := {"p": p, "vals": vals, "start": start}
	k.merge(extra, true)
	return k


static func _dial(name: String, q: String, fn: String, knobs: Array, target: Dictionary, view: Dictionary,
		line: String, nudge: String, tag: String, extra := {}) -> Dictionary:
	var d := {"kind": "dial", "name": name, "q": q, "fn": fn, "knobs": knobs, "target": target, "view": view,
		"line": line, "nudge": nudge, "tag": tag}
	d.merge(extra, true)
	return d


## 零件
static func _o(t: String, v: float) -> Dictionary:
	return {"t": t, "v": v}


static func _chain(name: String, q: String, fn: String, target: Dictionary, ops: Array, view: Dictionary,
		line: String, nudge: String, tag: String, mx := 6) -> Dictionary:
	return {"kind": "chain", "name": name, "q": q, "fn": fn, "target": target, "ops": ops, "view": view,
		"line": line, "nudge": nudge, "tag": tag, "max": mx}


static func _ride(name: String, q: String, r: float, cy: float, T: float, phi: float, level: float, targets: Array,
		line: String, nudge: String, snap := 0.5) -> Dictionary:
	return {"kind": "ride", "name": name, "q": q, "r": r, "cy": cy, "T": T, "phi": phi, "level": level,
		"targets": targets, "snap": snap, "line": line, "nudge": nudge, "tag": T_APPLY}


static func _hunt(name: String, q: String, c1: Dictionary, c2: Dictionary, view: Dictionary, count: int,
		line: String, nudge: String, tag: String) -> Dictionary:
	return {"kind": "hunt", "name": name, "q": q, "curves": [c1, c2], "view": view, "count": count,
		"line": line, "nudge": nudge, "tag": tag}


## 曲線
static func _cv(fn: String, a: float, b: float, c: float, d: float, col: Color, label := "") -> Dictionary:
	return {"f": fn, "a": a, "b": b, "c": c, "d": d, "col": col, "label": label}


## 直線 y = m x + k
static func _ln(m: float, k: float, col: Color, label := "") -> Dictionary:
	return {"f": "line", "m": m, "k": k, "col": col, "label": label}


## 下方的示意圖
static func _g(curves: Array, x: Array, y: Array, extra := {}) -> Dictionary:
	var g := {"kind": "tide", "curves": curves, "x": x, "y": y}
	g.merge(extra, true)
	return g


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		slot["params"] = slot.get("params", [])
		SB.fix_roots(slot)
	return out


