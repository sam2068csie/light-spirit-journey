extends RefCounted
## 三角函數 第六大關「倍角鏡池」題庫（對應講義 1-2 重點二：二倍角與半角公式）
## 題目的數字都是自己設計的（和講義、學校的題目不一樣）。
##
## 引擎：level_trig6_mirror.gd（繼承第五關）。步驟除了 choice、fill、filter，多兩種動手的：
##   mirror 鏡池：mode "double"（轉鏡面 φ，反射線在 2φ，要對準 target）、"half"（同上，但從半角的角度問）、
##          "sweep"（拖動 θ 掃過 band 的範圍，看 θ/2 的象限和正負）。show："dbl"（顯示二倍角的算式）或 "half"（半角的算式）。
##   eq     拼公式：expr（左邊顯示的樣子）、target（"sin2"、"cos2"、"tan2"、"half_sin2"、"half_cos2"、"tan_half"）、tokens（積木）。
##          用 θ = 30°、50°、110°、200° 代進去算，和正確的式子一樣就過關（所以 cos 2θ 用 cos θ 或 sin θ 拼都可以）。
const UITheme := preload("game_theme.gd")

const SB := preload("step_bank.gd")

const T_DBL := "trig_double"
const T_COS2 := "trig_cos2form"
const T_DVAL := "trig_dblvalue"
const T_MERGE2 := "trig_dblmerge"
const T_HALF := "trig_half"
const T_HALFQ := "trig_halfquad"
const T_RAD := "trig_sqrtsimp"
const T_TANREP := "trig_tanrep"
const T_PROD := "trig_product"
const T_EXT := "trig_dblextreme"
const T_JUDGE6 := "trig_dbljudge"

const TK_ALL := ["sin θ", "cos θ", "sin² θ", "cos² θ", "1", "2", "+", "−", "×"]
const TK_COS := ["cos θ", "cos² θ", "1", "2", "−", "×"]
const TK_SIN := ["sin θ", "sin² θ", "1", "2", "−", "×"]
const TK_TAN := ["tan θ", "tan² θ", "1", "2", "+", "−", "×", "÷", "(", ")"]
const TK_HALF := ["cos θ", "sin θ", "1", "2", "+", "−", "÷", "(", ")"]


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


static func _tf(name: String, stmt: String, truth: bool, why: String, line: String) -> Dictionary:
	return _c(name, stmt, ["對", "錯"] if truth else ["錯", "對"], 0, why, why, line, T_JUDGE6)


## 轉鏡面（mode "double"：range 0～180、每格 15°；"half"：range 0～90、每格 7.5°）
static func _mirror(name: String, q: String, mode: String, target: float, line: String, nudge: String, tag: String) -> Dictionary:
	var half := mode == "half"
	return {"kind": "mirror", "name": name, "q": q, "mode": mode, "target": target, "show": "half" if half else "dbl",
		"range": [0.0, 90.0] if half else [0.0, 180.0], "step": 7.5 if half else 15.0, "start": 0.0,
		"line": line, "nudge": nudge, "tag": tag}


## 掃過 θ 的範圍（band 是 θ 的範圍，滑桿只能在範圍裡面走）
static func _sweep(name: String, q: String, lo: float, hi: float, line: String, nudge: String) -> Dictionary:
	return {"kind": "mirror", "name": name, "q": q, "mode": "sweep", "band": [lo, hi], "range": [lo + 15.0, hi - 15.0],
		"step": 15.0, "start": (lo + hi) / 2.0, "line": line, "nudge": nudge, "tag": T_HALFQ}


static func _eq(name: String, q: String, expr: String, target: String, tokens: Array, line: String, nudge: String,
		tag: String) -> Dictionary:
	return {"kind": "eq", "name": name, "q": q, "expr": expr, "target": target, "tokens": tokens.duplicate(),
		"line": line, "nudge": nudge, "tag": tag}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		slot["params"] = slot.get("params", [])
		SB.fix_roots(slot)
		# 有分數的積木（÷）：改成「分數」模式，分子、分母各一格，不用打括號
		for v in slot.variants:
			for st in v.get("steps", []):
				if st.kind == "eq" and "÷" in st.tokens:
					st["frac"] = true
	return out


