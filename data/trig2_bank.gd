## 篩選的候選值叫做 θ（不是 t）
static func _theta_filter(st: Dictionary) -> Dictionary:
	st["var"] = "θ"
	return st


## 打開扇子：半徑 r；先打開到 1 弧度（弧長 = 半徑），再打開到面積 = 指定值，最後算 θ = pπ/q 的弧長和面積
static func _fan_v(r: float, p: int, q: int, _arc: String, area: String) -> Dictionary:
	var ri := int(r)
	var th_txt := ("%dπ/%d" % [p, q]) if p != 1 else ("π/%d" % q)
	var area_v := 0.5 * r * r * PI * p / q
	# 面積寫成 \frac{16}{3}π（不要寫 16/3π，會被排成 16 ÷ 3π）
	var am := ("\\frac{%s}{%s}π" % Array(area.split("/"))) if area.contains("/") else area + "π"
	# 順序：先算 θ → 再把扇子拉到那個角 → 算面積要的 θ → 再拉一次
	return {"eq": "半徑 r = %d 的扇子" % ri,
		"steps": [
			_f("算弧度", "弧長要剛好等於半徑 %d。l = rθ，θ 是多少弧度？" % ri, "%dθ = %d ⇒ θ = [0]" % [ri, ri], ["1"],
				"弧長 = 半徑：%dθ = %d ⇒ θ = 1 弧度" % [ri, ri], "l = rθ，兩邊同除以 %d。" % ri, T_FORM),
			_fan("拉弧度", "把扇子打開到 1 弧度（弧長 = 半徑 %d）。" % ri, r, "arc", r,
				"1 弧度約 57°，比 60° 小一點", "1 弧度約 57°，比 60° 小一點點。", 0.0, 0.05),
			_f("算面積", "面積要等於 %s。A = \\frac{1}{2}r^{2}θ，θ 是多少？" % am,
				"\\frac{1}{2} × %d^{2} × θ = %s ⇒ θ = [0]π" % [ri, am], ["%d/%d" % [p, q]],
				"\\frac{1}{2} × %d^{2} × θ = %s ⇒ θ = %s" % [ri, am, th_txt],
				"\\frac{1}{2} × %d^{2} = %s，%s ÷ %s。" % [ri, _half_sq(ri), am, _half_sq(ri)], T_FORM),
			_fan("拉面積", "把扇子打開到 %s，讓面積 = %s。" % [th_txt, am], r, "area", area_v,
				"θ = %s 時面積 = %s" % [th_txt, am], "上一步算出來的角：%s。" % th_txt),
		]}


## "2/3" → "2π/3"、"1/2" → "π/2"、"1" → "π"（不要寫成 2/3π，會被排成 2 ÷ 3π）
static func _pi_frac(q: String) -> String:
	if not q.contains("/"):
		return "π" if q == "1" else q + "π"
	var pr := q.split("/")
	return ("π" if pr[0] == "1" else pr[0] + "π") + "/" + pr[1]


static func _half_sq(r: int) -> String:
	return str(r * r / 2) if (r * r) % 2 == 0 else "%d/2" % (r * r)


## 周長 L、面積 A 求 (r, θ)
static func _perim_v(L: int, A: int, coef: Array, roots: Array, thetas: Array, keep: Array, final_tpl: String,
		final_ans: Array, final_line: String) -> Dictionary:
	var r0: int = roots[0]
	var r1: int = roots[1]
	var drop := []
	for i in keep.size():
		if not keep[i]:
			drop.append("θ = " + String(thetas[i]))
	var keep_line := "θ 都在 2π 以內，兩組都合" if drop.is_empty() else "%s > 2π，不合" % ", ".join(drop)
	return {"eq": "扇形的周長是 %d，面積是 %d，\n求半徑 r 與圓心角 θ" % [L, A],
		"steps": [
			_f("周長", "周長 = 2r + rθ。把 rθ 用 r 表示。", "rθ = [0] − [1]r", [str(L), "2"],
				"2r + rθ = %d ⇒ rθ = %d − 2r" % [L, L], "兩條半徑加上弧長。", T_PERI),
			_f("面積", "面積 = \\frac{1}{2}r²θ = \\frac{1}{2}r·(rθ)，所以 r(%d − 2r) 等於多少？" % L, "r(%d − 2r) = [0]" % L, [str(2 * A)],
				"\\frac{1}{2}r²θ = %d ⇒ r·rθ = %d ⇒ r(%d − 2r) = %d" % [A, 2 * A, L, 2 * A], "r²θ = 2 × 面積。", T_PERI),
			_f("整理", "整理成 r 的二次方程式（填係數）。", "[0]r^{2} + [1]r + [2] = 0", [str(coef[0]), str(coef[1]), str(coef[2])],
				"r^{2} %s %dr + %d = 0" % ["−" if coef[1] < 0 else "+", absi(coef[1]), coef[2]], "展開、移項，再同除以 2。",
				T_PERI, "prop"),
			_f("解 r", "解出 r（順序不限）。", "r = [0] 或 r = [1]", [str(r0), str(r1)], "r = %d 或 %d" % [r0, r1],
				"找相乘 %d、相加 %d 的兩個數。" % [coef[2], -coef[1]], T_PERI, "set"),
			_f("求 θ", "θ = %d/r^{2}。" % (2 * A), "r = %d 時 θ = [0]；r = %d 時 θ = [1]" % [r0, r1], thetas,
				"r = %d ⇒ θ = %s；r = %d ⇒ θ = %s" % [r0, thetas[0], r1, thetas[1]], "%d ÷ r²。" % (2 * A), T_PERI),
			_theta_filter(SB.filter("檢查", "扇形的圓心角要在 0 和 2π（≈ 6.28）之間。哪些 θ 可以留下？", thetas, keep, keep_line,
				"2π ≈ 6.28：超過一圈的角不可能是扇形。", T_PERI)),
			_f("答案", "寫出答案。", final_tpl, final_ans, final_line, "留下來的那組（或那兩組）。", T_PERI),
		]}


## 周長 L 固定，求最大面積
static func _max_v(eq: String, L: int) -> Dictionary:
	var h := L / 4                 # 頂點 r = L/4
	var amax := h * h
	return {"eq": eq,
		"steps": [
			_f("面積", "弧長 l = %d − 2r，面積 A = \\frac{1}{2}rl = \\frac{1}{2}r(%d − 2r)。展開：" % [L, L], "A = −r^{2} + [0]r", [str(L / 2)],
				"A = \\frac{1}{2}r(%d − 2r) = −r^{2} + %dr" % [L, L / 2], "\\frac{1}{2} × r × %d − \\frac{1}{2} × r × 2r。" % L, T_MAX),
			_f("配方", "配方找頂點。", "A = −(r − [0])^{2} + [1]", [str(h), str(amax)],
				"A = −(r − %d)^{2} + %d" % [h, amax], "−r² + %dr = −(r² − %dr + %d) + %d。" % [L / 2, L / 2, amax, amax], T_MAX),
			_f("最大", "面積最大時，r 是多少？圓心角 θ = l/r 是多少？", "r = [0]，θ = [1]", [str(h), "2"],
				"r = %d 時面積最大 %d，此時 l = %d、θ = 2" % [h, amax, L - 2 * h], "l = %d − 2r，θ = l ÷ r。" % L, T_MAX),
		],
		"circle": {"kind": "parab", "L": float(L), "after": 0}}


## 時鐘：h 點 m 分時，時針與分針的夾角
static func _clock_v(h: int, m: int, mdeg: int, hdeg: int, ans: String, deg_txt: String) -> Dictionary:
	return {"eq": "%d 點 %d 分時，時針與分針的夾角（較小的那個）\n是多少弧度？" % [h, m],
		"steps": [
			_c("轉速", "從 12 點的位置順時針量：分針每分鐘轉幾度？時針每分鐘轉幾度？", ["6° 和 0.5°", "6° 和 30°", "1° 和 0.5°", "30° 和 6°"],
				0, "分針 60 分鐘轉 360°；時針 12 小時（720 分鐘）轉 360°。", "360 ÷ 60、360 ÷ 720。", "分針每分鐘 6°，時針每分鐘 0.5°",
				T_CLOCK),
			_f("分針", "分針在幾度？", "分針 = [0]°", [str(mdeg)], "分針：%d × 6° = %d°" % [m, mdeg], "%d 分 × 6°。" % m, T_CLOCK),
			_f("時針", "時針在幾度？（%d 點整在 %d°，再加上 %d 分鐘走的）" % [h, h * 30, m], "時針 = [0]°", [str(hdeg)],
				"時針：%d × 30° + %d × 0.5° = %d°" % [h, m, hdeg], "%d × 30 + %d × 0.5。" % [h, m], T_CLOCK),
			_f("夾角", "夾角化成弧度。", "夾角 = [0]π", [ans], "夾角 = %s = %s" % [deg_txt, _pi_frac(ans)], "相減，再乘 π/180。", T_CLOCK),
		],
		"circle": {"kind": "clock", "h": h, "m0": m, "mode": "angle", "after": -1}}


## 螞蟻：底半徑 r、高 h_txt、斜高 l；攤開角 θ = (k)π，最短路徑 path，側面積 lat
static func _ant_v(r: int, h_txt: String, l: int, l_line: String, th: String, cos_txt: String, sq: int, path: String) -> Dictionary:
	var thp := _pi_frac(th)
	return {"eq": "圓錐的底半徑 %d、高 %s。螞蟻從底圓上一點 A 出發，\n繞側面一圈回到 A，最短路徑多長？" % [r, h_txt],
		"steps": [
			_f("斜高", "先求斜高（母線長）：底半徑、高、斜高是一個直角三角形。", "ℓ = [0]", [str(l)], "斜高 ℓ = %s" % l_line,
				"√(半徑^{2} + 高^{2})。", T_CONE),
			_f("底圓周長", "側面攤開後，扇形的弧就是底圓的一圈。底圓周長是？", "2π × %d = [0]π" % r, [str(2 * r)],
				"弧長 = 底圓周長 = %dπ" % (2 * r), "2πr，r = %d。" % r, T_CONE),
			_f("圓心角", "扇形半徑是 ℓ = %d、弧長是 %dπ，圓心角是？" % [l, 2 * r], "θ = [0]π", [th],
				"圓心角 θ = %s" % thp, "θ = 弧長 ÷ 半徑。", T_CONE),
			_f("餘弦定理", "最短路徑是攤開後 A 到 A′ 的線段。三角形兩邊都是 %d、夾角 %s，用餘弦定理（cos %s = %s）：" % [l, thp, thp, cos_txt],
				"AA′^{2} = %d^{2} + %d^{2} − 2 × %d × %d × cos %s = [0]" % [l, l, l, l, thp], [str(sq)],
				"AA′^{2} = %d + %d − 2 × %d × (%s) = %d" % [l * l, l * l, l * l, cos_txt, sq],
				"cos %s = %s。" % [thp, cos_txt], T_CONE),
			_f("最短", "開根號，記得化簡。", "AA′ = [0]", [path], "最短路徑 AA′ = √%d = %s" % [sq, path],
				"√%d 化簡。" % sq, T_CONE),
		],
		"circles": [
			{"kind": "ant3d", "R": float(l), "r": float(r), "after": -1},
			{"kind": "ant", "R": float(l), "theta": float(r) / l * TAU, "after": 1},
		]}