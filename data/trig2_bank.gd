extends RefCounted
## 三角函數 第二大關「扇形潟湖」題庫（對應講義 1-1 重點一後半：扇形問題）
## 題目都是依講義的題型自己出的變體（數字、情境都換過）。
##
## 引擎：level_trig2_sector.gd（繼承第一關，數字鍵盤一樣有 √ 鍵）。步驟除了 choice、fill、filter、spin，多一種：
##   fan  拖動扇子的邊把扇子打開：r 是半徑，goal 是 "arc"（弧長）或 "area"（面積），target 是目標值，
##        snap 是每一格的角度（0 = 連續拖動，用在「1 弧度」這種不是 π 倍數的角），tol 是容許誤差
## 下方的示意圖 circle：{"kind": "sector"／"clock"／"wheel"／"belt"／"seg"／"lens"／"cone"／"ant"／"parab", …, "after": 第幾步之後出現}
##   各種圖要的欄位見 level_trig2_sector.gd 的 SectorView._draw_kind()。
## 答案有 π 和根號混在一起時，寫成兩格："[0]π + [1]"，答案 ["6", "-9√3"]（負的會自動顯示成「−」）。

const SB := preload("step_bank.gd")

const T_FORM := "trig_sector_formula"
const T_PERI := "trig_sector_perimeter"
const T_MAX := "trig_sector_max"
const T_CLOCK := "trig_sector_clock"
const T_ROLL := "trig_sector_roll"
const T_SEG := "trig_sector_segment"
const T_CONE := "trig_sector_cone"


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag: String) -> Dictionary:
	return SB.choice(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag: String, mode := "ordered") -> Dictionary:
	return SB.fill(name, q, template, answers, line, nudge, tag, mode)


## 打開扇子
static func _fan(name: String, q: String, r: float, goal: String, target: float, line: String, nudge: String,
		snap := PI / 12.0, tol := 0.001) -> Dictionary:
	return {"kind": "fan", "name": name, "q": q, "r": r, "goal": goal, "target": target, "snap": snap, "tol": tol,
		"line": line, "nudge": nudge, "tag": T_FORM}


static func slots() -> Array:
	var out := _slots()
	for slot in out:
		slot["plain"] = true
		SB.fix_roots(slot)
		slot["params"] = slot.get("params", [])
	return out


