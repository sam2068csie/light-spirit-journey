extends RefCounted
## 第七大關「正負羅盤」題庫（對應講義 重點四：對數不等式與極值）
##
## 旅程都是 forge，沿用前面的 choice／fill／rule／order／line／grid／explore，再加上：
##   compass  正負判斷：每個 log_{a} b 的底數、真數各和 1 比，用口訣判斷正負。
##            items 是 {text, a, b}，答案由 (a − 1)(b − 1) 的正負決定。
## explore 的 tmap 可以是 {"kind": "log", "b": 底數}：t = log_{b} x，t 的範圍由 xdom（x 的範圍）算出。
##
## verify.ineq(x)：測試用，數線的答案要和它一致。check：[算出來的值, 答案]。

const B4 := preload("level04_bank.gd")
const B2 := preload("level02_bank.gd")


## 二次不等式前面的「自己因式分解」：fac 是分解後的樣子，rel 是不等號
static func _fac(fac: String, rel: String, v := "x", tag := "logineq_calc") -> Dictionary:
	var st := B2._factor_step({"fac_line": fac}, v)
	st["line"] = String(st.options[0]) + " " + rel + " 0"
	st["tag"] = tag
	return st


static func lb(b: float, x: float) -> float:
	return log(x) / log(b)


static func lg(x: float) -> float:
	return log(x) / log(10.0)


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag := "logineq_flip") -> Dictionary:
	return B4._c(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag := "logineq_calc", mode := "ordered") -> Dictionary:
	return B4._f(name, q, template, answers, line, nudge, tag, mode)


static func _r(q: String, correct: String, others: Array, line: String, why: String, nudge: String,
		tag := "logineq_calc") -> Dictionary:
	return B4._r(q, correct, others, line, why, nudge, tag)


## 正負羅盤
static func _cp(items: Array, line: String, nudge: String) -> Dictionary:
	var its := []
	for it in items:
		its.append({"text": it[0], "a": float(it[1]), "b": float(it[2])})
	return {"kind": "compass", "name": "羅盤", "q": "每個 log 是正還是負？點一下切換 ＋／−。", "items": its, "line": line,
		"nudge": nudge, "tag": "logineq_sign"}


static func _o(q: String, items: Array, line: String, nudge: String) -> Dictionary:
	var its := []
	for it in items:
		its.append({"k": it[0], "text": it[1], "v": float(it[2])})
	return {"kind": "order", "name": "排序", "q": q, "items": its, "line": line, "nudge": nudge, "tag": "logineq_compare"}


static func _l(pts: Array, seg: Array, inc: Array, line: String, nudge: String,
		q := "在數線上標出解：點區間塗色，點分界點切換「● 包含／○ 不含」。") -> Dictionary:
	return {"kind": "line", "name": "數線", "q": q, "pts": pts, "seg": seg, "inc": inc, "line": line, "nudge": nudge,
		"tag": "logineq_line"}


static func _e(name: String, q: String, b: float, xdom: Array, coef: Array, goal: String, targets: Array,
		line: String, nudge: String) -> Dictionary:
	return {"kind": "explore", "name": name, "q": q, "tmap": {"kind": "log", "b": b}, "xdom": xdom, "coef": coef,
		"goal": goal, "targets": targets, "line": line, "nudge": nudge, "tag": "logineq_extreme"}


static func _q(st: Dictionary, q: String, line := "") -> Dictionary:
	st["q"] = q
	if line != "":
		st["line"] = line
	return st


static func _tlog(b: String, line: String) -> Dictionary:
	return _c("換元", "令 t 等於什麼，可以變成 t 的二次式？", ["t = log_{%s} x" % b, "t = %s^{x}" % b, "t = x^{2}", "t = log_{x} %s" % b], 0,
		"同一個 log_{%s} x 出現了好幾次。" % b, "看看哪個式子一直重複出現。", line, "logineq_sub")


