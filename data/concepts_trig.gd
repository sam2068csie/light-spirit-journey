extends RefCounted
## 三角函數單元（G1～G7）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
## 卡片的寫法見 concepts_exp.gd 開頭的說明（?{…} 先藏起來、[b]…[/b] 強調、check 隨堂小測、kind = "order" 拼流程）。
const UITheme := preload("game_theme.gd")


static func cards(level: String) -> Array:
	match level:
		"G1":
			return [
				{"title": "什麼是弧度", "tag": "定義", "glyph": "rad",
				 "formulas": ["弧長 = 半徑 時的圓心角 = ?{1 弧度}", "π 弧度 = ?{180°}"],
				 "notes": ["度 → 弧度：乘 ?{π/180}", "弧度 → 度：乘 ?{180/π}", "1 弧度 ≈ ?{57.3°}（比 60° 小一點）"],
				 "example": "150° = 150 × π/180 = 5π/6；7π/4 = 7 × 45° = 315°",
				 "check": {"q": "120° 是多少弧度？", "opts": ["2π/3", "3π/2", "π/3"], "a": 0,
					"why": "120 × π/180 = 2π/3。", "hint": "120/180 約分。"}},
				{"title": "沒有 π 的角", "tag": "技巧", "glyph": "θ = 20",
				 "formulas": ["沒寫單位的角是 ?{弧度}"],
				 "notes": ["π ≈ 3.14：π/2 ≈ ?{1.57}、3π/2 ≈ ?{4.71}、2π ≈ ?{6.28}", "先扣掉整圈，再和 π/2、π、3π/2 比大小"],
				 "example": "θ = 20：20 − 3 × 6.28 ≈ 1.16 < 1.57 ⇒ 第一象限",
				 "check": {"q": "θ = 4（弧度）的終邊在第幾象限？", "opts": ["第三象限", "第二象限", "第四象限"], "a": 0,
					"why": "π ≈ 3.14 < 4 < 3π/2 ≈ 4.71。", "hint": "4 和 3.14、4.71 比。"}},
				{"title": "比大小", "tag": "技巧", "glyph": "<",
				 "formulas": ["把角換到 ?{同一個單調區間}，再比"],
				 "notes": ["0 ～ π/2：sin ?{遞增}、cos ?{遞減}", "sin(π − x) = ?{sin x}：第二象限換回第一象限", "45° < θ < 90°：cos θ < sin θ < 1 < tan θ"],
				 "example": "sin 3 < sin 1 < sin 2（sin 2 = sin 1.14、sin 3 = sin 0.14）",
				 "check": {"q": "cos 1、cos 2、cos 3 哪個最大？", "opts": ["cos 1", "cos 2", "cos 3"], "a": 0,
					"why": "0 到 π 之間 cos 遞減，角最小的最大。", "hint": "角越大，點越往左。"}},
			]
		"G2":
			return [
				{"title": "扇形的弧長與面積", "tag": "公式", "glyph": "rθ",
				 "formulas": ["弧長 l = ?{rθ}", "面積 A = ?{\\frac{1}{2}r^{2}θ} = ?{\\frac{1}{2}rl}"],
				 "notes": ["θ 一定要用 ?{弧度}", "扇形周長 = ?{2r + rθ}（兩條半徑 + 弧）", "圓心角最大是 ?{2π}（一整圈）"],
				 "example": "r = 6、θ = π/3：l = 2π，A = 6π",
				 "check": {"q": "半徑 4、弧長 6 的扇形，面積是？", "opts": ["12", "24", "48"], "a": 0,
					"why": "A = \\frac{1}{2}rl = \\frac{1}{2} × 4 × 6 = 12。", "hint": "知道弧長時，用 A = \\frac{1}{2}rl 最快。"}},
				{"title": "周長固定，面積最大", "tag": "技巧", "glyph": "max",
				 "formulas": ["周長 L：A = \\frac{1}{2}r(L − 2r)，在 r = ?{L/4} 時最大", "最大面積 = ?{L^{2}/16}，此時 θ = ?{2}"],
				 "notes": ["配方：−r^{2} + (L/2)r = −(r − L/4)^{2} + L^{2}/16"],
				 "check": {"q": "周長 12 的扇形，面積最大時半徑是？", "opts": ["3", "4", "6"], "a": 0,
					"why": "r = L/4 = 3，此時弧長 6、θ = 2。", "hint": "A = \\frac{1}{2}r(12 − 2r)，配方。"}},
				{"title": "弓形面積", "tag": "第二章", "glyph": "◠",
				 "formulas": ["弓形 = 扇形 − 三角形 = ?{\\frac{1}{2}r^{2}θ − \\frac{1}{2}r^{2} sin θ}"],
				 "notes": ["兩圓相交的重疊區域 = 兩個 ?{弓形} 相加"],
				 "example": "r = 6、θ = π/3：6π − 9√{3}",
				 "check": {"q": "半徑 2、圓心角 π/2 的弓形面積是？", "opts": ["π − 2", "2π − 2", "π − 1"], "a": 0,
					"why": "扇形 \\frac{1}{2} × 4 × π/2 = π，三角形 \\frac{1}{2} × 2 × 2 = 2。", "hint": "扇形減掉直角三角形。"}},
				{"title": "扇形 ⇄ 圓錐", "tag": "第二章", "glyph": "△",
				 "formulas": ["扇形的半徑 = 圓錐的 ?{斜高（母線）}", "扇形的弧長 = 底圓的 ?{周長 2πr}"],
				 "notes": ["側面積 = 扇形面積 = ?{πrℓ}", "繞一圈的最短路徑：攤開後兩端點的 ?{弦}"],
				 "trap": "扇形的半徑[b]不是[/b]底圓的半徑！底半徑要用「弧長 = 2πr」算出來。",
				 "plot": {"shape": "cone", "caption": "弧長 = 底圓周長"},
				 "check": {"q": "半徑 10、圓心角 π 的扇形捲成圓錐，底半徑是？", "opts": ["5", "10", "π"], "a": 0,
					"why": "弧長 10π = 2πr ⇒ r = 5。", "hint": "弧長 = 底圓周長。"}},
			]
		"G3":
			return [
				{"title": "三兄弟的圖形", "tag": "圖形", "glyph": "∿",
				 "formulas": ["sin、cos：值域 ?{−1 ≤ y ≤ 1}、週期 ?{2π}", "tan：值域 ?{所有實數}、週期 ?{π}"],
				 "notes": ["tan x 在 x = ?{π/2 + kπ} 沒有定義（漸近線）", "sin 過原點；cos 過 ?{(0, 1)}"],
				 "plot": {"view": {"x": [-0.5, 6.6], "y": [-1.6, 1.6]},
					"curves": [{"f": "sin", "a": 1.0, "c": UITheme.CYAN, "lx": 1.57, "side": "a", "label": "y = sin x"},
