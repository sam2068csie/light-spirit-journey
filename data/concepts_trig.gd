				{"title": "週期公式", "tag": "公式", "glyph": "2π/|b|",
				 "formulas": ["y = a sin(bx) + d、a cos(bx) + d：週期 ?{\\frac{2π}{|b|}}", "y = a tan(bx) + d：週期 ?{\\frac{π}{|b|}}"],
				 "notes": ["a（振幅）和 d（上下平移）?{不影響} 週期", "平移 p 後和原圖重合 ⇔ p 是週期的 ?{整數倍}"],
				 "example": "sin 3x：2π/3；cos(x/2)：4π；tan 2x：π/2",
				 "check": {"q": "y = 5 cos(2x/3) − 1 的週期是？", "opts": ["3π", "4π/3", "2π/3"], "a": 0,
					"why": "2π ÷ 2/3 = 3π。", "hint": "只看 x 前面的係數。"}},
				{"title": "週期組合", "tag": "技巧", "glyph": "| |",
				 "formulas": ["|sin x|、sin^{2} x：週期 ?{減半 → π}", "|sin x + b|（b ≠ 0）：先平移再取絕對值，?{不減半}",
					"|sin x| + |cos x|：特例，週期 ?{π/2}"],
				 "notes": ["兩個函數相加：週期取 ?{最小公倍數}，例如 sin 2x + cos 3x 是 2π"],
				 "plot": {"view": {"x": [-0.3, 6.6], "y": [-0.4, 1.6]},
					"curves": [{"f": "abssin", "a": 1.0, "c": UITheme.CYAN, "lx": 1.57, "side": "a", "label": "y = |sin x|"}]},
				 "check": {"q": "y = |sin x| + |cos x| 的週期是？", "opts": ["π/2", "π", "2π"], "a": 0,
					"why": "平移 π/2：|cos x| + |sin x|，和原式一樣。", "hint": "試著平移 π/2。"}},
				{"title": "對稱與單調", "tag": "第二章", "glyph": "⫶",
				 "formulas": ["sin x：對稱軸 ?{x = π/2 + kπ}、對稱中心 ?{(kπ, 0)}", "cos x：對稱軸 ?{x = kπ}、對稱中心 ?{(π/2 + kπ, 0)}"],
				 "notes": ["對稱軸穿過 ?{波峰、波谷}；對稱中心在 ?{中線} 上", "0 ～ 2π：sin 在 ?{[π/2, 3π/2]} 遞減；cos 在 ?{[0, π]} 遞減",
					"y = a sin(bx) + d：最大 ?{d + |a|}、最小 ?{d − |a|}"],
				 "check": {"q": "y = cos 2x 在 0 < x < π 的對稱軸是？", "opts": ["x = π/2", "x = π/4", "x = π"], "a": 0,
					"why": "2x = kπ ⇒ x = kπ/2，k = 1。", "hint": "波峰波谷在 2x = kπ。"}},
			]
		"G4":
			return [
				{"title": "a 管高低、d 管水位", "tag": "公式", "glyph": "a, d",
				 "formulas": ["y = a sin x + d：振幅 ?{|a|}、中線 ?{y = d}"],
				 "notes": ["最大 ?{d + |a|}、最小 ?{d − |a|}", "a < 0：波 ?{上下顛倒}（先往下走）", "a、d 都 ?{不影響} 週期"],
				 "example": "y = −2 cos x − 1：最大 1、最小 −3",
				 "plot": {"view": {"x": [-0.5, 6.6], "y": [-1.6, 3.6]},
					"curves": [{"f": "sin", "a": 1.0, "c": Color(1, 1, 1, 0.45), "lx": 4.7, "side": "b", "label": "y = sin x"},
						{"f": "sin", "a": 1.0, "m": 2.0, "k": 1.0, "c": UITheme.CYAN, "lx": 1.57, "side": "a", "label": "y = 2 sin x + 1"}]},
				 "check": {"q": "y = 3 − 2 sin x 的最大值、最小值？", "opts": ["5、1", "3、−1", "1、−5"], "a": 0,
					"why": "−2 sin x 在 −2 和 2 之間，加 3：最大 5、最小 1。", "hint": "a 是負的，高度還是看 |a|。"}},
				{"title": "b 管快慢、c 管左右", "tag": "公式", "glyph": "b, c",
				 "formulas": ["週期 ?{\\frac{2π}{|b|}}（tan 是 \\frac{π}{|b|}）", "y = sin(bx + c) = sin b(x + \\frac{c}{b})：向左平移 ?{c/b}"],
				 "notes": ["c/b < 0 就是向 ?{右} 平移", "要先把 ?{x 的係數 b} 提出來"],
				 "trap": "sin(2x − π/3) 只向右平移 [b]π/6[/b]，不是 π/3！",
				 "plot": {"view": {"x": [-0.5, 4.2], "y": [-1.6, 1.6]},
					"curves": [{"f": "sin", "a": 2.0, "c": Color(1, 1, 1, 0.45), "lx": 2.4, "side": "b", "label": "y = sin 2x"},
						{"f": "sin", "a": 2.0, "h": PI / 6.0, "c": UITheme.CYAN, "lx": 0.9, "side": "a", "label": "y = sin(2x − π/3)"}]},
				 "check": {"q": "y = cos(3x + π/2) 是把 y = cos 3x 怎麼平移？", "opts": ["向左 π/6", "向左 π/2", "向右 π/6"], "a": 0,
					"why": "3x + π/2 = 3(x + π/6)：向左平移 π/6。", "hint": "把括號裡的 3 提出來。"}},
				{"kind": "order", "title": "拼出作圖流程", "tag": "思考", "glyph": "→",
				 "prompt": "畫出 y = 2 sin(3x − π/2) + 1",
				 "steps": ["先畫出基本圖形 y = sin x", "鉛直拉伸 2 倍（振幅 2）", "水平壓縮成 1/3（週期 2π/3）",
					"3x − π/2 = 3(x − π/6)：向右平移 π/6", "最後整個往上平移 1"],
				 "pre": [[], [0], [0], [2], [1]],     # 平移量要在水平伸縮之後量；上移要在鉛直拉伸之後
				 "done": "先伸縮、再平移：平移量要在伸縮「之後」才量。"},
				{"title": "看圖求式與應用", "tag": "技巧", "glyph": "M, m",
				 "formulas": ["a = ?{\\frac{M − m}{2}}、d = ?{\\frac{M + m}{2}}", "b = ?{\\frac{2π}{T}}（T 是週期）"],
				 "notes": ["再用一個 ?{波峰}（sin = 1 或 cos = 1）代入求 c", "摩天輪：a 是 ?{半徑}、d 是 ?{中心離地的高度}、T 是 ?{轉一圈的時間}",
					"水深不小於 k：曲線在水平線 y = k 的 ?{上方} 那一段"],
				 "example": "最高 11、最低 5、週期 12：a = 3、d = 8、b = π/6",
				 "check": {"q": "最高 9、最低 1、週期 8：a、b、d 是？", "opts": ["a = 4、b = π/4、d = 5", "a = 8、b = π/4、d = 5", "a = 4、b = π/8、d = 4"], "a": 0,
					"why": "a = (9 − 1) ÷ 2 = 4、d = (9 + 1) ÷ 2 = 5、b = 2π ÷ 8 = π/4。", "hint": "a 是高度差的一半。"}},
				{"title": "作圖求解", "tag": "第二章", "glyph": "∩",
				 "formulas": ["f(x) = g(x) 的實數解個數 = 兩條圖形的 ?{交點個數}", "f(x) < g(x)：f 的圖形在 g 的 ?{下方}"],
				 "notes": ["先看兩邊的 ?{範圍}（例如 x/4 在 −4 ≤ x ≤ 4 時是 −1 ～ 1）", "再抓關鍵點：最高、最低、?{端點}"],
				 "check": {"q": "y = sin x 和 y = 1/2 在 0 ≤ x ≤ 2π 有幾個交點？", "opts": ["2", "1", "4"], "a": 0,
					"why": "高度 1/2 在波峰 1 和中線 0 之間：上坡一個、下坡一個。", "hint": "畫出 sin x 和水平線 y = 1/2。"}},
			]
		"G5":
			return [
				{"title": "sin、cos 的和差角", "tag": "公式", "glyph": "sin, cos",
				 "formulas": ["sin(α ± β) = ?{sin α cos β ± cos α sin β}", "cos(α ± β) = ?{cos α cos β ∓ sin α sin β}"],
				 "notes": ["sin：每一項「sin 配 cos」，符號 ?{照抄}", "cos：每一項「同名相乘」，符號 ?{相反}", "75° = 45° + 30°、15° = 45° − 30°、105° = 60° + 45°"],
