extends RefCounted
## 第三大關「天秤神殿」題庫（對應講義 重點三：指數不等式與極值）
##
## 旅程都是 forge（一步一步完成），除了第二大關的 choice／fill／filter，還多了：
##   order    排序：點選 items，從小排到大（v 是實際的值）
##   line     數線：點區間塗色、點端點切換實心（包含）／空心（不含）。pts 是分界點，
##            seg 是每一段要不要塗（n 個點有 n + 1 段），inc 是每個點包不包含
##   grid     符號表：rows（因式）× cols（區間），ans 是每格的正負（1 或 −1）
##   explore  探索極值：直接拖動 t（tmap：exp 是 b^{x}、sym 是 b^{x} + b^{−x}；t 的範圍由 xdom 算出）在拋物線
##            y = At² + Bt + C（coef）上移動，找到 goal（max／min）後鎖定；targets 是正確的 x
## variant 的 verify.ineq(x) 是不等式本身（測試用：數線的答案要和它一致）。
## 每一步答對後，line 會寫到左邊的「推導紀錄」上。

const B2 := preload("level02_bank.gd")
const T_POS := "t = 2^{x} 一定大於 0。"


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag := "exp_ineq") -> Dictionary:
	return B2._c(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		mode := "ordered", tag := "exp_ineq_calc") -> Dictionary:
	return B2._f(name, q, template, answers, line, nudge, mode, tag)


static func _o(q: String, items: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "order", "name": "排序", "q": q, "items": items, "line": line, "nudge": nudge,
		"tag": "exp_compare"}


static func _it(k: String, text: String, v: float) -> Dictionary:
	return {"k": k, "text": text, "v": v}


static func _l(pts: Array, seg: Array, inc: Array, line: String, nudge: String,
		q := "在數線上標出解：點區間塗色，點分界點切換「● 包含／○ 不含」。") -> Dictionary:
	return {"kind": "line", "name": "數線", "q": q, "pts": pts, "seg": seg, "inc": inc, "line": line,
		"nudge": nudge, "tag": "exp_ineq_line"}


static func _g(rows: Array, cols: Array, ans: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "grid", "name": "符號表", "q": "每個因式在各區間是正還是負？點格子切換 ＋／−。",
		"rows": rows, "cols": cols, "ans": ans, "line": line, "nudge": nudge, "tag": "exp_ineq_sign"}


static func _e(name: String, q: String, tmap: Dictionary, xdom: Array, coef: Array, goal: String,
		targets: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "explore", "name": name, "q": q, "tmap": tmap, "xdom": xdom, "coef": coef,
		"goal": goal, "targets": targets, "line": line, "nudge": nudge, "tag": "exp_extreme"}


static func _tl(d: Dictionary, text: String) -> Dictionary:
	d["tlabel"] = text
	return d


## 二次不等式前面的「自己因式分解」：fac 是分解後的樣子（例如 "(x − 4)(x + 2)"），rel 是不等號
static func _fac(fac: String, rel: String, v := "x", tag := "exp_ineq_calc") -> Dictionary:
	var st := B2._factor_step({"fac_line": fac}, v)
	st["line"] = String(st.options[0]) + " " + rel + " 0"
	st["tag"] = tag
	return st


static func _q(st: Dictionary, q: String) -> Dictionary:
	st["q"] = q
	return st


## 換元之後先確認 t 的範圍（t = a^{x} > 0）
static func _trng(tdef: String) -> Dictionary:
	return _c("t 的範圍", "t = %s 的範圍是？" % tdef, ["t > 0", "t ≥ 0", "全體實數", "t ≥ 1"], 0,
		"%s 永遠是正的，但碰不到 0（y = %s 的圖形以 x 軸為漸近線）。" % [tdef, tdef],
		"想想 y = %s 的圖形：它會碰到 x 軸嗎？" % tdef, "t = %s > 0" % tdef, "exp_extreme")


static func _t2(line: String) -> Dictionary:
	return _c("換元", "令 t 等於什麼，可以把它變成 t 的二次式？", ["t = 2^{x}", "t = 4^{x}", "t = 2x", "t = x^{2}"], 0,
		"4^{x} = (2^{x})^{2} = t^{2}。", "4^{x} 是 2^{x} 的平方。", line, "exp_eq_sub")


static func _t3(line: String) -> Dictionary:
	return _c("換元", "令 t 等於什麼，可以把它變成 t 的二次式？", ["t = 3^{x}", "t = 9^{x}", "t = 3x", "t = x^{2}"], 0,
		"9^{x} = (3^{x})^{2} = t^{2}。", "9^{x} 是 3^{x} 的平方。", line, "exp_eq_sub")


