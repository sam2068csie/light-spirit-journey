## log_{b} 1 … log_{b} n 裡的正整數個數 + 總和
static func _count_log(b: int, n: int) -> float:
	var cnt := 0
	var s := 0
	var k := 1
	var v := b
	while v <= n:
		cnt += 1
		s += k
		k += 1
		v *= b
	return float(cnt + s)


# ================= 鍊金速算的題目 =================

## 同一個質數的次方：[顯示, 指數分子, 指數分母]
const FAMILY := {
	2: {"bases": [["2", 1, 1], ["4", 2, 1], ["8", 3, 1], ["16", 4, 1], ["1/2", -1, 1], ["1/4", -2, 1], ["√{2}", 1, 2]],
		"args": [["1", 0, 1], ["2", 1, 1], ["4", 2, 1], ["8", 3, 1], ["16", 4, 1], ["32", 5, 1], ["64", 6, 1],
			["1/2", -1, 1], ["1/4", -2, 1], ["1/8", -3, 1], ["√{2}", 1, 2], ["2√{2}", 3, 2]]},
	3: {"bases": [["3", 1, 1], ["9", 2, 1], ["27", 3, 1], ["1/3", -1, 1], ["1/9", -2, 1], ["√{3}", 1, 2]],
		"args": [["1", 0, 1], ["3", 1, 1], ["9", 2, 1], ["27", 3, 1], ["81", 4, 1], ["1/3", -1, 1], ["1/9", -2, 1],
			["1/27", -3, 1], ["√{3}", 1, 2], ["3√{3}", 3, 2]]},
	5: {"bases": [["5", 1, 1], ["25", 2, 1], ["1/5", -1, 1], ["√{5}", 1, 2]],
		"args": [["1", 0, 1], ["5", 1, 1], ["25", 2, 1], ["125", 3, 1], ["1/5", -1, 1], ["1/25", -2, 1], ["√{5}", 1, 2]]},
}


static func _gcd(a: int, b: int) -> int:
	while b != 0:
		var t := a % b
		a = b
		b = t
	return maxi(a, 1)


static func _qtext(num: int, den: int) -> String:
	if den < 0:
		num = -num
		den = -den
	var g := _gcd(absi(num), den)
	num /= g
	den /= g
	var t := str(absi(num)) if den == 1 else "%d/%d" % [absi(num), den]
	return ("−" if num < 0 else "") + t


static func _ex(n: int, d: int) -> String:
	return _qtext(n, d) if d != 1 else str(n).replace("-", "−")


## 一題「求 log 值」：{eq, ans, nudge, value}
static func _gen_val() -> Dictionary:
	var p: int = [2, 2, 3, 3, 5].pick_random()
	var fam: Dictionary = FAMILY[p]
	var b: Array = fam.bases.pick_random()
	var a: Array = fam.args.pick_random()
	if b[0] == a[0]:
		return {}
	# (a_n/a_d) ÷ (b_n/b_d)
	var num: int = int(a[1]) * int(b[2])
	var den: int = int(a[2]) * int(b[1])
	if den < 0:
		num = -num
		den = -den
	var g := _gcd(absi(num), den)
	num /= g
	den /= g
	if den > 4 or absi(num) > 6 * den:
		return {}
	var arg: String = a[0]
	var eq := "log_{%s} %s" % [b[0], "(%s)" % arg if arg.contains("/") else arg]
	var nudge := "%s = %d^{%s}、%s = %d^{%s}，指數相除：%s ÷ %s。" % [b[0], p, _ex(b[1], b[2]), a[0], p, _ex(a[1], a[2]),
		_ex(a[1], a[2]), _ex(b[1], b[2])]
	var bv := pow(float(p), float(b[1]) / float(b[2]))
	var av := pow(float(p), float(a[1]) / float(a[2]))
	return {"eq": eq, "ans": _qtext(num, den), "nudge": nudge, "value": lb(bv, av), "kind": "val"}


## 一題「相加／相減合併」：{eq, ans, nudge, value}
static func _gen_law() -> Dictionary:
	var b: int = [2, 3, 6, 10, 12].pick_random()
	var bt := "log " if b == 10 else "log_{%d} " % b
	if randi() % 2 == 0:
		# log_b m + log_b n = k
		var k := randi_range(1, 3 if b <= 6 else 2)
		var total := int(pow(b, k))
		var divs := []
		for d in range(2, total):
			if total % d == 0 and d * d <= total and not _is_pow(d, b) and not _is_pow(total / d, b):
				divs.append(d)
		if divs.is_empty():
			return {}
		var m: int = divs.pick_random()
		var n: int = total / m
		if randi() % 2 == 0:
			var tmp := m
			m = n
			n = tmp
		return {"eq": "%s%d + %s%d" % [bt, m, bt, n], "ans": str(k),
			"nudge": "相加 ⇒ 真數相乘：%d × %d = %d = %d^{%d}。" % [m, n, total, b, k],
			"value": lb(b, m) + lb(b, n), "kind": "law"}
	# log_b M − log_b N = ±k
	var k2 := randi_range(1, 2)
	var nn: int = [2, 3, 5, 7].pick_random()
	if _is_pow(nn, b) or nn == b:
		return {}
	var mm: int = nn * int(pow(b, k2))
	if mm > 1500:
		return {}
	if randi() % 3 == 0:
		return {"eq": "%s%d − %s%d" % [bt, nn, bt, mm], "ans": "−%d" % k2,
			"nudge": "相減 ⇒ 真數相除：%d ÷ %d = 1/%d = %d^{−%d}。" % [nn, mm, int(pow(b, k2)), b, k2],
			"value": lb(b, nn) - lb(b, mm), "kind": "law"}
	return {"eq": "%s%d − %s%d" % [bt, mm, bt, nn], "ans": str(k2),
		"nudge": "相減 ⇒ 真數相除：%d ÷ %d = %d = %d^{%d}。" % [mm, nn, int(pow(b, k2)), b, k2],
		"value": lb(b, mm) - lb(b, nn), "kind": "law"}


static func _is_pow(x: int, b: int) -> bool:
	var v := 1
	while v < x:
		v *= b
	return v == x


## 產生 n 道不重複的速算題：前面是求值，後面是合併
static func gen_problems(_kind: String, n: int) -> Array:
	var out := []
	var seen := {}
	var guard := 0
	var n_val := int(ceil(n * 0.6))
	while out.size() < n and guard < 5000:
		guard += 1
		var pb := _gen_val() if out.size() < n_val else _gen_law()
		if pb.is_empty() or seen.has(pb.eq):
			continue
		seen[pb.eq] = true
		out.append(pb)
	return out
