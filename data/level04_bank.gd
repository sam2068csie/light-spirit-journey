extends RefCounted
## 第四大關「對數鍊金術」題庫（對應講義 重點一：對數基本性質）
##
## 旅程都是 forge（一步一步鍊成），沿用第二、三大關的 choice／fill／line，再加上兩種新步驟：
##   rule   施放法則：從「對數律秘笈」裡選出這一步要用的法則（rules 是卡片，correct 是正確的那張）。
##          選對了，法則會在鍊金陣裡施放，式子跟著變形。
##   chain  連鎖之環：依序點選 items（log_{a} b），讓每一環的真數 b 接上下一環的底數 a，
##          接完就只剩頭和尾：log_{a} b · log_{b} c = log_{a} c。closed 代表最後會繞回起點（= 1）。
## 另外有一個 speed 旅程（鍊金速算），題目由 gen_problems 產生。
##
## check：測試用，[實際算出的值, 答案的值, 容許誤差（可省略）]，兩者要相等。

const B2 := preload("level02_bank.gd")

## 對數律秘笈：施放法則時的卡片
const RULES := {
	"add":   {"name": "相加", "f": "log_{a} M + log_{a} N = log_{a} MN"},
	"sub":   {"name": "相減", "f": "log_{a} M − log_{a} N = log_{a} (M/N)"},
	"pow":   {"name": "係數", "f": "r·log_{a} M = log_{a} M^{r}"},
	"base":  {"name": "換底", "f": "log_{a} b = log_{c} b / log_{c} a"},
	"recip": {"name": "倒數", "f": "log_{a} b · log_{b} a = 1"},
	"mpow":  {"name": "次方", "f": "log_{a^{m}} b^{n} = (n/m)·log_{a} b"},
	"chain": {"name": "連鎖", "f": "log_{a} b · log_{b} c = log_{a} c"},
	"swap":  {"name": "互換", "f": "a^{log_{c} b} = b^{log_{c} a}"},
	"def":   {"name": "定義", "f": "a^{log_{a} N} = N"},
}

const VALID_Q := "log_{a} N 有意義的條件是？"
const VALID_OPTS := ["a > 0、a ≠ 1、N > 0", "a > 0、N > 0", "a ≠ 1、N ≥ 0", "a > 1、N > 0"]


static func lb(b: float, x: float) -> float:
	return log(x) / log(b)


static func lg(x: float) -> float:
	return log(x) / log(10.0)


static func _c(name: String, q: String, options: Array, correct: int, why: String, nudge: String,
		line: String, tag := "loglaw_law") -> Dictionary:
	return B2._c(name, q, options, correct, why, nudge, line, tag)


static func _f(name: String, q: String, template: String, answers: Array, line: String, nudge: String,
		tag := "loglaw_law", mode := "ordered") -> Dictionary:
	return B2._f(name, q, template, answers, line, nudge, mode, tag)


## 施放法則：correct 是對的法則，others 是其他卡片
static func _r(q: String, correct: String, others: Array, line: String, why: String, nudge: String,
		tag := "loglaw_law") -> Dictionary:
	var ids: Array = [correct]
	ids.append_array(others)
	return {"kind": "rule", "name": "施放法則", "q": q, "rules": ids, "correct": correct, "line": line,
		"why": why, "nudge": nudge, "tag": tag}


## 連鎖之環：links 寫成 "2>3"（代表 log_{2} 3）
static func _ch(links: Array, closed: bool, line: String, nudge: String) -> Dictionary:
	var items := []
	for s in links:
		var p: PackedStringArray = str(s).split(">")
		items.append({"a": p[0], "b": p[1], "text": "log_{%s} %s" % [p[0], p[1]]})
	return {"kind": "chain", "name": "連鎖", "q": "依序點選鍊環：每一環的真數，要接上下一環的底數。",
		"items": items, "closed": closed, "line": line, "nudge": nudge, "tag": "loglaw_chain"}


static func _line(pts: Array, seg: Array, inc: Array, line: String, nudge: String) -> Dictionary:
	return {"kind": "line", "name": "數線", "q": "三個條件取交集：點區間塗色，點分界點切換「● 包含／○ 不含」。",
		"pts": pts, "seg": seg, "inc": inc, "line": line, "nudge": nudge, "tag": "loglaw_valid"}


