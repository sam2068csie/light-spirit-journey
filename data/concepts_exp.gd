extends RefCounted
## 指數與對數單元（L1～L8）的「觀念整理」卡片內容（介面在 concept_deck.gd，入口在 concept_cards.gd）
##
## 一般卡片（一行一行揭開）：
##   title     標題        tag   小標籤（定義、公式、技巧…）
##   formulas  重要公式（大字、各自一個框）
##   notes     重點（一行一個）
##   example   例子（可省略）  trap  常見陷阱（可省略）
##   plot      右邊的小圖（可省略）。最簡單是曲線陣列：[{"f": "exp"／"log"／"absexp"／"poly"／"line", "a": 底數, "c": 顏色,
##             "lx": 標籤貼在曲線上 x = 多少的位置, "side": 標籤在那一點的 "r" 右／"l" 左／"a" 上／"b" 下, "label": 自訂標籤}, …]
##             也可以寫成字典，加上座標範圍、交點、範圍色帶、平移動畫、輪播的畫面（鏡射、翻折）…
##             完整寫法見 concept_deck.gd 的 ConceptPlot。check（隨堂小測）裡也可以放 plot，讓學生看圖作答。
##   glyph     卡片右上角淡淡的大字裝飾
##   check     隨堂小測：{"q": 題目, "opts": [選項…], "a": 正解的編號, "why": 解說, "hint": 答錯時的提示（可省略）}
##   在任何一行裡寫 ?{…}，那一段會先藏起來，變成「？」讓學生先想、再點開
##   [b]…[/b] 是強調色
##
## 解題流程卡片（拼積木）：
##   {"kind": "order", "title", "tag", "glyph", "prompt": 題目, "steps": [依正確順序的步驟…], "done": 完成後的一句話}

const C1 := Color("5ad8ff")
const C2 := Color("ffb454")
const C3 := Color("a6f05a")
const C4 := Color("c792ff")
const C5 := Color("ff7eb6")
const C6 := Color("ffcf5a")
const C7 := Color("6ee7a0")
const C8 := Color("8fb4ff")


static func cards(level: String) -> Array:
	match level:
		"L1":
			return [
				{"title": "y = a^{x} 長什麼樣子", "tag": "圖形", "glyph": "a^{x}",
				 "formulas": ["y = a^{x}（a > 0，a ≠ 1）"],
				 "notes": ["a > 1：?{遞增，往右越爬越快}", "0 < a < 1：?{遞減，往右越來越貼近 x 軸}",
					"不管 a 是多少，一定過點 ?{(0, 1)}", "永遠在 x 軸上方，漸近線是 ?{y = 0}"],
				 "plot": [{"f": "exp", "a": 2.0, "c": C1, "lx": 1.3, "side": "r"}, {"f": "exp", "a": 0.5, "c": C5, "lx": -1.3, "side": "l"}],
				 "check": {"q": "y = (0.7)^{x} 的圖形是？", "opts": ["遞減，過 (0, 1)", "遞增，過 (0, 1)", "遞減，過 (1, 0)"], "a": 0,
					"why": "底數 0.7 < 1 ⇒ 遞減；0.7^{0} = 1 ⇒ 過 (0, 1)。", "hint": "先看底數和 1 比，再想 x = 0 時 y 是多少。"}},
				{"title": "底數越大越陡", "tag": "比較", "glyph": "3^{x}",
				 "formulas": ["x > 0 時：底數越大，圖形 ?{越高}", "y = a^{x} 與 y = (1/a)^{x} 對稱於 ?{y 軸}"],
				 "notes": ["x < 0 時剛好相反：底數越大，圖形 ?{越低}"],
				 "example": "x = 1 時 3^{x} > 2^{x}（3 > 2）；x = −1 時 3^{x} < 2^{x}（1/3 < 1/2）",
				 "plot": [{"f": "exp", "a": 3.0, "c": C1, "lx": 1.0, "side": "a"}, {"f": "exp", "a": 2.0, "c": C6, "lx": 1.3, "side": "r"},
					{"f": "exp", "a": 1.0 / 3.0, "c": C5, "lx": 2.2, "side": "a"}],
				 "check": {"q": "x = −2 時，2^{x}、3^{x}、5^{x} 誰最大？", "opts": ["2^{x}", "3^{x}", "5^{x}"], "a": 0,
					"why": "x < 0 時底數越大反而越低：2^{−2} = 1/4 最大。", "hint": "x 是負的喔！算算看 2^{−2} 和 5^{−2}。"}},
				{"title": "平移", "tag": "變換", "glyph": "h, k",
				 "formulas": ["y = a^{x − h} + k：往右 ?{h}、往上 ?{k}"],
				 "notes": ["漸近線變成 ?{y = k}", "恆過點 (0, 1) 移到 ?{(h, 1 + k)}", "係數也能變平移：4·2^{x} = 2^{x + 2}，是往 ?{左移 2}"],
				 "trap": "y = 2^{x + 3} 是往[b]左[/b]移 3，不是往右！",
				 "plot": {"view": {"x": [-3.0, 4.5], "y": [-1.0, 5.0]},
					"shift": {"f": "exp", "a": 2.0, "h": 2.0, "k": 1.0, "c": C1, "label": "y = 2^{x − 2} + 1", "base_label": "y = 2^{x}"}},
				 "check": {"q": "y = 2^{x − 1} + 3 的漸近線與恆過點？", "opts": ["y = 3，(1, 4)", "y = 3，(0, 4)", "y = −1，(1, 3)"], "a": 0,
					"why": "往右 1、往上 3：漸近線 y = 3，(0, 1) 移到 (1, 4)。"}},
				{"title": "絕對值：對稱與翻折", "tag": "第二章", "glyph": "|  |",
				 "formulas": ["y = a^{|x|}：對 ?{y 軸} 左右對稱", "y = |a^{x} − k|：x 軸下方 ?{翻上來}"],
				 "notes": ["a^{|x|}：先畫 x ≥ 0 那半邊，再 ?{對 y 軸鏡射}", "外面整個加絕對值：y < 0 的部分 ?{往上翻}"],
				 "plot": {"scenes": [
					{"view": {"x": [-3.0, 3.0], "y": [-0.8, 5.0]}, "caption": "右半邊對 y 軸鏡射",
					 "curves": [{"f": "exp", "a": 2.0, "c": C1, "mirror": true, "lx": 0.0, "side": "a", "label": "y = 2^{|x|}"}]},
					{"view": {"x": [-3.0, 3.0], "y": [-2.4, 3.6]}, "caption": "x 軸下方翻上來",
					 "curves": [{"f": "exp", "a": 2.0, "k": -2.0, "c": C5, "fold": true, "lx": -1.6, "side": "a", "label": "y = |2^{x} − 2|"}]}]},
				 "check": {"q": "y = 2^{|x|} 的最小值是？", "opts": ["1", "0", "2"], "a": 0,
					"why": "|x| ≥ 0 ⇒ 2^{|x|} ≥ 2^{0} = 1，在 x = 0 時最小。", "hint": "|x| 最小是多少？"}},
				{"title": "解的個數 = 交點個數", "tag": "技巧", "glyph": "∩",
				 "formulas": ["f(x) = g(x) 的解 ⇔ 兩個圖形的 ?{交點}"],
				 "notes": ["畫不準的地方，就 ?{列表比大小}", "一個遞增、一個遞減：最多只有 ?{一個} 交點"],
				 "example": "2^{x} = x^{2} 有 3 個解：x = 2、x = 4，還有一個負的",
				 "plot": {"view": {"x": [-2.5, 5.0], "y": [-1.5, 18.0]}, "caption": "三個交點 ⇒ 3 個解",
					"curves": [{"f": "exp", "a": 2.0, "c": C1, "lx": 3.2, "side": "r", "label": "y = 2^{x}"},
						{"f": "poly", "p": [1.0, 0.0, 0.0], "c": C2, "lx": -1.6, "side": "r", "label": "y = x^{2}"}],
					"pts": [{"x": -0.7667, "y": 0.5878}, {"x": 2.0, "y": 4.0}, {"x": 4.0, "y": 16.0}]},
				 "check": {"q": "看右邊的圖：2^{x} = −x + 1 有幾個解？", "opts": ["1 個", "0 個", "2 個"], "a": 0,
					"plot": {"view": {"x": [-3.0, 3.0], "y": [-2.0, 4.0]},
						"curves": [{"f": "exp", "a": 2.0, "c": C1, "lx": 1.3, "side": "l"},
							{"f": "line", "p": [0.0, -1.0, 1.0], "c": C2, "lx": 2.0, "side": "a", "label": "y = −x + 1"}]},
					"why": "2^{x} 遞增、−x + 1 遞減，最多一個交點；x = 0 時兩邊都是 1。", "hint": "兩邊各是遞增還是遞減？"}},
				{"kind": "order", "title": "拼出解題流程", "tag": "思考", "glyph": "→",
				 "prompt": "畫出 y = 2^{x − 1} + 3，並找出漸近線",
				 "steps": ["先畫出基本圖形 y = 2^{x}", "x 換成 x − 1：往右移 1", "後面 + 3：整個往上移 3", "漸近線 y = 0 也跟著上移 ⇒ y = 3"],
				 "pre": [[], [0], [0], [2]],     # 右移、上移誰先都可以；漸近線要等上移之後
				 "done": "先畫基本圖形，再一步一步平移，漸近線、恆過點跟著走。"},
			]
		"L2":
			return [
				{"title": "指數律", "tag": "公式", "glyph": "a^{m}",
				 "formulas": ["a^{m}·a^{n} = ?{a^{m + n}}", "(a^{m})^{n} = ?{a^{mn}}", "a^{−n} = ?{1/a^{n}}", "√{a} = ?{a^{1/2}}"],
				 "notes": ["[b]底數一樣[/b]才能合併指數"],
				 "check": {"q": "8^{2/3} = ？", "opts": ["4", "16/3", "2"], "a": 0,
					"why": "8 = 2^{3}，(2^{3})^{2/3} = 2^{2} = 4。", "hint": "先把 8 寫成 2 的次方。"}},
				{"title": "化同底", "tag": "技巧", "glyph": "=",
				 "formulas": ["a^{f(x)} = a^{g(x)} ⇒ ?{f(x) = g(x)}"],
				 "notes": ["先找共同底數：4 = 2^{2}、1/8 = ?{2^{−3}}、√{2} = ?{2^{1/2}}", "兩邊都寫成它的次方，再讓 ?{指數相等}"],
				 "example": "4^{x + 1} = 8 ⇒ 2^{2x + 2} = 2^{3} ⇒ 2x + 2 = 3 ⇒ x = 1/2",
				 "check": {"q": "9^{x} = 1/27，x = ？", "opts": ["−3/2", "−2/3", "3/2"], "a": 0,
					"why": "3^{2x} = 3^{−3} ⇒ 2x = −3 ⇒ x = −3/2。", "hint": "9 和 1/27 都是 3 的次方。"}},
				{"title": "換元：令 t = a^{x}", "tag": "技巧", "glyph": "t",
				 "formulas": ["令 t = a^{x}：a^{2x} = ?{t^{2}}", "a^{x + k} = ?{a^{k}·t}"],
				 "notes": ["同時看到 a^{2x} 和 a^{x}：變成 t 的 ?{二次方程式}", "解出 t 之後，記得 ?{換回 x}"],
				 "trap": "t = a^{x} 一定 [b]> 0[/b]：解出負的 t 要丟掉！",
				 "plot": {"view": {"x": [-3.0, 3.0], "y": [-2.0, 4.0]}, "hband": [0.0, 9.0], "caption": "t 永遠在 x 軸上方",
					"curves": [{"f": "exp", "a": 2.0, "c": C1, "lx": 1.2, "side": "l", "label": "t = 2^{x}"}],
					"hlines": [{"y": -1.0, "c": Color(1, 0.42, 0.48), "label": "t = −1 不可能"}]},
				 "check": {"q": "令 t = 2^{x}，得到 (t − 4)(t + 2) = 0，接下來？", "opts": ["t = 4 ⇒ x = 2（t = −2 不合）", "x = 4 或 x = −2", "t = 4、t = −2 都要"], "a": 0,
					"why": "t = 2^{x} > 0，所以 t = −2 丟掉；2^{x} = 4 ⇒ x = 2。", "hint": "t = 2^{x} 可以是負的嗎？"}},
				{"title": "整塊換元：a^{x} + a^{−x}", "tag": "第二章", "glyph": "★",
				 "formulas": ["令 t = a^{x} + a^{−x}，則 t ≥ ?{2}", "a^{2x} + a^{−2x} = ?{t^{2} − 2}"],
				 "notes": ["為什麼 t ≥ 2？?{算幾不等式}：a^{x} + a^{−x} ≥ 2√{a^{x}·a^{−x}} = 2√{1} = 2",
					"為什麼是 t^{2} − 2？把 t 平方：t^{2} = a^{2x} + ?{2} + a^{−2x}（中間項 2·a^{x}·a^{−x} = 2）",
					"同一題裡 a^{x} + a^{−x} 和 a^{2x} + a^{−2x} 一起出現：整塊換成 t，就變成 ?{t 的二次式}"],
				 "trap": "t = a^{x} + a^{−x} 的範圍是 [b]t ≥ 2[/b]，不是 t > 0！",
				 "check": {"q": "2^{x} + 2^{−x} = 3，則 4^{x} + 4^{−x} = ？", "opts": ["7", "9", "11"], "a": 0,
					"why": "4^{x} + 4^{−x} = t^{2} − 2 = 9 − 2 = 7。", "hint": "把 2^{x} + 2^{−x} 平方看看。"}},
				{"title": "兩根之和：根與係數", "tag": "第二章", "glyph": "α+β",
				 "formulas": ["t^{2} + bt + c = 0 的兩根：t_{1} + t_{2} = ?{−b}、t_{1}t_{2} = ?{c}",
					"t_{1} = a^{α}、t_{2} = a^{β} ⇒ t_{1}t_{2} = ?{a^{α + β}}"],
				 "notes": ["只問 α + β、二次式又 ?{不好因式分解} 時使用",
					"a^{α} + a^{β}：就是 ?{兩根之和}，不必解出 α、β"],
				 "example": "9^{x} − 7·3^{x} + 3 = 0：t_{1}t_{2} = 3 ⇒ 3^{α + β} = 3 ⇒ α + β = 1",
				 "trap": "先確認兩個 t 都 > 0，x 才真的有兩個解",
				 "check": {"q": "4^{x} − 6·2^{x} + 2 = 0 的兩根為 α、β，α + β = ？", "opts": ["1", "6", "2"], "a": 0,
					"why": "令 t = 2^{x}：t_{1}t_{2} = 2 ⇒ 2^{α}·2^{β} = 2^{α + β} = 2 ⇒ α + β = 1。", "hint": "2^{α}·2^{β} = 2^{α + β}，而 2^{α}·2^{β} 是兩根之積。"}},
				{"title": "互為倒數的底數", "tag": "第二章", "glyph": "1/t",
				 "formulas": ["(2 + √{3})(2 − √{3}) = ?{1}"],
				 "notes": ["兩個底數相乘等於 1：(2 − √{3})^{x} = ?{1/(2 + √{3})^{x}}",
					"所以令 t = (2 + √{3})^{x}，另一個就是 ?{1/t}，兩邊乘 t 變成二次方程式"],
				 "example": "(2 + √{3})^{x} + (2 − √{3})^{x} = 4 ⇒ t + 1/t = 4 ⇒ t^{2} − 4t + 1 = 0",
				 "check": {"q": "(√{2} + 1)(√{2} − 1) = ？", "opts": ["1", "2", "√{2}"], "a": 0,
					"why": "平方差：(√{2})^{2} − 1^{2} = 2 − 1 = 1，所以兩個底數互為倒數。", "hint": "平方差公式 (a + b)(a − b) = a^{2} − b^{2}。"}},
				{"kind": "order", "title": "拼出解題流程", "tag": "思考", "glyph": "→",
				 "prompt": "解 4^{x} − 3·2^{x} − 4 = 0",
				 "steps": ["看到 4^{x} 和 2^{x}：令 t = 2^{x}（t > 0）", "改寫成 t^{2} − 3t − 4 = 0", "因式分解：(t − 4)(t + 1) = 0",
					"t > 0，所以 t = 4（t = −1 不合）", "換回 x：2^{x} = 4 ⇒ x = 2"],
				 "done": "令 t → 解二次方程式 → 檢查 t > 0 → 換回 x。"},
			]
		"L3":
			return [
				{"title": "比大小", "tag": "技巧", "glyph": "<",
				 "formulas": ["化同底：比 ?{指數}", "同次方：比 ?{底數}"],
				 "notes": ["底數 > 1：指數越大，值 ?{越大}", "0 < 底數 < 1：指數越大，值 ?{越小}",
					"都不一樣：同時取 ?{最小公倍數} 次方，例如 √{3} 和 ∛{5} 取 6 次方"],
				 "example": "3^{1/2} 和 5^{1/3}：6 次方是 27 和 25 ⇒ 3^{1/2} > 5^{1/3}",
				 "check": {"q": "(1/2)^{0.3} 和 (1/2)^{0.5} 誰大？", "opts": ["(1/2)^{0.3}", "(1/2)^{0.5}", "一樣大"], "a": 0,
					"why": "底數 1/2 < 1：指數越小反而越大。", "hint": "底數比 1 大還是小？"}},
				{"title": "指數不等式：看底數", "tag": "公式", "glyph": "⇄",
				 "formulas": ["a > 1：a^{f} > a^{g} ⇔ ?{f > g}", "0 < a < 1：a^{f} > a^{g} ⇔ ?{f < g}"],
				 "notes": ["底數 < 1 是遞減，所以 ?{不等號變向}"],
				 "example": "(1/2)^{x} > 4 ⇒ 2^{−x} > 2^{2} ⇒ −x > 2 ⇒ x < −2（寫成同一個底再判斷最安全）",
				 "plot": {"view": {"x": [-4.0, 3.0], "y": [-1.0, 7.0]}, "band": [-9.0, -2.0], "caption": "曲線在 y = 4 上方 ⇔ x < −2",
					"curves": [{"f": "exp", "a": 0.5, "c": C5, "lx": -0.8, "side": "r", "label": "y = (1/2)^{x}"}],
					"hlines": [{"y": 4.0, "c": C6, "label": "y = 4"}], "pts": [{"x": -2.0, "y": 4.0}]},
				 "check": {"q": "(1/3)^{x} < 9 的解？", "opts": ["x > −2", "x < −2", "x > 2"], "a": 0,
					"why": "3^{−x} < 3^{2} ⇒ −x < 2 ⇒ x > −2。", "hint": "先把兩邊都寫成 3 的次方。"}},
				{"title": "換元 + 數線", "tag": "技巧", "glyph": "t",
				 "formulas": ["令 t = a^{x}，別忘了 ?{t > 0}"],
				 "notes": ["解 t 的不等式，再和 ?{t > 0} 取交集", "換回 x 時，依 ?{底數} 決定方向",
					"數線上：≥、≤ 用 ?{實心點}，>、< 用 ?{空心點}"],
				 "check": {"q": "解出 −1 < t < 4，其中 t = 2^{x}，x 的範圍？", "opts": ["x < 2", "−1 < x < 2", "x < 4"], "a": 0,
					"why": "和 t > 0 合併得 0 < t < 4 ⇒ 2^{x} < 2^{2} ⇒ x < 2。", "hint": "t = 2^{x} 本來就 > 0。"}},
				{"title": "極值", "tag": "第二章", "glyph": "▲",
				 "formulas": ["a + b ≥ ?{2√{ab}}（a、b > 0）"],
				 "notes": ["令 t = a^{x}：先由 x 的範圍算出 ?{t 的範圍}", "配方找頂點：頂點 ?{在範圍內} 才算，否則看端點"],
				 "plot": {"view": {"x": [-2.5, 2.5], "y": [-0.6, 4.0]}, "band": [-1.0, 1.0], "hband": [0.5, 2.0],
					"caption": "−1 ≤ x ≤ 1 ⇒ 1/2 ≤ t ≤ 2",
					"curves": [{"f": "exp", "a": 2.0, "c": C1, "lx": 1.6, "side": "l", "label": "t = 2^{x}"}],
					"pts": [{"x": -1.0, "y": 0.5}, {"x": 1.0, "y": 2.0}]},
				 "check": {"q": "t = 2^{x}，0 ≤ x ≤ 2，t 的範圍？", "opts": ["1 ≤ t ≤ 4", "0 ≤ t ≤ 4", "0 ≤ t ≤ 2"], "a": 0,
					"why": "2^{x} 遞增：2^{0} = 1，2^{2} = 4。", "hint": "x = 0 時 t 是多少？"}},
				{"kind": "order", "title": "拼出解題流程", "tag": "思考", "glyph": "→",
				 "prompt": "解 (1/2)^{x − 1} > 8",
				 "steps": ["化同底：(1/2)^{x − 1} = 2^{−(x − 1)}，8 = 2^{3}", "底數 2 > 1：方向不變，直接比指數", "−(x − 1) > 3", "x < −2"],
				 "done": "化同底 → 看底數決定方向 → 解一次不等式。"},
			]
		"L4":
			return [
				{"title": "對數的定義", "tag": "定義", "glyph": "log",
				 "formulas": ["a^{x} = N ⇔ x = ?{log_{a} N}"],
				 "notes": ["log_{a} N 就是「?{a 的幾次方等於 N}」", "有意義的條件：?{a > 0、a ≠ 1、N > 0}",
					"log_{a} 1 = ?{0}、log_{a} a = ?{1}、a^{log_{a} N} = ?{N}"],
				 "example": "log_{4} 8 = 3/2，因為 4^{3/2} = 8",
				 "check": {"q": "log_{9} 27 = ？", "opts": ["3/2", "3", "2/3"], "a": 0,
					"why": "9^{3/2} = (√{9})^{3} = 27。", "hint": "9 的幾次方是 27？兩個都是 3 的次方。"}},
				{"title": "三大基本律", "tag": "公式", "glyph": "+ − ×",
				 "formulas": ["log_{a} M + log_{a} N = ?{log_{a} MN}", "log_{a} M − log_{a} N = ?{log_{a} (M/N)}", "r·log_{a} M = ?{log_{a} M^{r}}"],
