# Godot 4：編輯器自動產生的快取（每台電腦會自己重建，不用上傳）
.godot/

# Android 建置範本（在 Godot 裡「安裝 Android 建置範本」就會重新產生）
/android/

# 匯出的安裝檔
*.apk
*.aab
/export/
/build/

# iOS 匯出的 Xcode 專案（很大，而且每次匯出都會重新產生）
/ios export/
/ios/
*.ipa
*.xcframework/
*.pck
*.mobileprovision
/lightspiritjourney/
/lightspiritjourney.xcodeproj/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcprivacy

# 簽章金鑰：絕對不要上傳！
*.keystore
*.jks

# 匯出設定（每台電腦自己的匯出路徑、簽章、憑證設定，不同步）
export_presets.cfg

# 系統檔
.DS_Store
Thumbs.db
desktop.ini
